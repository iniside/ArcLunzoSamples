<rml>
<head>
	<title>Tailwind</title>
	<meta name="layer" content="UI.Layer.Menu"/>
	<meta name="input-mode" content="menu"/>
	<link type="text/rcss" href="/ArcRmlUISamples/UI/Rml/Shared/Samples.rcss"/>
	<link type="text/rcss" href="Tailwind.rcss"/>
</head>
<body>
	<div class="absolute top-20 left-20 w-[720px] rounded-xl bg-slate-800 p-8 shadow-lg">
		<h1 class="text-3xl font-bold text-sky-400">Tailwind in RML</h1>
		<p class="mt-2 text-slate-300">Every style on this screen comes from Tailwind utility classes.</p>
		<div class="mt-6 flex gap-4">
			<button class="rounded-md bg-sky-600 px-4 py-2 text-white hover:bg-sky-500 focus:bg-sky-500 focus:ring-2 focus:ring-sky-300" autofocus="">Play</button>
			<button class="rounded-md bg-slate-600 px-4 py-2 text-white hover:bg-slate-500 focus:bg-slate-500 focus:ring-2 focus:ring-slate-300">Options</button>
			<button class="rounded-md bg-rose-600 px-4 py-2 text-white hover:bg-rose-500 focus:bg-rose-500 focus:ring-2 focus:ring-rose-300">Quit</button>
		</div>
		<ul class="mt-6 divide-y divide-slate-600 rounded-md bg-slate-900">
			<li class="flex justify-between px-4 py-2"><span>Level</span><span class="text-amber-400">12</span></li>
			<li class="flex justify-between px-4 py-2"><span>Gold</span><span class="text-amber-400">340</span></li>
			<li class="flex justify-between px-4 py-2"><span>Quests</span><span class="text-amber-400">3 of 8</span></li>
		</ul>
		<div class="mt-6 grid grid-cols-3 gap-4">
			<div class="rounded-md bg-emerald-600 p-4 text-center text-white">Health</div>
			<div class="rounded-md bg-indigo-600 p-4 text-center text-white">Mana</div>
			<div class="rounded-md bg-amber-600 p-4 text-center text-white">Stamina</div>
		</div>
	</div>
</body>
</rml>
