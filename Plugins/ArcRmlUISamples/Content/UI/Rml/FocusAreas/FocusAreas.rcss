.fa-panel {
	position: absolute;
	left: 80px;
	top: 60px;
	width: 760px;
	padding: 24px 32px;
	background-color: rgba(20, 24, 32, 0.9);
	border-radius: 8px;
}

.fa-title {
	display: block;
	font-size: 36px;
	margin-bottom: 12px;
}

.fa-columns {
	display: flex;
	gap: 16px;
}

.fa-area {
	display: block;
	flex: 1;
	padding: 8px 12px;
	border: 2px #3a4456;
	border-radius: 4px;
}

.fa-popup {
	display: block;
	margin-top: 24px;
	padding: 8px 12px;
	border: 2px #8a6a2a;
	border-radius: 4px;
	background-color: #262d3a;
}

.fa-label {
	font-size: 16px;
	color: #9aa6ba;
}

.fa-item {
	display: block;
	width: 100%;
	margin: 6px 0;
	padding: 8px 12px;
	border-radius: 4px;
	background-color: #3a4456;
	color: #e8e8e8;
}

.fa-item:hover {
	background-color: #4d5a72;
}

.fa-item:focus-visible {
	background-color: #2f6fb0;
}

.fa-log {
	display: block;
	margin-top: 16px;
	color: #ffd27a;
}
