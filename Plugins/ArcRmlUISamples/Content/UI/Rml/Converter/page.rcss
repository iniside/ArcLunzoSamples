body {
  font-family: 'Arc Samples Sans';
  color: #e8ecf1;
  background-color: #11151c;
  margin: 0;
  padding: 48px;
}
.menu {
  width: 360px;
  padding: 24px;
  background-color: #1d2430;
  border-radius: 8px;
}
h1 {
  font-size: 32px;
  margin: 0 0 12px 0;
}
p {
  font-size: 16px;
  margin: 0 0 20px 0;
}
.entry {
  display: block;
  width: 100%;
  margin-bottom: 8px;
  padding: 10px 16px;
  font-size: 18px;
  color: #ffffff;
  background-color: #2f6fed;
  border-radius: 4px;
}
.entry:hover {
  background-color: #4a85ff;
}
