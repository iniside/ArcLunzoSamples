.wm-marker {
	position: absolute;
	left: 0;
	top: 0;
}

.wm-label {
	transform: translate(-50%, -100%);
	padding: 4px 12px;
	border-radius: 4px;
	background-color: rgba(20, 24, 32, 0.9);
	border: 2px solid #3399ff;
	white-space: nowrap;
}

.wm-panel {
	position: absolute;
	left: 80px;
	top: 80px;
	width: 420px;
	padding: 24px 32px;
	background-color: rgba(20, 24, 32, 0.9);
	border-radius: 8px;
}

.wm-title {
	display: block;
	font-size: 36px;
	margin-bottom: 12px;
}

.wm-buttons {
	display: flex;
	gap: 12px;
	margin-top: 16px;
}

.wm-button {
	padding: 8px 20px;
	border-radius: 4px;
	background-color: #3a4456;
	color: #e8e8e8;
}

.wm-button:hover, .wm-button:focus-visible {
	background-color: #4d5a72;
}
