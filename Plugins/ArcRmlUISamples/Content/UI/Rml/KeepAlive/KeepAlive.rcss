.ka-panel {
	position: absolute;
	left: 80px;
	top: 40px;
	width: 700px;
	padding: 24px 32px;
	background-color: rgba(20, 24, 32, 0.9);
	border-radius: 8px;
}

.ka-title {
	display: block;
	font-size: 36px;
	margin-bottom: 12px;
}

.ka-column {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	gap: 8px;
}

.ka-row {
	display: flex;
	align-items: center;
	gap: 16px;
}

.ka-button {
	padding: 8px 20px;
	border-radius: 4px;
	background-color: #3a4456;
	color: #e8e8e8;
}

.ka-button:hover {
	background-color: #4d5a72;
}

.ka-button:focus-visible {
	background-color: #2f6fb0;
}

.ka-count {
	font-size: 24px;
	color: #ffd27a;
}

.ka-label {
	font-size: 16px;
	color: #9aa6ba;
	margin-top: 16px;
}

.ka-field {
	display: block;
	width: 400px;
	padding: 6px 10px;
	border: 2px #3a4456;
	border-radius: 4px;
	background-color: #1a2030;
	color: #e8e8e8;
}

.ka-field:focus-visible {
	background-color: #2f6fb0;
}

.ka-scroll {
	display: block;
	width: 400px;
	height: 120px;
	overflow-y: auto;
	border: 2px #3a4456;
	border-radius: 4px;
}

.ka-scroll-row {
	padding: 4px 10px;
}

.ka-text {
	margin-bottom: 16px;
}

.ka-hint {
	margin-top: 16px;
	color: #ffd27a;
}
