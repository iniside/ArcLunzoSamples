.bv-panel {
	position: absolute;
	left: 80px;
	top: 80px;
	width: 420px;
	padding: 24px 32px;
	background-color: rgba(20, 24, 32, 0.9);
	border-radius: 8px;
}

.bv-title {
	display: block;
	font-size: 36px;
	margin-bottom: 12px;
}

.bv-buttons {
	display: flex;
	gap: 12px;
	margin-top: 16px;
}

.bv-button {
	padding: 8px 20px;
	border-radius: 4px;
	background-color: #3a4456;
	color: #e8e8e8;
}

.bv-button:hover {
	background-color: #4d5a72;
}
