.fc-panel {
	position: absolute;
	left: 80px;
	top: 40px;
	width: 700px;
	padding: 24px 32px;
	background-color: rgba(20, 24, 32, 0.9);
	border-radius: 8px;
}

.fc-title {
	display: block;
	font-size: 36px;
	margin-bottom: 12px;
}

.fc-row {
	margin-top: 8px;
}

.fc-label {
	font-size: 16px;
	color: #9aa6ba;
	margin-top: 12px;
}

.fc-range {
	width: 300px;
}

.fc-result {
	color: #ffd27a;
	margin-top: 16px;
}
