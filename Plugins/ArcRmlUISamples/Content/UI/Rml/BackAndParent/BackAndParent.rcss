.bp-panel {
	position: absolute;
	left: 80px;
	top: 60px;
	width: 700px;
	padding: 24px 32px;
	background-color: rgba(20, 24, 32, 0.9);
	border-radius: 8px;
}

.bp-title {
	display: block;
	font-size: 36px;
	margin-bottom: 12px;
}

.bp-columns {
	display: flex;
	gap: 16px;
}

.bp-area {
	display: block;
	flex: 1;
	padding: 8px 12px;
	border: 2px #3a4456;
	border-radius: 4px;
}

.bp-label {
	font-size: 16px;
	color: #9aa6ba;
}

.bp-item {
	display: block;
	width: 100%;
	margin: 6px 0;
	padding: 8px 12px;
	border-radius: 4px;
	background-color: #3a4456;
	color: #e8e8e8;
}

.bp-item:hover {
	background-color: #4d5a72;
}

.bp-item:focus-visible {
	background-color: #2f6fb0;
}

.bp-counts {
	margin-top: 16px;
	color: #ffd27a;
}

.bp-back {
	width: 160px;
	margin-top: 16px;
}
