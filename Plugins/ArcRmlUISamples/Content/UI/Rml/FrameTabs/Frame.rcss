.ft-panel {
	position: absolute;
	left: 80px;
	top: 60px;
	width: 700px;
	padding: 24px 32px;
	background-color: rgba(20, 24, 32, 0.9);
	border-radius: 8px;
}

.ft-title {
	display: block;
	font-size: 36px;
	margin-bottom: 12px;
}

.ft-bar {
	display: flex;
	gap: 8px;
}

.ft-tab {
	padding: 8px 20px;
	border-radius: 4px;
	background-color: #3a4456;
	color: #e8e8e8;
}

.ft-tab[selected] {
	background-color: #8a6a2a;
	color: #ffffff;
}

.ft-tab:focus-visible {
	background-color: #2f6fb0;
}

.ft-embed {
	display: block;
	height: 200px;
	margin-top: 16px;
	border: 2px #3a4456;
	border-radius: 4px;
}

.ft-hint {
	margin-top: 16px;
	color: #ffd27a;
}
