.ep-panel {
	position: absolute;
	left: 80px;
	top: 80px;
	width: 480px;
	padding: 24px 32px;
	background-color: rgba(20, 24, 32, 0.9);
	border-radius: 8px;
}

.ep-title {
	display: block;
	font-size: 36px;
	margin-bottom: 12px;
}

.ep-bar {
	height: 12px;
	margin: 8px 0;
	background-color: #303846;
	border-radius: 6px;
}

.ep-fill {
	width: 0%;
	height: 100%;
	border-radius: 6px;
}

.ep-warning {
	color: #ff8a7a;
}

.ep-item {
	display: block;
	margin: 4px 0;
	padding: 6px 12px;
	border-radius: 4px;
	background-color: #262d3a;
}

.ep-button {
	margin-top: 16px;
	padding: 8px 20px;
	border-radius: 4px;
	background-color: #3a4456;
	color: #e8e8e8;
}

.ep-button:hover {
	background-color: #4d5a72;
}
