.ev-panel {
	position: absolute;
	left: 80px;
	top: 80px;
	width: 640px;
	padding: 24px 32px;
	background-color: rgba(20, 24, 32, 0.9);
	border-radius: 8px;
}

.ev-title {
	display: block;
	font-size: 36px;
	margin-bottom: 12px;
}

.ev-last {
	color: #ffd27a;
}

.ev-row {
	display: flex;
	gap: 12px;
	margin: 8px 0;
}

.ev-box {
	display: block;
	margin: 8px 0;
	padding: 12px 16px;
	border-radius: 4px;
	background-color: #262d3a;
}

.ev-focusable {
	tab-index: auto;
	nav: auto;
}

.ev-focusable:focus-visible {
	background-color: #34405a;
}

.ev-button {
	padding: 8px 20px;
	border-radius: 4px;
	background-color: #3a4456;
	color: #e8e8e8;
}

.ev-button:hover {
	background-color: #4d5a72;
}
