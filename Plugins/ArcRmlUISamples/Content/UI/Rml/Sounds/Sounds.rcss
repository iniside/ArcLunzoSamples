body {
	--sound-back: "asset:/ArcRmlUISamples/UI/Rml/Sounds/MS_Sample_Back.MS_Sample_Back";
	--sound-close: "asset:/ArcRmlUISamples/UI/Rml/Sounds/MS_Sample_Back.MS_Sample_Back";
}

.sd-group {
	--sound-click: "asset:/ArcRmlUISamples/UI/Rml/Sounds/MS_Sample_Click.MS_Sample_Click";
	display: flex;
	flex-direction: column;
	gap: 12px;
}

#sd-hover {
	--sound-hover: "asset:/ArcRmlUISamples/UI/Rml/Sounds/MS_Sample_Click.MS_Sample_Click";
}

#sd-focus {
	--sound-focus: "asset:/ArcRmlUISamples/UI/Rml/Sounds/MS_Sample_Click.MS_Sample_Click";
}

.sd-panel {
	position: absolute;
	left: 80px;
	top: 60px;
	width: 520px;
	padding: 24px 32px;
	background-color: rgba(20, 24, 32, 0.9);
	border-radius: 8px;
}

.sd-title {
	display: block;
	font-size: 36px;
	margin-bottom: 12px;
}

.sd-button {
	display: block;
	padding: 8px 20px;
	border-radius: 4px;
	background-color: #3a4456;
	color: #e8e8e8;
}

.sd-button:hover {
	background-color: #4d5a72;
}

.sd-button:focus-visible {
	outline: 2px solid #3a86ff;
}

.sd-count {
	margin: 16px 0 4px 0;
}

.sd-hint {
	margin: 0 0 16px 0;
	font-size: 15px;
	color: #a9b4c6;
}
