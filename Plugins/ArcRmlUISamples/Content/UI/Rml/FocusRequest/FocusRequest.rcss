.fr-panel {
	position: absolute;
	left: 80px;
	top: 40px;
	width: 700px;
	padding: 24px 32px;
	background-color: rgba(20, 24, 32, 0.9);
	border-radius: 8px;
}

.fr-title {
	display: block;
	font-size: 36px;
	margin-bottom: 12px;
}

.fr-row {
	display: flex;
	gap: 8px;
}

.fr-button {
	padding: 8px 20px;
	border-radius: 4px;
	background-color: #3a4456;
	color: #e8e8e8;
}

.fr-button:hover {
	background-color: #4d5a72;
}

.fr-button:focus-visible {
	background-color: #2f6fb0;
}

.fr-label {
	font-size: 16px;
	color: #9aa6ba;
	margin-top: 16px;
}

.fr-field {
	display: block;
	width: 400px;
	padding: 6px 10px;
	border: 2px #3a4456;
	border-radius: 4px;
	background-color: #1a2030;
	color: #e8e8e8;
}

.fr-field:focus-visible {
	background-color: #2f6fb0;
}
