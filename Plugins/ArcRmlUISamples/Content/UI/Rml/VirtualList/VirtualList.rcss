.vl-panel {
	position: absolute;
	left: 80px;
	top: 40px;
	width: 700px;
	padding: 24px 32px;
	background-color: rgba(20, 24, 32, 0.9);
	border-radius: 8px;
}

.vl-title {
	display: block;
	font-size: 36px;
	margin-bottom: 12px;
}

.vl-result {
	color: #ffd27a;
	margin-bottom: 12px;
}

.vl-list {
	height: 360px;
	overflow-y: auto;
	background-color: #1b212b;
	border-radius: 4px;
}

.vl-row {
	display: block;
	width: 100%;
	height: 36px;
	padding: 0 16px;
	text-align: left;
	background-color: #303846;
	border-bottom: 1px #1b212b;
}

.vl-row:hover {
	background-color: #4d5a72;
}

.vl-row:focus-visible {
	background-color: #2f6fb0;
}
