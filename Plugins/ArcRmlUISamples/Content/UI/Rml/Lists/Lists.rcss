.ls-panel {
	position: absolute;
	left: 80px;
	top: 80px;
	width: 480px;
	padding: 24px 32px;
	background-color: rgba(20, 24, 32, 0.9);
	border-radius: 8px;
}

.ls-title {
	display: block;
	font-size: 36px;
	margin-bottom: 12px;
}

.ls-row {
	display: flex;
	align-items: center;
	gap: 12px;
	margin: 6px 0;
	padding: 6px 12px;
	background-color: #303846;
	border-radius: 4px;
}

.ls-name {
	flex: 1;
}

.ls-buttons {
	display: flex;
	gap: 12px;
	margin-top: 16px;
}

.ls-button {
	padding: 8px 20px;
	border-radius: 4px;
	background-color: #3a4456;
	color: #e8e8e8;
}

.ls-button:hover {
	background-color: #4d5a72;
}
