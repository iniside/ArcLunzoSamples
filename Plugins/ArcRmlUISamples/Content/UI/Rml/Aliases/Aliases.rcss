.al-panel {
	position: absolute;
	left: 80px;
	top: 40px;
	width: 700px;
	padding: 24px 32px;
	background-color: rgba(20, 24, 32, 0.9);
	border-radius: 8px;
}

.al-title {
	display: block;
	font-size: 36px;
	margin-bottom: 12px;
}

.al-card {
	padding: 12px 16px;
	background-color: #303846;
	border-radius: 4px;
}

.al-name {
	font-size: 28px;
	color: #ffd27a;
}

.al-result {
	color: #9aa6ba;
	margin-top: 16px;
}

.al-button {
	display: block;
	margin-top: 16px;
	padding: 8px 20px;
	border-radius: 4px;
	background-color: #3a4456;
	color: #e8e8e8;
}

.al-button:hover {
	background-color: #4d5a72;
}

.al-button:focus-visible {
	background-color: #2f6fb0;
}
