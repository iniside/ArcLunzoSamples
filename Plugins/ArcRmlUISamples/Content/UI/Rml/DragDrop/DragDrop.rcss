.dd-panel {
	position: absolute;
	left: 80px;
	top: 60px;
	width: 820px;
	padding: 24px 32px;
	background-color: rgba(20, 24, 32, 0.9);
	border-radius: 8px;
}

.dd-title {
	display: block;
	font-size: 36px;
	margin-bottom: 12px;
}

.dd-columns {
	display: flex;
	gap: 32px;
}

.dd-column {
	width: 220px;
}

.dd-label {
	font-size: 16px;
	color: #9aa6ba;
	margin: 8px 0 4px 0;
}

.dd-slot, .dd-row {
	display: block;
	box-sizing: border-box;
	width: 220px;
	tab-index: auto;
	nav: auto;
	padding: 8px 12px;
	border-radius: 4px;
	border: 2px #3a4456;
}

.dd-slot {
	height: 44px;
	margin-bottom: 8px;
}

.dd-row {
	height: 40px;
	margin-bottom: 4px;
}

.dd-item {
	background-color: #3a4456;
	drag: clone;
}

.dd-item:drag {
	background-color: #2f6fb0;
	opacity: 0.8;
}

.dd-item.drag-source {
	opacity: 0.4;
}

.dd-target {
	background-color: #1c2230;
}

.dd-slot:focus-visible, .dd-row:focus-visible {
	border-color: #ffd27a;
}

.dd-target.drop-over {
	background-color: #2e6b3a;
	border-color: #6fd17f;
}

.dd-target.drop-invalid {
	background-color: #6b2e2e;
	border-color: #d16f6f;
}

.dd-hint {
	margin-top: 16px;
	color: #ffd27a;
}
