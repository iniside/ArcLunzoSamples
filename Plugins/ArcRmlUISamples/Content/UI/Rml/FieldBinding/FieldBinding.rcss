.fb-panel {
	position: absolute;
	left: 80px;
	top: 80px;
	width: 480px;
	padding: 24px 32px;
	background-color: rgba(20, 24, 32, 0.9);
	border-radius: 8px;
}

.fb-title {
	display: block;
	font-size: 36px;
	margin-bottom: 12px;
}

.fb-badge {
	display: inline-block;
	margin: 8px 0;
	padding: 4px 12px;
	border-radius: 4px;
	background-color: #2f6fb0;
}

.fb-badge.fb-odd {
	background-color: #b0602f;
}

.fb-bar {
	height: 12px;
	margin: 8px 0;
	background-color: #303846;
	border-radius: 6px;
}

.fb-fill {
	width: 0%;
	height: 100%;
	border-radius: 6px;
	background-color: #3399ff;
}

.fb-progress {
	display: block;
	width: 100%;
	height: 8px;
	margin: 8px 0;
	background-color: #303846;
}

.fb-progress fill {
	background-color: #e8e8e8;
}

.fb-buttons {
	display: flex;
	gap: 12px;
	margin-top: 16px;
}

.fb-button {
	padding: 8px 20px;
	border-radius: 4px;
	background-color: #3a4456;
	color: #e8e8e8;
}

.fb-button:hover {
	background-color: #4d5a72;
}
