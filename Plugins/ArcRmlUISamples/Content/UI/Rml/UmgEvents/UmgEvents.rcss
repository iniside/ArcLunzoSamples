body {
	margin: 0;
	width: 100%;
	height: 100%;
}

.ue-card {
	width: 100%;
	height: 100%;
	box-sizing: border-box;
	padding: 24px 32px;
	background-color: rgba(20, 24, 32, 0.9);
	border-radius: 8px;
}

.ue-title {
	display: block;
	font-size: 36px;
	margin-bottom: 12px;
}

.ue-buttons {
	margin-top: 16px;
}

.ue-button {
	margin-right: 12px;
	padding: 8px 20px;
	border-radius: 4px;
	background-color: #3a4456;
	color: #e8e8e8;
}

.ue-button:hover {
	background-color: #4d5a72;
}
