.gm-panel {
	position: absolute;
	left: 80px;
	top: 80px;
	width: 480px;
	padding: 24px 32px;
	background-color: rgba(20, 24, 32, 0.9);
	border-radius: 8px;
}

.gm-title {
	display: block;
	font-size: 36px;
	margin-bottom: 12px;
}

.gm-button {
	display: block;
	width: 100%;
	margin: 6px 0;
	padding: 10px 20px;
	border-radius: 4px;
	background-color: #3a4456;
	color: #e8e8e8;
}

.gm-button:hover {
	background-color: #4d5a72;
}

.gm-button:focus-visible {
	background-color: #2f6fb0;
}

.gm-last {
	margin-top: 12px;
	color: #ffd27a;
}

.gm-info {
	padding: 8px 12px;
	border-radius: 4px;
	background-color: #262d3a;
}

.gm-prompts {
	display: flex;
	gap: 16px;
	margin-top: 16px;
	font-size: 16px;
}

.gm-prompt {
	padding: 4px 10px;
	border-radius: 4px;
	background-color: #262d3a;
}
