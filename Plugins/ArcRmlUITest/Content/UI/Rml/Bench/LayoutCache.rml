<rml>
<head>
	<title>Layout result cache benchmark</title>
	<meta name="layer" content="UI.Layer.Menu"/>
	<meta name="input-mode" content="menu"/>
	<link type="text/rcss" href="LayoutCache.rcss"/>
<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Fonts/Fonts.rcss"/></head>
<body>
<div class="legend"><span class="lg lg-idle">idle</span><span class="lg lg-chains">a chains</span><span class="lg lg-leaf">b leaf</span><span class="lg lg-pairs">c pairs</span><span class="lg lg-block">d block</span></div>
<input type="radio" name="case" value="idle" id="r-idle" class="rb rb-idle" checked=""/>
<input type="radio" name="case" value="chains" id="r-chains" class="rb rb-chains"/>
<input type="radio" name="case" value="leaf" id="r-leaf" class="rb rb-leaf"/>
<input type="radio" name="case" value="pairs" id="r-pairs" class="rb rb-pairs"/>
<input type="radio" name="case" value="block" id="r-block" class="rb rb-block"/>
<div class="pnl pnl-chains">
<div class="pnl-title">a) measurement chains: grid auto tracks, inline-block, flex basis auto, fit-content, float, min/max-content, absolute auto width</div>
<div class="ch-grid">
<div class="ch-tickrow"><div class="ch-tick"></div></div>
<div class="ch-card"><div class="ch-ib"><div class="ch-row"><div class="ch-a"><span class="ch-t">Ashen Blade</span></div><div class="ch-b"><div class="ch-fit"><div class="ch-row2"><span class="ch-pill">Lv 10</span><span class="ch-sub">rare</span></div></div></div></div><div class="ch-flt"><div class="ch-minc">Heals over time</div></div><div class="ch-maxc"><span>x2 rare</span></div></div><div class="ch-abs"><div class="ch-row2"><span class="ch-pill">#1</span></div></div></div>
