@font-face {
	font-family: 'Space Grotesk';
	font-weight: 400;
	src: /ArcRmlUITest/UI/Rml/Fonts/SpaceGrotesk-Regular.ttf;
	-rmlui-fallback-face: true;
}

@font-face {
	font-family: 'Space Grotesk';
	font-weight: 500;
	src: /ArcRmlUITest/UI/Rml/Fonts/SpaceGrotesk-Medium.ttf;
	-rmlui-fallback-face: true;
}

@font-face {
	font-family: 'Space Grotesk';
	font-weight: 600;
	src: /ArcRmlUITest/UI/Rml/Fonts/SpaceGrotesk-SemiBold.ttf;
	-rmlui-fallback-face: true;
}

@font-face {
	font-family: 'Space Grotesk';
	font-weight: 700;
	src: /ArcRmlUITest/UI/Rml/Fonts/SpaceGrotesk-Bold.ttf;
	-rmlui-fallback-face: true;
}

