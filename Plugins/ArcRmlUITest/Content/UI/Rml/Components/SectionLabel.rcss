.sectionlabel {
	display: flex;
	align-items: baseline;
	gap: 10px;
	font-family: var(--font-sans);
}

.sectionlabel-sm {
	font-size: 11px;
	font-weight: 600;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: rgba(255,255,255,0.4);
}

.sectionlabel-lg {
	font-size: 13px;
	font-weight: 600;
	letter-spacing: 3px;
	text-transform: uppercase;
	color: color-mix(in srgb, var(--accent) 55%, rgba(255,255,255,0.35));
}

.sectionlabel-meta {
	font-family: var(--font-mono);
	font-size: 11px;
	color: rgba(255,255,255,0.38);
}
