<component>
	<prop name="label"/>
	<prop name="variant" default="secondary"/>
	<prop name="size" default="md"/>
	<prop name="icon" default=""/>
	<prop name="iconColor" default="currentColor"/>
	<prop name="align" default="center"/>
	<prop name="keyLabel" default=""/>
	<prop name="block"/>
	<prop name="selected"/>
	<prop name="disabled"/>
	<prop name="title" default=""/>
	<prop name="action"/>
	<div class="button-primary" data-if="!$disabled &amp;&amp; $variant == 'primary'" data-class-has-action="$action != ''" data-attr-data-action="$action" data-attr-title="$title" data-style-justify-content="$align == 'start' ? 'flex-start' : 'center'" data-style-flex-shrink="$block ? 1 : 0" data-style-height="$size == 'xl' ? '58px' : ($size == 'lg' ? '50px' : ($size == 'sm' ? '30px' : ($size == 'icon' ? '28px' : '38px')))" data-style-width="$size == 'icon' ? '28px' : ($block ? '100%' : 'auto')" data-style-padding="'0 ' + ($size == 'xl' ? '24px' : ($size == 'lg' ? '20px' : ($size == 'sm' ? '11px' : ($size == 'icon' ? '0' : '18px'))))" data-style-font-size="$size == 'xl' ? '17px' : ($size == 'lg' ? '14px' : ($size == 'sm' ? '11.5px' : ($size == 'icon' ? '12px' : '13px')))" data-style-letter-spacing="$size == 'xl' ? '2px' : '1px'">
		<i class="button-icon" data-if="$icon != ''" data-style-color="$iconColor"><svg data-attr-src="$icon" data-attr-width="$size == 'xl' ? 19 : ($size == 'lg' ? 17 : ($size == 'sm' ? 13 : ($size == 'icon' ? 14 : 16)))" data-attr-height="$size == 'xl' ? 19 : ($size == 'lg' ? 17 : ($size == 'sm' ? 13 : ($size == 'icon' ? 14 : 16)))" stroke-width="2"/></i>
		<span class="button-label" data-if="($label != '' ? $label : ($size == 'icon' ? '' : 'Button')) != ''">{{ $label != '' ? $label : ($size == 'icon' ? '' : 'Button') }}</span>
		<dc-import name="/ArcRmlUITest/UI/Rml/Components/KeyBadge" data-if="$keyLabel != ''" label="{{ $keyLabel }}"/>
	</div>
	<div class="button-success" data-if="!$disabled &amp;&amp; $variant == 'success'" data-class-has-action="$action != ''" data-attr-data-action="$action" data-attr-title="$title" data-style-justify-content="$align == 'start' ? 'flex-start' : 'center'" data-style-flex-shrink="$block ? 1 : 0" data-style-height="$size == 'xl' ? '58px' : ($size == 'lg' ? '50px' : ($size == 'sm' ? '30px' : ($size == 'icon' ? '28px' : '38px')))" data-style-width="$size == 'icon' ? '28px' : ($block ? '100%' : 'auto')" data-style-padding="'0 ' + ($size == 'xl' ? '24px' : ($size == 'lg' ? '20px' : ($size == 'sm' ? '11px' : ($size == 'icon' ? '0' : '18px'))))" data-style-font-size="$size == 'xl' ? '17px' : ($size == 'lg' ? '14px' : ($size == 'sm' ? '11.5px' : ($size == 'icon' ? '12px' : '13px')))" data-style-letter-spacing="$size == 'xl' ? '2px' : '1px'">
		<i class="button-icon" data-if="$icon != ''" data-style-color="$iconColor"><svg data-attr-src="$icon" data-attr-width="$size == 'xl' ? 19 : ($size == 'lg' ? 17 : ($size == 'sm' ? 13 : ($size == 'icon' ? 14 : 16)))" data-attr-height="$size == 'xl' ? 19 : ($size == 'lg' ? 17 : ($size == 'sm' ? 13 : ($size == 'icon' ? 14 : 16)))" stroke-width="2"/></i>
		<span class="button-label" data-if="($label != '' ? $label : ($size == 'icon' ? '' : 'Button')) != ''">{{ $label != '' ? $label : ($size == 'icon' ? '' : 'Button') }}</span>
		<dc-import name="/ArcRmlUITest/UI/Rml/Components/KeyBadge" data-if="$keyLabel != ''" label="{{ $keyLabel }}"/>
	</div>
	<div class="button-secondary" data-if="!$disabled &amp;&amp; !$selected &amp;&amp; $variant == 'secondary'" data-class-has-action="$action != ''" data-attr-data-action="$action" data-attr-title="$title" data-style-justify-content="$align == 'start' ? 'flex-start' : 'center'" data-style-flex-shrink="$block ? 1 : 0" data-style-height="$size == 'xl' ? '58px' : ($size == 'lg' ? '50px' : ($size == 'sm' ? '30px' : ($size == 'icon' ? '28px' : '38px')))" data-style-width="$size == 'icon' ? '28px' : ($block ? '100%' : 'auto')" data-style-padding="'0 ' + ($size == 'xl' ? '24px' : ($size == 'lg' ? '20px' : ($size == 'sm' ? '11px' : ($size == 'icon' ? '0' : '18px'))))" data-style-font-size="$size == 'xl' ? '17px' : ($size == 'lg' ? '14px' : ($size == 'sm' ? '11.5px' : ($size == 'icon' ? '12px' : '13px')))" data-style-letter-spacing="($size == 'lg' || $size == 'xl') ? '1.5px' : 'normal'" data-style-text-transform="($size == 'lg' || $size == 'xl') ? 'uppercase' : 'none'">
		<i class="button-icon" data-if="$icon != ''" data-style-color="$iconColor"><svg data-attr-src="$icon" data-attr-width="$size == 'xl' ? 19 : ($size == 'lg' ? 17 : ($size == 'sm' ? 13 : ($size == 'icon' ? 14 : 16)))" data-attr-height="$size == 'xl' ? 19 : ($size == 'lg' ? 17 : ($size == 'sm' ? 13 : ($size == 'icon' ? 14 : 16)))" stroke-width="1.9"/></i>
		<span class="button-label" data-if="($label != '' ? $label : ($size == 'icon' ? '' : 'Button')) != ''">{{ $label != '' ? $label : ($size == 'icon' ? '' : 'Button') }}</span>
		<dc-import name="/ArcRmlUITest/UI/Rml/Components/KeyBadge" data-if="$keyLabel != ''" label="{{ $keyLabel }}"/>
	</div>
	<div class="button-selected" selected="" data-if="!$disabled &amp;&amp; $selected &amp;&amp; $variant == 'secondary'" data-class-has-action="$action != ''" data-attr-data-action="$action" data-attr-title="$title" data-style-justify-content="$align == 'start' ? 'flex-start' : 'center'" data-style-flex-shrink="$block ? 1 : 0" data-style-height="$size == 'xl' ? '58px' : ($size == 'lg' ? '50px' : ($size == 'sm' ? '30px' : ($size == 'icon' ? '28px' : '38px')))" data-style-width="$size == 'icon' ? '28px' : ($block ? '100%' : 'auto')" data-style-padding="'0 ' + ($size == 'xl' ? '24px' : ($size == 'lg' ? '20px' : ($size == 'sm' ? '11px' : ($size == 'icon' ? '0' : '18px'))))" data-style-font-size="$size == 'xl' ? '17px' : ($size == 'lg' ? '14px' : ($size == 'sm' ? '11.5px' : ($size == 'icon' ? '12px' : '13px')))" data-style-letter-spacing="($size == 'lg' || $size == 'xl') ? '1.5px' : 'normal'" data-style-text-transform="($size == 'lg' || $size == 'xl') ? 'uppercase' : 'none'">
		<i class="button-icon" data-if="$icon != ''" data-style-color="$iconColor"><svg data-attr-src="$icon" data-attr-width="$size == 'xl' ? 19 : ($size == 'lg' ? 17 : ($size == 'sm' ? 13 : ($size == 'icon' ? 14 : 16)))" data-attr-height="$size == 'xl' ? 19 : ($size == 'lg' ? 17 : ($size == 'sm' ? 13 : ($size == 'icon' ? 14 : 16)))" stroke-width="1.9"/></i>
		<span class="button-label" data-if="($label != '' ? $label : ($size == 'icon' ? '' : 'Button')) != ''">{{ $label != '' ? $label : ($size == 'icon' ? '' : 'Button') }}</span>
		<dc-import name="/ArcRmlUITest/UI/Rml/Components/KeyBadge" data-if="$keyLabel != ''" label="{{ $keyLabel }}"/>
	</div>
	<div class="button-danger" data-if="!$disabled &amp;&amp; $variant == 'danger'" data-class-has-action="$action != ''" data-attr-data-action="$action" data-attr-title="$title" data-style-justify-content="$align == 'start' ? 'flex-start' : 'center'" data-style-flex-shrink="$block ? 1 : 0" data-style-height="$size == 'xl' ? '58px' : ($size == 'lg' ? '50px' : ($size == 'sm' ? '30px' : ($size == 'icon' ? '28px' : '38px')))" data-style-width="$size == 'icon' ? '28px' : ($block ? '100%' : 'auto')" data-style-padding="'0 ' + ($size == 'xl' ? '24px' : ($size == 'lg' ? '20px' : ($size == 'sm' ? '11px' : ($size == 'icon' ? '0' : '18px'))))" data-style-font-size="$size == 'xl' ? '17px' : ($size == 'lg' ? '14px' : ($size == 'sm' ? '11.5px' : ($size == 'icon' ? '12px' : '13px')))" data-style-letter-spacing="($size == 'lg' || $size == 'xl') ? '1.5px' : 'normal'" data-style-text-transform="($size == 'lg' || $size == 'xl') ? 'uppercase' : 'none'">
		<i class="button-icon" data-if="$icon != ''" data-style-color="$iconColor"><svg data-attr-src="$icon" data-attr-width="$size == 'xl' ? 19 : ($size == 'lg' ? 17 : ($size == 'sm' ? 13 : ($size == 'icon' ? 14 : 16)))" data-attr-height="$size == 'xl' ? 19 : ($size == 'lg' ? 17 : ($size == 'sm' ? 13 : ($size == 'icon' ? 14 : 16)))" stroke-width="2"/></i>
		<span class="button-label" data-if="($label != '' ? $label : ($size == 'icon' ? '' : 'Button')) != ''">{{ $label != '' ? $label : ($size == 'icon' ? '' : 'Button') }}</span>
		<dc-import name="/ArcRmlUITest/UI/Rml/Components/KeyBadge" data-if="$keyLabel != ''" label="{{ $keyLabel }}"/>
	</div>
	<div class="button-disabled" data-if="$disabled" data-attr-title="$title" data-style-justify-content="$align == 'start' ? 'flex-start' : 'center'" data-style-flex-shrink="$block ? 1 : 0" data-style-height="$size == 'xl' ? '58px' : ($size == 'lg' ? '50px' : ($size == 'sm' ? '30px' : ($size == 'icon' ? '28px' : '38px')))" data-style-width="$size == 'icon' ? '28px' : ($block ? '100%' : 'auto')" data-style-padding="'0 ' + ($size == 'xl' ? '24px' : ($size == 'lg' ? '20px' : ($size == 'sm' ? '11px' : ($size == 'icon' ? '0' : '18px'))))" data-style-font-size="$size == 'xl' ? '17px' : ($size == 'lg' ? '14px' : ($size == 'sm' ? '11.5px' : ($size == 'icon' ? '12px' : '13px')))" data-style-letter-spacing="($size == 'lg' || $size == 'xl') ? '1.5px' : 'normal'" data-style-text-transform="($size == 'lg' || $size == 'xl') ? 'uppercase' : 'none'">
		<i class="button-icon" data-if="$icon != ''" data-style-color="$iconColor"><svg data-attr-src="$icon" data-attr-width="$size == 'xl' ? 19 : ($size == 'lg' ? 17 : ($size == 'sm' ? 13 : ($size == 'icon' ? 14 : 16)))" data-attr-height="$size == 'xl' ? 19 : ($size == 'lg' ? 17 : ($size == 'sm' ? 13 : ($size == 'icon' ? 14 : 16)))" stroke-width="1.9"/></i>
		<span class="button-label" data-if="($label != '' ? $label : ($size == 'icon' ? '' : 'Button')) != ''">{{ $label != '' ? $label : ($size == 'icon' ? '' : 'Button') }}</span>
		<dc-import name="/ArcRmlUITest/UI/Rml/Components/KeyBadge" data-if="$keyLabel != ''" label="{{ $keyLabel }}"/>
	</div>
</component>
