body {
	width: 100%;
	height: 100%;
	--o: 0.5;
}

.parent {
	display: block;
	opacity: 0.5;
	width: 100px;
	height: 40px;
	margin-bottom: 10px;
}

.parent > div {
	display: block;
	width: 60px;
	height: 20px;
}

#plain {
	background-color: #ff0000;
}

#inh {
	background-color: #00ff00;
	opacity: inherit;
}

#viavar {
	background-color: #0000ff;
	opacity: var(--o);
}

body.full .parent {
	opacity: 1;
}
