body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
	color: #ffffff;
}

div {
	display: block;
}

@keyframes flash {
	from { color: #ff2020; }
	to { color: #20ffff; }
}

.flash {
	animation: 4s linear flash;
}

input.chk {
	width: 20px;
	height: 20px;
	background-color: #ff0000;
}

input.chk:checked {
	background-color: #00ff00;
}
