<rml>
<head>
	<title>ArcRmlUI Animated Bound Style Test</title>
	<meta name="layer" content="UI.Layer.Menu"/>
	<meta name="input-mode" content="menu"/>
	<viewmodel name="mock" class="/Script/ArcRmlUITestRuntime.ArcRmlMockListViewModel" context="MockList"/>
<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Fonts/Fonts.rcss"/></head>
<body data-model="mock">
	<div data-for="row : Rows" data-attr-style="'widht: ' + row.Value + 'px; display: block; height: 4px;'"></div>
</body>
</rml>
