body {
	width: 100%;
	height: 100%;
	font-family: "Space Grotesk";
	color: #ffffff;
}

.stripes {
	position: absolute;
	left: 100px;
	top: 100px;
	width: 700px;
	height: 400px;
	decorator: repeating-linear-gradient(45deg, #f9c74f 0px, #f9c74f 16px, #43aa8b 16px, #43aa8b 32px);
}

.pulse {
	position: absolute;
	left: 180px;
	top: 160px;
	width: 120px;
	height: 120px;
	background-color: #4361ee;
	border-radius: 12px;
	box-shadow: #000c 0px 12px 24px 4px, #f72585 0px 0px 0px 6px;
	animation: 1.2s infinite alternate grow;
}

.pulse.second {
	left: 520px;
	top: 260px;
	animation: 0.9s infinite alternate grow;
}

@keyframes grow {
	from { width: 80px; height: 80px; }
	to { width: 220px; height: 180px; }
}

.glass {
	position: absolute;
	left: 220px;
	top: 220px;
	width: 480px;
	height: 160px;
	padding: 16px;
	box-sizing: border-box;
	border-radius: 16px;
	background-color: #ffffff22;
	border: 1px solid #ffffff55;
	backdrop-filter: blur(10px) saturate(1.8);
}
