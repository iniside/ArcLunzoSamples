body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
	color: #e8ecf4;
}

div {
	display: block;
}

@keyframes rootLeave { from { opacity: 1; } to { opacity: 0; } }
body.leave { animation: rootLeave 3s linear forwards; }

.ltt-btn {
	tab-index: auto;
	nav: auto;
	width: 160px;
	height: 40px;
	margin-bottom: 8px;
	background-color: #1e2330;
}
