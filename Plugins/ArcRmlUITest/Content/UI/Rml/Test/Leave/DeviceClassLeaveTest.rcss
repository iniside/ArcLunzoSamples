body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
	color: #e8ecf4;
	transition: color 3s linear;
}

body.input-gamepad {
	color: #ff4040;
}

div {
	display: block;
}

@keyframes rootLeave { from { opacity: 1; } to { opacity: 0; } }
body.leave { animation: rootLeave .1s linear forwards; }

.dcl-btn {
	tab-index: auto;
	nav: auto;
	width: 160px;
	height: 40px;
	background-color: #1e2330;
}
