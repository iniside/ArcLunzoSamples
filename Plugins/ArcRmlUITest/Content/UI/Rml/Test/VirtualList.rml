<rml>
<head>
	<title>ArcRmlUI Virtual List Test</title>
	<meta name="layer" content="UI.Layer.Menu"/>
	<meta name="input-mode" content="menu"/>
	<link type="text/rcss" href="VirtualList.rcss"/>
	<viewmodel name="vlist" preview="Preview/VirtualList.json"/>
	<viewmodel name="mock" class="/Script/ArcRmlUITestRuntime.ArcRmlMockListViewModel" context="MockList" optional="true"/>
<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Fonts/Fonts.rcss"/></head>
<body data-model="vlist">
	<div class="panel list-panel">
		<div class="title">List: {{ rows.size }} rows ({{ variant }})</div>
		<div class="frame">
			<div id="list" class="scroller list">
				<div class="row" data-for="row, i : rows" data-virtual>
					<span class="idx">{{ i }}</span>
					<span class="name">{{ row.name }}</span>
					<span class="val">{{ row.value }}</span>
				</div>
			</div>
			<div id="list-probe-top" class="probe probe-top"></div>
			<div id="list-probe-end" class="probe probe-end"></div>
		</div>
	</div>
	<div class="panel grid-panel">
		<div class="title">Grid: {{ tiles.size }} tiles, keyed ({{ variant }})</div>
		<div class="frame">
			<div id="grid" class="scroller grid">
				<div class="tile" data-for="tile, t : tiles" data-key="tile.id" data-virtual>
					<span class="tile-index">{{ t }}</span>
					<span class="tile-id">{{ tile.id }}</span>
				</div>
			</div>
			<div id="grid-probe-top" class="probe probe-top"></div>
			<div id="grid-probe-end" class="probe probe-end"></div>
		</div>
	</div>
	<div class="panel mock-panel" data-model="mock">
		<div class="title">Live: {{ Rows.size }} rows</div>
		<div class="frame">
			<div id="mock" class="scroller list">
				<div class="row" data-for="row, m : Rows" data-key="row.Id" data-virtual>
					<span class="idx">{{ m }}</span>
					<span class="name">{{ row.Name }}</span>
					<span class="val">{{ row.Value }}</span>
				</div>
			</div>
		</div>
	</div>
</body>
</rml>
