body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
	color: #ffffff;
}

.row {
	display: flex;
	height: 30px;
}

.bar {
	width: 40px;
	height: 20px;
	background-color: #ff2020;
	animation: 1s linear infinite alternate grow;
}

@keyframes grow {
	from { width: 40px; }
	to { width: 200px; }
}
