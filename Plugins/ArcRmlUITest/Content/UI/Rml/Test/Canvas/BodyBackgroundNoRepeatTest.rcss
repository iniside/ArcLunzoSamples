body {
	width: 100%;
	height: 100%;
	margin: 50px;
	background: linear-gradient(#ff00ff, #ff00ff) 0 0 / 100px 100px no-repeat, linear-gradient(#00ffff, #00ffff) 100% 0 / 50% 100px no-repeat;
	background-color: #302010;
}
#nr-box { position: absolute; left: 10px; top: 300px; width: 40px; height: 40px; background-color: #aabbcc; }
