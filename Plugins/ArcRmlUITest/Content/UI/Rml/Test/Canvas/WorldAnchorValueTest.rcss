body {
	width: 100%;
	height: 100%;
	margin: 0;
}
#wa-point, #wa-empty, #wa-blank, #wa-bad { position: absolute; left: 0; top: 0; width: 20px; height: 20px; }
#wa-point { background-color: #ffcc00; }
#wa-empty { background-color: #00ccff; }
#wa-blank { background-color: #33ff66; }
#wa-bad { background-color: #ff00cc; }
