body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
	color: #e8ecf4;
}

div {
	display: block;
}

@keyframes kSame {
	from { width: 10px; }
	to { width: 30px; }
}

@decorator kdSame : horizontal-gradient {
	start-color: #00ff00;
	stop-color: #00ff00;
}

#kf-title {
	height: 30px;
}

.kf-btn {
	tab-index: auto;
	nav: auto;
	width: 140px;
	height: 26px;
	background-color: #1e2330;
}

#dup {
	width: 111px;
	height: 20px;
	background-color: #445566;
}

#nid {
	width: 91px;
	height: 20px;
	tab-index: auto;
	nav: auto;
	background-color: #556644;
}

#kf-same {
	height: 16px;
	background-color: #775533;
	animation: kSame 4s linear forwards;
}

#kf-deco {
	width: 60px;
	height: 16px;
	decorator: kdSame;
}

.kt-box {
	background-color: #ff0000;
	border: 3px solid #ff0000;
}

#ka-box, #kb-box {
	margin-left: 40px;
}

[arc-embed] {
	height: 450px;
}

#kf-btn2 {
	nav-right: #ka-only-btn;
}

#kf-btn {
	nav-right: #nid;
}
