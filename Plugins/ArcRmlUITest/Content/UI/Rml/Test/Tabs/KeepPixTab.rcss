div {
	display: block;
}

body {
	margin: 0;
	font-family: 'Space Grotesk', sans-serif;
}

.pix-box {
	width: 120px;
	height: 40px;
	margin: 0 0 10px 10px;
	background-color: #3050a0;
}

.pix-var {
	width: 120px;
	height: 30px;
	margin: 0 0 10px 10px;
	background-color: var(--tab-fill, #30a050);
}

.pix-text {
	height: 24px;
	margin: 0 0 10px 10px;
}

.pix-border {
	width: 100px;
	height: 20px;
	margin: 0 0 0 10px;
	border: 4px solid #a03020;
	background-color: #e0c040;
}
