<rml>
<head>
	<title>Batch Slot Grid</title>
	<meta name="layer" content="UI.Layer.Menu"/>
	<meta name="input-mode" content="game"/>
	<link type="text/rcss" href="SlotGrid.rcss"/>
<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Fonts/Fonts.rcss"/></head>
<body>
	<div class="grid">
		<div class="slot q0"><svg src="/ArcRmlUITest/UI/Rml/Test/Lucide/anchor.svg" width="18" height="18" stroke-width="2"/><span class="count">0</span><span class="name">Item 0</span></div>
		<div class="slot q1"><svg src="/ArcRmlUITest/UI/Rml/Test/Lucide/apple.svg" width="18" height="18" stroke-width="2"/><span class="count">7</span><span class="name">Item 1</span></div>
		<div class="slot q2"><svg src="/ArcRmlUITest/UI/Rml/Test/Lucide/hash.svg" width="18" height="18" stroke-width="2"/><span class="count">14</span><span class="name">Item 2</span></div>
		<div class="slot q0"><svg src="/ArcRmlUITest/UI/Rml/Test/Lucide/anchor.svg" width="18" height="18" stroke-width="2"/><span class="count">21</span><span class="name">Item 3</span></div>
		<div class="slot q1"><svg src="/ArcRmlUITest/UI/Rml/Test/Lucide/apple.svg" width="18" height="18" stroke-width="2"/><span class="count">28</span><span class="name">Item 4</span></div>
		<div class="slot q2"><svg src="/ArcRmlUITest/UI/Rml/Test/Lucide/hash.svg" width="18" height="18" stroke-width="2"/><span class="count">35</span><span class="name">Item 5</span></div>
		<div class="slot q0"><svg src="/ArcRmlUITest/UI/Rml/Test/Lucide/anchor.svg" width="18" height="18" stroke-width="2"/><span class="count">42</span><span class="name">Item 6</span></div>
		<div class="slot q1"><svg src="/ArcRmlUITest/UI/Rml/Test/Lucide/apple.svg" width="18" height="18" stroke-width="2"/><span class="count">49</span><span class="name">Item 7</span></div>
		<div class="slot q2"><svg src="/ArcRmlUITest/UI/Rml/Test/Lucide/hash.svg" width="18" height="18" stroke-width="2"/><span class="count">56</span><span class="name">Item 8</span></div>
		<div class="slot q0"><svg src="/ArcRmlUITest/UI/Rml/Test/Lucide/anchor.svg" width="18" height="18" stroke-width="2"/><span class="count">63</span><span class="name">Item 9</span></div>
		<div class="slot q1"><svg src="/ArcRmlUITest/UI/Rml/Test/Lucide/apple.svg" width="18" height="18" stroke-width="2"/><span class="count">70</span><span class="name">Item 10</span></div>
		<div class="slot q2"><svg src="/ArcRmlUITest/UI/Rml/Test/Lucide/hash.svg" width="18" height="18" stroke-width="2"/><span class="count">77</span><span class="name">Item 11</span></div>
	</div>
</body>
</rml>
