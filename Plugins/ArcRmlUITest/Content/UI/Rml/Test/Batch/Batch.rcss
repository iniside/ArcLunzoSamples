body {
	width: 100%;
	height: 100%;
}

div {
	display: block;
}

.r {
	position: absolute;
	width: 40px;
	height: 40px;
	background-color: #3366cc;
}

.a {
	background-color: #cc3333;
}

.grad {
	position: absolute;
	width: 40px;
	height: 40px;
	background: linear-gradient(to right, #ff0000, #0000ff);
}

.t {
	position: absolute;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 20px;
	color: #202020;
}

.clip {
	position: absolute;
	top: 200px;
	width: 100px;
	height: 50px;
	overflow: hidden;
}

.round {
	position: absolute;
	top: 200px;
	width: 140px;
	height: 60px;
	overflow: hidden;
	border-radius: 16px;
}

.moved {
	position: absolute;
	left: 0px;
	top: 200px;
	width: 600px;
	height: 60px;
	transform: translate(10px, 0px);
}

.rotated {
	position: absolute;
	left: 100px;
	top: 300px;
	width: 200px;
	height: 60px;
	transform: rotate(20deg);
}

.s {
	width: 140px;
	height: 20px;
	background-color: #3366cc;
}

.s.a {
	background-color: #cc3333;
}

.row {
	position: absolute;
	left: 20px;
	width: 200px;
	height: 24px;
	background-color: #3366cc;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
	color: #f0f0f0;
}

.row.a {
	background-color: #cc3333;
}

.box {
	position: absolute;
	top: 200px;
	width: 100px;
	height: 30px;
	overflow: hidden;
}

.big {
	font-size: 40px;
}

.icons {
	position: absolute;
	left: 20px;
	width: 240px;
	height: 28px;
	background-color: #3366cc;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
	color: #f0f0f0;
}

.icons.a {
	background-color: #cc3333;
}

.icons svg {
	color: #202020;
}

.icons img {
	width: 24px;
	height: 24px;
}
