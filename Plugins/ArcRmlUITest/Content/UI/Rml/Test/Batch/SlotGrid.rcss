body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 14px;
	color: #e8ecf4;
}

div {
	display: block;
}

.grid {
	position: absolute;
	left: 8px;
	top: 8px;
	width: 400px;
	display: grid;
	grid-template-columns: repeat(6, 24px);
	gap: 1px;
}

.slot {
	position: relative;
	width: 24px;
	height: 24px;
	background-color: #1a2030;
	border: 1px solid #2c3448;
	border-radius: 3px;
}

.slot svg {
	position: absolute;
	left: 3px;
	top: 3px;
	color: #c8d0e0;
}

.slot .count {
	position: absolute;
	right: 1px;
	bottom: 0px;
	font-size: 8px;
	font-family: 'JetBrains Mono', monospace;
}

.slot .name {
	position: absolute;
	left: 1px;
	top: 0px;
	font-size: 6px;
	white-space: nowrap;
	overflow: hidden;
	width: 22px;
}

.q0 { border-color: #5a6070; }
.q1 { border-color: #3c9a4c; }
.q2 { border-color: #3c6aca; }
