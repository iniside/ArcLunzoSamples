body {
	width: 100%;
	height: 100%;
}

div {
	display: block;
	position: absolute;
	width: 100px;
	height: 60px;
}

.t {
	font-family: 'Space Grotesk', sans-serif;
	font-size: 18px;
	color: #202020;
	width: 400px;
}

#solid { left: 20px; top: 20px; background-color: #3366cc; }
#half { left: 80px; top: 50px; background-color: #cc333380; }
body.alt #solid { background-color: #22aa55; }
#round { left: 220px; top: 20px; border-radius: 14px; overflow: hidden; background-color: #2244aa; }
#roundkid { left: 0px; top: 0px; width: 100%; height: 100%; background-color: #ffcc0099; }
#opacity { left: 360px; top: 20px; background-color: #8800cc; filter: opacity(0.5); }
#blur { left: 500px; top: 20px; background-color: #008866; filter: blur(4px); }
#drop { left: 640px; top: 20px; background-color: #ddaa00; filter: drop-shadow(6px 6px 4px #00000099); }
#mask { left: 780px; top: 20px; background-color: #aa2266; mask-image: linear-gradient(to right, #000000, #00000000); }
#shadow { left: 20px; top: 140px; background-color: #f0f0f0; box-shadow: 4px 6px 10px 2px #3366cc88; }
#grad { left: 160px; top: 140px; background: linear-gradient(to bottom, #ff000080, #0000ff20); }
#rot { left: 300px; top: 140px; background-color: #44aa44cc; transform: rotate(20deg); }
#text { left: 20px; top: 240px; }
#behind { left: 20px; top: 320px; width: 300px; height: 80px; background-color: #aa3300; }
#glass { left: 60px; top: 330px; width: 200px; height: 60px; border-radius: 12px; backdrop-filter: blur(6px); background-color: #ffffff33; }
#after { left: 120px; top: 350px; width: 60px; height: 20px; background-color: #0044ff; }
