<rml>
<head>
	<title>ArcRmlUI Mask Test</title>
	<meta name="layer" content="UI.Layer.Menu"/>
	<meta name="input-mode" content="game"/>
	<link type="text/rcss" href="MaskTest.rcss"/>
<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Fonts/Fonts.rcss"/></head>
<body>
	<div class="page">
		<div class="cell">
			<span class="label">add (left | top)</span>
			<div class="sample composite-add"></div>
		</div>
		<div class="cell">
			<span class="label">subtract (left - top)</span>
			<div class="sample composite-subtract"></div>
		</div>
		<div class="cell">
			<span class="label">intersect (left &amp; top)</span>
			<div class="sample composite-intersect"></div>
		</div>
		<div class="cell">
			<span class="label">exclude (left ^ top)</span>
			<div class="sample composite-exclude"></div>
		</div>
		<div class="cell">
			<span class="label">longhands: left &amp; (top ^ diagonal)</span>
			<div class="sample longhands"></div>
		</div>
		<div class="cell">
			<span class="label">intersect clipped to content-box</span>
			<div class="sample clip-bounded"></div>
		</div>
		<div class="cell">
			<span class="label">mask-clip content / padding</span>
			<div class="row">
				<div class="sample boxed clip-content"></div>
				<div class="sample boxed clip-padding"></div>
			</div>
		</div>
		<div class="cell">
			<span class="label">mask-origin content / border</span>
			<div class="row">
				<div class="sample boxed origin-content"></div>
				<div class="sample boxed origin-border"></div>
			</div>
		</div>
		<div class="cell">
			<span class="label">ring: exclude / -webkit xor</span>
			<div class="row">
				<div class="sample ring-exclude"></div>
				<div class="sample ring-webkit"></div>
			</div>
		</div>
		<div class="cell">
			<span class="label">style guide panel corners</span>
			<div class="panel">
				<div class="panel-title">Panel title</div>
			</div>
		</div>
		<div class="cell">
			<span class="label">single radial mask-image</span>
			<div class="sample radial"></div>
		</div>
	</div>
</body>
</rml>
