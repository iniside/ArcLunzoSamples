.cell {
	position: absolute;
	width: 100px;
	height: 60px;
}

#src-a {
	left: 40px;
	top: 40px;
	background-color: rgb(200, 40, 40);
	drag: clone;
}

#src-a:drag {
	background-color: rgb(20, 180, 220);
}

#src-untyped {
	left: 40px;
	top: 160px;
	background-color: rgb(200, 120, 40);
	drag: clone;
}

#src-untyped:drag {
	background-color: rgb(220, 20, 180);
}

#tgt-ok {
	left: 300px;
	top: 40px;
	background-color: rgb(40, 40, 200);
}

#tgt-no {
	left: 300px;
	top: 160px;
	background-color: rgb(40, 120, 200);
}

#zone {
	left: 600px;
	top: 40px;
	width: 200px;
	height: 200px;
}

#empty {
	width: 100%;
	height: 100%;
}

#loc-src {
	left: 40px;
	top: 300px;
	width: 400px;
	height: 40px;
	color: rgb(10, 230, 90);
	background-color: rgb(30, 30, 30);
	drag: clone;
}

#src-b {
	left: 40px;
	top: 420px;
	background-color: rgb(120, 200, 40);
	drag: drag-drop;
}
