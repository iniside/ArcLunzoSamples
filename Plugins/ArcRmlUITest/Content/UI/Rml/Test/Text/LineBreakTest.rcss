body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
	color: #e8ecf4;
}

div, p {
	display: block;
}

.chip {
	display: inline-block;
	font-family: 'JetBrains Mono';
	font-size: 9.5dp;
	letter-spacing: 0.4dp;
	padding: 2dp 6dp;
	background-color: #1e2330;
}

.chip-row {
	position: absolute;
	left: 40dp;
	top: 60dp;
	display: flex;
	flex-direction: row;
}

.chip-row .chip {
	display: block;
	flex: 0 0 auto;
}

.chip-abs {
	position: absolute;
	left: 40dp;
	top: 100dp;
	display: block;
}

.empty {
	position: absolute;
	left: 40px;
	top: 140px;
	width: 200px;
}

.row {
	position: absolute;
	left: 20px;
	top: 200px;
	width: 1800px;
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
}

.item {
	flex: 0 1 auto;
	width: auto;
	max-width: 440px;
	padding: 6px;
}

.ref {
	position: absolute;
	left: 600px;
	top: 200px;
	width: 440px;
	padding: 6px;
}

.t {
	font-size: 13px;
	line-height: 1.4;
	letter-spacing: 0.3px;
}

.probe {
	position: absolute;
	left: 20px;
	top: 600px;
	white-space: nowrap;
}

.probe-next {
	top: 640px;
}
