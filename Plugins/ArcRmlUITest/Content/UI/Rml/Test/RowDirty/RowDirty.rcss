body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 12px;
	color: #e8ecf4;
	background-color: #0b0e14;
}

div {
	display: block;
}

.row {
	display: flex;
	height: 16px;
	gap: 6px;
}

.box {
	display: block;
	flex-shrink: 0;
	width: 8px;
	height: 6px;
	background-color: #3c6aca;
}

.box.hot {
	background-color: #ca8a3c;
}
