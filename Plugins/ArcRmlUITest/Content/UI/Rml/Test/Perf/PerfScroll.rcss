body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 14px;
	color: #e8ecf4;
	background-color: #0b0e14;
}

div {
	display: block;
}

.title {
	position: absolute;
	left: 12px;
	top: 8px;
	font-size: 16px;
}

.scroller {
	position: absolute;
	left: 40px;
	top: 40px;
	width: 700px;
	bottom: 40px;
	overflow-y: scroll;
	scroll-behavior: smooth;
	background-color: #141821;
	border-radius: 8px;
}

.row {
	display: flex;
	align-items: center;
	height: 28px;
	gap: 8px;
	padding: 0px 8px;
	border-bottom: 1px solid #2c3448;
}

.r0 { background-color: #1a2030; }
.r1 { background-color: #182030; }
.r2 { decorator: linear-gradient(90deg, #1a2030, #24304a); }
.r3 { box-shadow: #00000060 0px 1px 2px 0px; }

.idx { width: 48px; color: #8890a0; font-family: 'JetBrains Mono', monospace; }
.name { flex: 1 1 auto; }
.row svg { color: #c8d0e0; }
