body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 14px;
	color: #e8ecf4;
	background-color: #0b0e14;
}

div {
	display: block;
}

.title {
	position: absolute;
	left: 12px;
	top: 8px;
	font-size: 16px;
}

.tree {
	position: absolute;
	top: 32px;
	width: 460px;
	height: 1000px;
	display: flex;
}

.t0 { left: 8px; }
.t1 { left: 480px; }
.t2 { left: 952px; }
.t3 { left: 1424px; }

.lvl {
	display: flex;
	flex: 1 1 auto;
	min-width: 0px;
	min-height: 0px;
	padding: 1px;
	gap: 1px;
	border: 1px solid #2c344880;
	align-items: stretch;
}

.row { flex-direction: row; }
.col { flex-direction: column; }

.tag {
	flex: 0 0 auto;
	font-size: 8px;
}

.side {
	flex: 0 1 auto;
	font-size: 7px;
	color: #8890a0;
}

.leaf {
	flex: 0 0 auto;
	width: 10px;
	height: 10px;
	background-color: #3c9a4c;
	animation: leafGrow 1s linear infinite alternate;
}

@keyframes leafGrow {
	from { width: 10px; }
	to { width: 60px; }
}
