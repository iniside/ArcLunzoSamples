body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 14px;
	color: #e8ecf4;
	background-color: #0b0e14;
}

div {
	display: block;
}

.title {
	position: absolute;
	left: 12px;
	top: 8px;
	font-size: 16px;
}

.wrap {
	position: absolute;
	left: 8px;
	top: 32px;
	right: 8px;
	bottom: 8px;
	overflow: hidden;
	display: flex;
	flex-wrap: wrap;
	gap: 12px;
	align-content: flex-start;
}

table {
	display: table;
	border-collapse: collapse;
	width: 360px;
	font-size: 9px;
}

thead {
	display: table-header-group;
	background-color: #24304a;
}

tbody {
	display: table-row-group;
}

tr {
	display: table-row;
}

td {
	display: table-cell;
	padding: 1px 3px;
	border: 1px solid #2c3448;
}

tbody tr:nth-child(even) {
	background-color: #1a2030;
}

.c0 { width: 30px; }
.c5 { text-align: right; }
