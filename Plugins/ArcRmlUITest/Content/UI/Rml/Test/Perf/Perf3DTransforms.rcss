body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 14px;
	color: #e8ecf4;
	background-color: #0b0e14;
}

div {
	display: block;
}

.title {
	position: absolute;
	left: 12px;
	top: 8px;
	font-size: 16px;
}

.grid3 {
	position: absolute;
	left: 8px;
	top: 40px;
	right: 8px;
	bottom: 8px;
	display: flex;
	flex-wrap: wrap;
	gap: 6px;
	align-content: flex-start;
}

.scene {
	width: 72px;
	height: 72px;
	perspective: 200px;
	perspective-origin: 50% 50%;
}

.card3 {
	width: 64px;
	height: 64px;
	margin: 4px;
	transform-style: preserve-3d;
	border-radius: 6px;
	background-color: #3c6aca;
	box-shadow: #00000080 0px 4px 8px 0px;
}

.face {
	text-align: center;
	line-height: 64px;
	font-size: 18px;
	transform: translateZ(10px);
}

.k0 { animation: rotY 2s linear infinite; }
.k1 { animation: rotX 2.6s linear infinite; background-color: #9a3cca; }
.k2 { animation: rot3 3.1s ease-in-out infinite alternate; background-color: #3c9a4c; }
.k3 { transform: rotateX(30deg) rotateY(45deg) translateZ(-20px); background-color: #ca8a3c; }

@keyframes rotY {
	from { transform: rotateY(0deg); }
	to { transform: rotateY(360deg); }
}

@keyframes rotX {
	from { transform: rotateX(0deg); }
	to { transform: rotateX(360deg); }
}

@keyframes rot3 {
	from { transform: rotate3d(1, 1, 0, 0deg) translateZ(0px); }
	to { transform: rotate3d(1, 1, 0, 80deg) translateZ(30px); }
}
