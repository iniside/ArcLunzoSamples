<rml>
<head>
<title>Select</title>
<meta name="layer" content="UI.Layer.Menu"/>
<meta name="input-mode" content="game"/>
<link type="text/rcss" href="ua-min.rcss"/>
<link type="text/rcss" href="tw-hyperui.rcss"/>
<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Fonts/Fonts.rcss"/></head>
<body class="mx-auto max-w-xs p-6">
    <label for="Headline">
      <span class="text-sm font-medium text-gray-700"> Headliner </span>

      <select name="Headline" id="Headline" class="mt-0.5 w-full rounded border-gray-300 shadow-sm sm:text-sm">
        <option value="">Please select</option>
        <option value="JM">John Mayer</option>
        <option value="SRV">Stevie Ray Vaughn</option>
        <option value="JH">Jimi Hendrix</option>
        <option value="BBK">B.B King</option>
        <option value="AK">Albert King</option>
        <option value="BG">Buddy Guy</option>
        <option value="EC">Eric Clapton</option>
      </select>
    </label>
  

</body>
</rml>
