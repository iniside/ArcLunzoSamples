<rml>
<head>
<title>Modal</title>
<meta name="layer" content="UI.Layer.Menu"/>
<meta name="input-mode" content="game"/>
<link type="text/rcss" href="ua-init.rcss"/>
<link type="text/rcss" href="tw-hyperui.rcss"/>
<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Fonts/Fonts.rcss"/></head>
<body class="p-6">
    <button data-modal-open="" class="rounded border border-gray-300 bg-gray-100 px-3 py-1.5 text-sm text-gray-900">
      Open
    </button>

    <dialog open="" closedby="any" aria-labelledby="modalTitle" aria-describedby="modalDescription" class="m-auto max-w-xl rounded-lg bg-white p-6 shadow-lg backdrop:bg-black/50">
      <div class="flex flex-col gap-4">
        <h2 id="modalTitle" class="text-xl font-bold text-gray-900 sm:text-2xl">Modal Title</h2>

        <p id="modalDescription" class="text-pretty text-gray-700">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Pellentesque euismod, nisi eu
          consectetur. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
        </p>
      </div>
    </dialog>

    
  

</body>
</rml>
