<rml>
<head>
	<title>ArcRmlUI Grid Test</title>
	<meta name="layer" content="UI.Layer.Menu"/>
	<meta name="input-mode" content="game"/>
	<link type="text/rcss" href="GridTest.rcss"/>
<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Fonts/Fonts.rcss"/></head>
<body>
	<div id="tab-panel" class="panel">
		<div class="tab-header"></div>
		<div class="grid-8">
			<div class="tile"><div class="h30"></div></div>
			<div class="tile"><div class="h50"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h40"></div></div>
			<div class="tile alt"><div class="h40"></div></div>
			<div class="tile alt"><div class="h40"></div></div>
			<div class="tile alt"><div class="h40"></div></div>
			<div class="tile alt"><div class="h40"></div></div>
			<div class="tile alt"><div class="h40"></div></div>
			<div class="tile alt"><div class="h40"></div></div>
			<div class="tile alt"><div class="h40"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
		</div>
	</div>

	<div id="six" class="panel grid-6">
		<div class="tile"><div class="h30"></div></div>
		<div class="tile"><div class="h30"></div></div>
		<div class="tile"><div class="h30"></div></div>
		<div class="tile"><div class="h30"></div></div>
		<div class="tile"><div class="h30"></div></div>
		<div class="tile"><div class="h30"></div></div>
		<div class="tile alt"><div class="h50"></div></div>
		<div class="tile alt"><div class="h30"></div></div>
	</div>

	<div id="fixed-46" class="panel grid-46">
		<div class="slot"></div>
		<div class="slot"></div>
		<div class="slot"></div>
		<div class="slot alt"></div>
		<div class="slot alt"></div>
		<div class="slot alt"></div>
	</div>

	<div id="thirds" class="panel grid-1fr">
		<div class="tile"><div class="w200 h30"></div></div>
		<div class="tile alt"><div class="h30"></div></div>
		<div class="tile"><div class="h30"></div></div>
	</div>

	<div id="pairs" class="panel grid-auto-2">
		<div class="label w60"></div>
		<div class="value w40"></div>
		<div class="label w90"></div>
		<div class="value w40"></div>
		<div class="label w60"></div>
		<div class="value w70"></div>
	</div>

	<div id="areas" class="panel grid-areas">
		<div class="area-header"></div>
		<div class="area-side"></div>
		<div class="area-main"></div>
		<div class="area-footer"></div>
	</div>

	<div id="fill" class="panel grid-fill">
		<div class="tile"><div class="h30"></div></div>
		<div class="tile"><div class="h30"></div></div>
		<div class="tile"><div class="h30"></div></div>
		<div class="tile"><div class="h30"></div></div>
		<div class="tile alt"><div class="h30"></div></div>
		<div class="tile alt"><div class="h30"></div></div>
		<div class="tile alt"><div class="h30"></div></div>
	</div>

	<div id="fit" class="panel grid-fit">
		<div class="tile"><div class="h30"></div></div>
		<div class="tile alt"><div class="h30"></div></div>
	</div>

	<div id="spans" class="panel grid-spans">
		<div class="tile span-2"></div>
		<div class="tile alt rows-1-3"></div>
		<div class="tile"></div>
		<div class="tile alt full-row"></div>
		<div class="tile area-4-2-5-4"></div>
	</div>

	<div id="dense" class="panel grid-dense">
		<div class="tile span-2"></div>
		<div class="tile alt span-3"></div>
		<div class="tile"></div>
		<div class="tile alt"></div>
	</div>

	<div id="named" class="panel grid-named">
		<div class="tile named-mid"></div>
		<div class="tile alt named-span"></div>
	</div>

	<div id="align" class="panel grid-align">
		<div class="dot"></div>
		<div class="dot"></div>
		<div class="dot stretch-self"></div>
		<div class="dot start-self"></div>
	</div>
	<div id="oof" class="panel oof-panel">
		<div class="oof-grid">
			<div class="tile"></div>
			<div class="tile alt"></div>
			<div class="tile alt"></div>
			<div class="tile"></div>
			<div class="oof-col2"></div>
			<div class="oof-row2"></div>
		</div>
	</div>

	<div id="col-flex" class="panel">
		<div class="tab-header"></div>
		<div class="grid-4">
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
		</div>
	</div>

	<div id="row-flex" class="panel">
		<div class="side"></div>
		<div class="grid-3-flex">
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
		</div>
	</div>

	<div id="block-scroll" class="panel">
		<div class="grid-4">
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
		</div>
	</div>
	<div id="oof-align" class="panel oof-align-panel">
		<div class="oof-align-grid">
			<div class="tile"></div>
			<div class="tile alt"></div>
			<div class="tile"></div>
			<div class="oof-box oof-center"></div>
			<div class="oof-box oof-end"></div>
			<div class="oof-box oof-align-end"></div>
		</div>
	</div>

	<div id="oof-static" class="panel oof-static-panel">
		<div class="oof-static-grid">
			<div class="oof-box oof-static-center-end"></div>
		</div>
	</div>

	<div id="scroll-styled" class="panel scroll-case">
		<div class="grid-4">
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
		</div>
	</div>

	<div id="scroll-min" class="panel scroll-case">
		<div class="grid-4">
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
		</div>
	</div>

	<div id="scroll-max" class="panel scroll-case">
		<div class="grid-4">
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
			<div class="tile"><div class="h30"></div></div>
			<div class="tile alt"><div class="h30"></div></div>
		</div>
	</div>
</body>
</rml>
