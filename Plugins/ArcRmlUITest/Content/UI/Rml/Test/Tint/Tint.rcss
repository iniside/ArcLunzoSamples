body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 24px;
	color: #ffffff;
}

div {
	display: block;
}

#box {
	width: 100px;
	height: 40px;
	margin-bottom: 20px;
	background-color: #ff0000;
	border: 4px solid #00ff00;
	outline: 3px solid #0000ff;
}

#txt {
	text-shadow: 2px 2px 0px currentcolor;
	-webkit-text-stroke-width: 1px;
}

body.alt #box {
	background-color: #00ffff;
	border-color: #ffff00;
	outline-color: #ff00ff;
}

body.alt #txt {
	color: #ff8000;
}

body.half #box {
	opacity: 0.5;
}

body.half #txt {
	opacity: 0.5;
}

body.clear #box {
	background-color: transparent;
}

body.clear #txt {
	color: transparent;
}
