body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 24px;
	color: #ffffff;
}

div {
	display: block;
}

.item {
	width: 60px;
	height: 20px;
	margin-bottom: 10px;
}

@keyframes bg {
	from { background-color: #ff0000; }
	to { background-color: #0000ff; }
}

@keyframes bd {
	from { border-color: #00ff00; }
	to { border-color: #0000ff; }
}

@keyframes op {
	from { opacity: 1; }
	to { opacity: 0; }
}

@keyframes tx {
	from { color: #ffffff; }
	to { color: #0000ff; }
}

#abg {
	animation: 4s linear bg;
}

#abd {
	border: 4px solid #00ff00;
	animation: 4s linear bd;
}

#aop {
	background-color: #ff0000;
	animation: 4s linear op;
}

#atx {
	animation: 4s linear tx;
}
