body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
	color: #e8ecf4;
}

div {
	display: block;
}

.awt-root {
	position: absolute;
	left: 60px;
	top: 100px;
	width: 400px;
	padding: 20px;
	background-color: #141821e8;
}

.awt-wrap {
	margin-top: 16px;
	min-height: 20px;
}

.awt-btn {
	tab-index: auto;
	nav: auto;
	width: 160px;
	height: 40px;
	margin-bottom: 8px;
	background-color: #1e2330;
}

.awt-hidden {
	visibility: hidden;
}
