<rml>
<head>
	<title>ScrollbarPort</title>
	<meta name="layer" content="UI.Layer.Menu"/>
	<meta name="input-mode" content="menu"/>
	<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Test/ChromeDiff/FlexBasics.rcss"/>
	<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Test/ChromeDiff/ScrollbarPort.rcss"/>
<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Fonts/Fonts.rcss"/></head>
<body>
	<div class="t" id="AG" style="overflow:auto;width:100px;height:40px"><div id="AG1" style="height:80px;background:blue"></div></div>
	<div class="t" id="AN" style="overflow:auto;width:100px;height:40px"><div id="AN1" style="height:20px;background:blue"></div></div>
	<div class="t" id="AP" style="overflow:auto;width:100px;max-height:40px;padding:5px"><div id="AP1" style="height:80px;background:blue"></div></div>
	<div class="t" id="AS" style="overflow:scroll;width:100px;height:40px"><div id="AS1" style="height:10px;background:blue"></div></div>
	<div class="t" id="AY" style="overflow-x:hidden;overflow-y:scroll;width:100px;height:40px"><div id="AY1" style="height:10px;background:blue"></div></div>
	<div class="t" id="SF" style="width:600px"><div id="SF0" style="display:inline-block;vertical-align:top"><div id="SF1" style="overflow:auto;height:40px"><div id="SF2" style="width:50px;height:80px;background:blue"></div></div></div></div>
	<div class="t" id="SS" style="width:600px"><div id="SS0" style="display:inline-block;vertical-align:top"><div id="SS1" style="overflow-x:hidden;overflow-y:scroll;height:40px"><div id="SS2" style="width:50px;height:20px;background:blue"></div></div></div></div>
	<div class="t" id="SA" style="position:relative;width:600px;height:50px"><div id="SA0" style="position:absolute;top:0;left:0"><div id="SA1" style="overflow:auto;height:40px"><div id="SA2" style="width:50px;height:80px;background:blue"></div></div></div></div>
	<div class="t" id="SM" style="width:600px"><div id="SM0" style="overflow:auto;width:max-content;height:40px"><div id="SM1" style="width:50px;height:80px;background:blue"></div></div></div>
	<div class="t" id="FI" style="display:flex;width:300px;height:60px"><div id="FI0" style="flex:1;overflow:auto"><div id="FI1" style="height:80px;background:blue"></div></div><div class="b" id="FI2"></div></div>
	<div class="t" id="FJ" style="display:flex;width:300px;height:60px"><div id="FJ0" style="flex:none;overflow:auto"><div id="FJ1" style="width:50px;height:80px;background:blue"></div></div><div class="b" id="FJ2"></div></div>
	<div class="t" id="FC" style="display:flex;flex-direction:column;width:300px;height:60px"><div id="FC0" style="flex:1 1 auto;min-height:0;overflow:auto"><div id="FC1" style="height:80px;background:blue"></div></div></div>
	<div class="t" id="FN" style="display:flex;flex-direction:column;width:400px;max-height:300px"><div id="FN0" style="height:20px;background:green"></div><div id="FN1" style="display:flex;flex-direction:column;min-height:0"><div id="FN2" style="overflow:auto"><div id="FN3" style="height:500px;background:blue"></div></div></div></div>
	<div class="t" id="GI" style="display:grid;width:300px;grid-template-columns:1fr 60px;grid-template-rows:60px"><div id="GI0" style="overflow:auto"><div id="GI1" style="height:80px;background:blue"></div></div><div class="b" id="GI2"></div></div>
	<div class="t" id="GJ" style="display:grid;grid-template-columns:auto 60px;grid-template-rows:60px"><div id="GJ0" style="overflow:auto"><div id="GJ1" style="width:50px;height:80px;background:blue"></div></div><div class="b" id="GJ2"></div></div>
	<div class="t" id="BA" style="overflow:auto;width:100px;height:100px"><div id="BA1" style="width:90px;height:200px;background:blue"></div><div id="BA2" style="height:10px;background:green"></div></div>
	<div class="t" id="BH" style="overflow:auto;width:100px;height:100px"><div id="BH1" style="width:150px;height:95px;background:blue"></div><div id="BH2" style="height:10px;background:green"></div></div>
	<div class="t" id="BP" style="overflow:auto;width:100px;height:100px"><div id="BP1" style="width:150px;height:50%;background:blue"></div></div>
</body>
</rml>
