	<div class="wf-case" id="w1"><div id="w1-p" style="width:100px;font-size:0;line-height:20px;padding-top:1px"><span class="wf-ib" style="width:70px"></span> <span class="wf-ib" style="width:40px"></span><div id="w1-f" class="wf-f"></div> <span class="wf-ib" style="width:10px"></span><div id="w1-c" style="margin-top:40px;height:10px"></div></div></div>
	<div class="wf-case" id="w2"><div id="w2-p" style="width:100px;font-size:0;line-height:20px;margin-top:30px"><span class="wf-ib" style="width:70px"></span> <span class="wf-ib" style="width:40px"></span><div id="w2-f" class="wf-f"></div> <span class="wf-ib" style="width:10px"></span><div id="w2-c" style="margin-top:40px;height:10px"></div></div></div>
	<div class="wf-case" id="w3"><div id="w3-p" style="width:100px;font-size:0;line-height:20px;margin-top:30px"><span class="wf-ib" style="width:70px"></span> <span class="wf-ib" style="width:60px"></span><div id="w3-f" class="wf-f"></div> <span class="wf-ib" style="width:10px"></span><div id="w3-c" style="margin-top:40px;height:10px"></div></div></div>
