<rml>
<head>
	<title>GridBasics</title>
	<meta name="layer" content="UI.Layer.Menu"/>
	<meta name="input-mode" content="menu"/>
	<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Test/ChromeDiff/GridBasics.rcss"/>
<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Fonts/Fonts.rcss"/></head>
<body>
	<div class="t" id="T" style="display:grid;width:400px;grid-template-columns:50px 1fr auto minmax(40px, 100px);column-gap:5px"><div id="T1" style="height:30px"></div><div id="T2"><div id="T2a" style="height:45px"></div></div><div id="T3"><div id="T3a" style="width:70px;height:10px"></div></div><div id="T4"><span class="i"></span><span class="i"></span><span class="i"></span></div></div>
	<div class="t" id="A" style="display:grid;width:300px;grid-template-columns:1fr 1fr;row-gap:4px"><div id="A1"><div id="A1a" style="height:40px"></div></div><div id="A2"><div id="A2a" style="height:70px"></div></div><div id="A3"><span class="i"></span><span class="i"></span><span class="i"></span><span class="i"></span></div><div id="A4" style="align-self:start"><div id="A4a" style="height:15px"></div></div></div>
	<div class="t" id="S" style="display:grid;width:300px;grid-template-columns:60px 60px 60px;grid-auto-rows:minmax(20px, auto)"><div id="S1" style="grid-column:span 2"><div id="S1a" style="height:30px"></div></div><div id="S2" style="grid-row:span 2"><div id="S2a" style="height:90px"></div></div><div id="S3"></div><div id="S4"><div id="S4a" style="height:25px"></div></div><div id="S5" style="grid-column:1 / 4"><span class="i"></span><span class="i"></span><span class="i"></span><span class="i"></span><span class="i"></span></div></div>
	<div class="t" id="J" style="display:grid;width:400px;grid-template-columns:200px 200px"><div id="J1" style="margin-left:auto"><span class="i"></span><span class="i"></span></div><div id="J2" style="max-width:60px"><span class="i"></span><span class="i"></span><span class="i"></span><span class="i"></span></div><div id="J3" style="margin-right:auto;max-width:90px"><span class="i"></span><span class="i"></span><span class="i"></span></div><div id="J4" style="justify-self:start;min-width:150px"><span class="i"></span></div><div id="J5" style="justify-self:end;max-width:50px"><span class="i"></span><span class="i"></span></div><div id="J6" style="width:300px;max-width:120px"><span class="i"></span><span class="i"></span><span class="i"></span><span class="i"></span></div></div>
	<div class="t" id="V" style="display:grid;width:300px;grid-template-columns:100px 100px 100px"><div id="V1" style="height:90px"></div><div id="V2" style="margin-top:auto"><div id="V2a" style="height:20px"></div></div><div id="V3" style="margin-top:auto;margin-bottom:auto;max-height:30px"><div id="V3a" style="height:50px"></div></div><div id="V4" style="min-height:120px"></div><div id="V5" style="max-height:40px"><div id="V5a" style="height:70px"></div></div><div id="V6" style="align-self:center"><div id="V6a" style="height:30px"></div></div></div>
	<div class="t" id="P" style="display:grid;width:300px;grid-template-columns:1fr 1fr;grid-template-rows:100px"><div id="P1" style="height:50%"></div><div id="P2"><div id="P2a" style="height:50%"></div></div></div>
	<div class="t" id="Q" style="display:grid;width:300px;height:120px;grid-template-columns:1fr 1fr;grid-template-rows:1fr 2fr;row-gap:10%"><div id="Q1"><div id="Q1a" style="height:50%"></div></div><div id="Q2" style="height:25%"></div><div id="Q3"></div></div>
	<div class="t" id="N" style="display:grid;width:300px;grid-template-columns:120px 1fr"><div id="N1" style="display:grid;grid-template-columns:1fr 1fr;column-gap:4px;padding:5px"><div id="N1a" style="height:20px"></div><div id="N1b"><div id="N1c" style="height:35px"></div></div><div id="N1d" style="grid-column:span 2;height:10px"></div></div><div id="N2" style="display:flex;flex-direction:column;padding:3px"><div id="N2a" style="height:20px"></div><div id="N2b" style="flex:1"></div><div id="N2c" style="width:30px;height:15px;align-self:flex-end"></div></div></div>
	<div class="t" id="F" style="display:flex;width:400px"><div id="F1" style="width:80px;height:60px"></div><div id="F2" style="display:grid;flex:1;grid-template-columns:repeat(3, 1fr);column-gap:6px"><div id="F2a"><div id="F2b" style="height:25px"></div></div><div id="F2c"><span class="i"></span><span class="i"></span><span class="i"></span></div><div id="F2d"></div></div><div id="F3" style="display:grid;align-self:flex-start;grid-template-columns:auto auto"><div id="F3a" style="width:30px;height:30px"></div><div id="F3b"><span class="i"></span></div></div></div>
	<div class="t" id="O" style="display:grid;width:300px;height:80px;grid-template-columns:1fr 100px"><div id="O1" style="overflow:scroll"><div id="O1a" style="width:400px;height:200px"></div></div><div id="O2"></div></div>
	<div class="t" id="X" style="display:grid;position:relative;width:200px;padding:10px;grid-template-columns:1fr 1fr"><div id="X1" style="height:80px"></div><div id="X5"><div id="X6" style="height:30px"></div><div id="X7" style="position:absolute;left:0;top:0;width:20px;height:100%"></div><div id="X8" style="position:absolute;left:30px;top:50%;width:20px;height:10px"></div><div id="X9" style="position:absolute;left:60px;top:0;bottom:0;width:20px"></div></div><div id="X2" style="position:absolute;left:0;top:0;width:20px;height:100%"></div><div id="X3" style="position:absolute;left:30px;top:50%;width:20px;height:10px"></div><div id="X4" style="position:absolute;left:60px;top:0;bottom:0;width:20px"></div></div>
	<div class="t" id="Y" style="display:grid;position:relative;width:200px;grid-template-columns:1fr 1fr"><div id="Y1" style="height:80px"></div><div id="Y5"><div id="Y6" style="height:30px"></div><div id="Y7" style="position:absolute;left:0;top:0;width:20px;height:100%"></div><div id="Y8" style="position:absolute;left:30px;top:50%;width:20px;height:10px"></div><div id="Y9" style="position:absolute;left:60px;top:0;bottom:0;width:20px"></div></div><div id="Y2" style="position:absolute;left:0;top:0;width:20px;height:100%"></div><div id="Y3" style="position:absolute;left:30px;top:50%;width:20px;height:10px"></div><div id="Y4" style="position:absolute;left:60px;top:0;bottom:0;width:20px"></div></div>
	<div class="t" id="R" style="display:grid;width:300px;height:100px;grid-template-columns:1fr 1fr"><div id="R1" style="position:relative;top:10%;left:10px;height:20px"></div><div id="R2" style="height:20px"></div></div>
	<div class="t" id="W" style="display:flex"><div id="W0" style="display:grid;width:100px;grid-template-rows:repeat(auto-fill, 50px)"><div id="W1" style="height:30px"></div><div id="W2" style="height:30px"></div><div id="W3" style="height:30px"></div></div></div>
	<div class="t" id="WH" style="display:flex;height:150px"><div id="WH0" style="display:grid;width:100px;grid-template-rows:repeat(auto-fill, 50px)"><div id="WH1" style="height:30px"></div><div id="WH2" style="height:30px"></div><div id="WH3" style="height:30px"></div></div></div>
	<div class="t" id="BL" style="display:grid;width:300px;grid-template-columns:100px 100px;align-items:baseline"><div id="BL1"><span class="i" style="vertical-align:baseline"></span><span class="i" style="vertical-align:baseline"></span><span class="i" style="vertical-align:baseline;height:60px"></span></div><div id="BL2"><span class="i" style="vertical-align:baseline"></span></div></div>
	<div class="t" id="RL" style="display:grid;width:300px;height:200px;grid-template-columns:100px 200px;grid-template-rows:50px 150px"><div id="RL1" style="height:20px"></div><div id="RL2" style="position:relative;top:50%;left:10%;height:20px"></div><div id="RL3" style="position:relative;bottom:50%;right:10%;height:20px"></div><div id="RL4"></div></div>
	<div class="t" id="MH" style="display:grid;width:200px;height:300px;grid-template-columns:100px 100px;grid-template-rows:100px"><div id="MH1" style="align-self:start;max-height:50%"><div id="MH1a" style="height:200px"></div></div><div id="MH2" style="max-height:50%"><div id="MH2a" style="height:200px"></div></div></div>
	<div class="t" id="BR" style="display:grid;width:300px;justify-content:start;grid-template-columns:auto 100px;grid-template-rows:minmax(0, 1fr) 100px"><div id="BR1" style="height:100%;aspect-ratio:1"></div><div id="BR2" style="height:150px"></div><div id="BR3" style="align-self:baseline"><div id="BR3a" style="aspect-ratio:2"></div><span class="i" style="vertical-align:baseline"></span></div><div id="BR4" style="align-self:baseline"><span class="i" style="vertical-align:baseline"></span></div></div>
	<div class="t" id="RF" style="display:flex;width:300px;height:100px;padding:10px"><div id="RF1" style="position:relative;top:50%;left:10%;width:50px;height:20px"></div></div>
	<div class="t" id="AG" style="display:grid;width:300px;grid-template-columns:100px 100px"><div id="AG1"><div id="AG1a" style="width:64px;aspect-ratio:1;margin:auto 0;background:blue"></div></div><div id="AG2" style="height:150px"></div><div id="AG3" style="width:64px;aspect-ratio:1;margin:auto 0"></div><div id="AG4" style="height:150px"></div></div>
	<div class="t" id="AF" style="display:flex;width:300px"><div id="AF1" style="width:100px"><div id="AF1a" style="width:64px;aspect-ratio:1;margin:auto 0;background:blue"></div></div><div id="AF2" style="width:50px;height:150px"></div><div id="AF3" style="width:64px;aspect-ratio:1;margin:auto 0"></div></div>
	<div class="t" id="AT" style="display:grid;width:300px;grid-template-columns:150px 150px"><div id="AT1"><div id="AT1a" style="display:table;margin:auto"><div id="AT1b" style="display:table-cell;width:40px;height:20px;background:blue"></div></div></div><div id="AT2" style="height:150px"></div></div>
	<div class="t" id="AU" style="display:flex;width:300px"><div id="AU1" style="width:150px"><div id="AU1a" style="display:table;margin:auto"><div id="AU1b" style="display:table-cell;width:40px;height:20px;background:blue"></div></div></div><div id="AU2" style="width:50px;height:150px"></div><div id="AU3" style="display:table;margin:auto"><div id="AU3a" style="display:table-cell;width:40px;height:20px"></div></div></div>
</body>
</rml>
