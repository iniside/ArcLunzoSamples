<rml>
<head>
	<title>AbsoluteBasics</title>
	<meta name="layer" content="UI.Layer.Menu"/>
	<meta name="input-mode" content="menu"/>
	<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Test/ChromeDiff/AbsoluteBasics.rcss"/>
<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Fonts/Fonts.rcss"/></head>
<body>
	<div class="t" id="BA" style="position:relative;width:200px;padding:10px;border:2px solid black"><div id="BA0" style="height:50px"></div><div class="a" id="BA1" style="position:absolute;top:0;right:0;bottom:0;left:0"></div><div class="a" id="BA2" style="position:absolute;top:0;right:0;width:20px;height:20px"></div><div class="a" id="BA3" style="position:absolute;bottom:0;left:0;width:30px;height:50%"></div><div class="a" id="BA4" style="position:absolute;top:50%;left:50%;width:10px;height:10px;margin-left:-5px;margin-top:-5px"></div><div class="a" id="BA5" style="position:absolute;left:0;right:0;bottom:0;height:4px"></div></div>
	<div class="t" id="BS" style="position:relative;width:200px"><div id="BS0" style="height:20px"></div><div class="a" id="BS1" style="position:absolute;width:10px;height:10px"></div><div id="BS2" style="height:30px"></div><div class="a" id="BS3" style="position:absolute;left:50px;width:10px;height:10px"></div><div class="a" id="BS4" style="position:absolute;top:5px;width:10px;height:10px;margin:3px"></div></div>
	<div class="t" id="BN" style="position:relative;width:200px;padding:5px"><div id="BN1" style="padding:10px;margin-left:20px"><div id="BN2" style="height:15px"></div><div class="a" id="BN3" style="position:absolute;width:10px;height:10px"></div><div class="a" id="BN4" style="position:absolute;right:0;bottom:0;width:10px;height:10px"></div></div></div>
	<div class="t" id="BB" style="position:relative;width:200px;height:60px"><div id="BB1" style="position:absolute;top:5px;left:5px;width:100px"><div id="BB2" style="height:40px"></div><div class="a" id="BB3" style="position:absolute;right:0;bottom:0;width:10px;height:10px"></div><div class="a" id="BB4" style="position:absolute;top:0;left:0;width:20px;height:50%"></div></div></div>
	<div class="t" id="BW" style="position:relative;width:200px;height:40px"><div class="a" id="BW1" style="position:absolute;right:10px;top:0"><div id="BW2" style="width:30px;height:10px"></div></div><div class="a" id="BW3" style="position:absolute;left:10px;right:10px;top:15px;height:10px"></div></div>
	<div class="t" id="MC" style="position:relative;width:200px;height:100px"><div class="a" id="MC1" style="position:absolute;top:0;right:0;bottom:0;left:0;margin:auto;width:40px;height:20px"></div></div>
	<div class="t" id="DD" style="position:relative;width:100px;height:30px;margin-bottom:60px"><div class="a" id="DD1" style="position:absolute;left:0;right:0;top:100%;height:40px"></div></div>
	<div class="t" id="BG" style="width:200px;height:40px"><div id="BG1" style="position:relative;display:inline-block;width:40px;height:30px"><div class="a" id="BG2" style="position:absolute;top:-4px;right:-4px;width:10px;height:10px"></div></div></div>
	<div class="t" id="FR" style="display:flex;position:relative;width:200px;padding:5px"><div id="FR1" style="width:50px;height:60px"></div><div id="FR2" style="width:50px;height:40px"></div><div class="a" id="FR3" style="position:absolute;top:0;right:0;bottom:0;left:0"></div><div class="a" id="FR4" style="position:absolute;bottom:0;right:0;width:10px;height:25%"></div></div>
	<div class="t" id="FO" style="display:flex;width:200px"><div id="FO1" style="position:relative;flex:1"><div id="FO2" style="height:30px"></div><div class="a" id="FO3" style="position:absolute;top:0;right:0;bottom:0;left:0"></div><div class="a" id="FO5" style="position:absolute;right:0;bottom:0;width:10px;height:50%"></div></div><div id="FO4" style="width:40px;height:70px"></div></div>
	<div class="t" id="FC" style="display:flex;flex-direction:column;position:relative;width:200px"><div id="FC1" style="height:30px"></div><div class="a" id="FC2" style="position:absolute;left:0;bottom:0;width:20px;height:50%"></div><div id="FC3" style="position:relative;height:20px"><div class="a" id="FC4" style="position:absolute;right:0;top:0;bottom:0;width:10px"></div></div></div>
	<div class="t" id="GO" style="display:grid;grid-template-columns:1fr 1fr;width:200px"><div id="GO1" style="position:relative"><div class="a" id="GO3" style="position:absolute;left:0;right:0;bottom:0;height:5px"></div></div><div id="GO2" style="height:50px"></div></div>
	<div class="t" id="AM" style="position:relative;width:200px;height:100px"><div id="AM0" style="height:10px"></div><div class="a" id="AM1" style="position:absolute;top:0;left:0;width:20px;height:40px;margin:auto 0"></div><div class="a" id="AM2" style="position:absolute;left:30px;width:20px;height:40px;margin:auto 0"></div><div class="a" id="AM3" style="position:absolute;bottom:0;left:60px;width:20px;height:40px;margin:auto 0"></div><div class="a" id="AM4" style="position:absolute;top:0;bottom:0;left:90px;width:20px;height:40px;margin:auto 0"></div><div class="a" id="AM5" style="position:absolute;top:0;right:0;bottom:0;left:0;width:40px;height:20px;margin:auto"></div></div>
	<div class="t" id="AH" style="position:relative;width:200px;height:100px"><div class="a" id="AH1" style="position:absolute;top:0;left:10px;width:40px;height:10px;margin:0 auto"></div><div class="a" id="AH2" style="position:absolute;top:20px;right:10px;width:40px;height:10px;margin:0 auto"></div><div class="a" id="AH3" style="position:absolute;top:40px;left:0;right:0;width:40px;height:10px;margin:0 auto"></div><div class="a" id="AH4" style="position:absolute;top:60px;width:40px;height:10px;margin:0 auto"></div></div>
</body>
</rml>
