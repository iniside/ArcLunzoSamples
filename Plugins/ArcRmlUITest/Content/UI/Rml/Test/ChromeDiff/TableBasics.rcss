body {
	margin: 0;
	font-size: 0;
	line-height: 0;
}

.t {
	margin-bottom: 10px;
	background: #ddd;
}

.i {
	display: inline-block;
	vertical-align: top;
	width: 40px;
	height: 20px;
	background: green;
}

.w {
	display: inline-block;
	vertical-align: top;
	width: 70px;
	height: 10px;
	background: blue;
}

td {
	background: #bbb;
}
