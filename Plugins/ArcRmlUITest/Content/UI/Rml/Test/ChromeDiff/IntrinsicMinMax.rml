<rml>
<head>
	<title>IntrinsicMinMax</title>
	<meta name="layer" content="UI.Layer.Menu"/>
	<meta name="input-mode" content="menu"/>
	<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Test/ChromeDiff/IntrinsicBasics.rcss"/>
<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Fonts/Fonts.rcss"/></head>
<body>
	<div class="t" id="MP" style="width:600px"><div id="MP0" style="display:inline-block;vertical-align:top"><span style="padding:0 10%"><span class="i"></span><span class="i"></span></span></div></div>
	<div class="t" id="MX" style="width:600px"><div id="MX0" style="display:inline-block;vertical-align:top"><div id="MX1" style="max-width:90px"><span class="i"></span><span class="i"></span><span class="i"></span></div></div></div>
	<div class="t" id="MF" style="width:min-content"><div class="i" id="MF0" style="float:left"></div><span class="i" id="MF1"></span></div>
	<div class="t" id="MB" style="width:600px"><div id="MB0" style="display:inline-block;vertical-align:top"><div class="i" id="MB1" style="float:left"></div><div id="MB2"><span class="i" style="width:60px"></span></div></div></div>
	<div class="t" id="MA" style="width:600px"><div id="MA0" style="display:inline-block;vertical-align:top"><div id="MA1" style="aspect-ratio:2;height:10px;background:blue"></div></div></div>
	<div class="t" id="MR" style="width:600px"><div id="MR0" style="display:inline-block;vertical-align:top"><span class="i" id="MR1"></span><br/><span class="i" id="MR2" style="width:70px"></span></div></div>
	<div class="t" id="MI" style="width:600px"><div id="MI0" style="display:inline-block;vertical-align:top"><span><span class="i"></span><div id="MI2" style="width:90px;height:10px;background:blue"></div><span class="i"></span></span></div></div>
	<div class="t" id="MC" style="width:600px"><div id="MC0" style="display:inline-block;vertical-align:top"><div style="display:contents"><span class="i"></span><span class="i"></span></div></div></div>
	<div class="t" id="MG" style="width:600px"><div id="MG0" style="display:inline-block;vertical-align:top"><img id="MG1" src="../AtRulesSprites.png" style="width:30%;vertical-align:top"/><span class="i"></span></div></div>
	<div class="t" id="MH" style="width:min-content"><img id="MH1" src="../AtRulesSprites.png" style="width:30%;vertical-align:top"/><span class="i"></span></div>
	<div class="t" id="MK" style="width:600px"><div id="MK0" style="display:inline-block;vertical-align:top"><img id="MK1" src="asset:/Engine/EngineResources/AICON-Green.AICON-Green" style="width:30%;height:12px;vertical-align:top"/><span class="i"></span></div></div>
	<div class="t" id="MQ" style="width:600px"><div id="MQ0" style="display:inline-block;vertical-align:top"><span style="padding:0 calc(10px + 5%)"><span class="i"></span></span></div></div>
	<div class="t" id="CR" style="width:600px"><div id="CR0" style="display:inline-block;vertical-align:top"><div id="CR1" style="display:flex;column-gap:4px"><div class="i" id="CR2"></div><div class="i" id="CR3" style="width:60px"></div></div></div></div>
	<div class="t" id="CW" style="position:relative;width:600px;height:50px"><div id="CW0" style="position:absolute;top:0;left:0"><div id="CW1" style="display:flex;flex-wrap:wrap;column-gap:4px"><div class="i" id="CW2"></div><div class="i" id="CW3" style="width:60px"></div></div></div></div>
	<div class="t" id="CS" style="width:120px"><div id="CS0" style="display:inline-block;vertical-align:top"><div id="CS1" style="display:flex"><div class="i" id="CS2" style="flex:0 1 30px"></div><div class="i" id="CS3"></div></div></div></div>
	<div class="t" id="CC" style="width:600px"><div id="CC0" style="width:max-content"><div id="CC1" style="display:flex;flex-direction:column"><div class="i" id="CC2"></div><div class="i" id="CC3" style="width:70px"></div></div></div></div>
	<div class="t" id="CG" style="display:flex;width:600px"><div id="CG0"><div id="CG1" style="display:grid;grid-template-columns:auto auto;column-gap:5px"><div class="i" id="CG2"></div><div class="i" id="CG3" style="width:50px"></div></div></div><div id="CG4" style="flex:1;height:10px"></div></div>
	<div class="t" id="CT" style="display:grid;grid-template-columns:auto 1fr;width:600px"><table id="CT0"><tr><td id="CT1"><span class="i"></span></td><td id="CT2"><span class="i" style="width:50px"></span></td></tr></table><div id="CT3" style="height:10px"></div></div>
	<div class="t" id="CB" style="width:600px"><div id="CB0" style="display:inline-block;vertical-align:top"><table id="CB1" style="border-collapse:collapse;border:4px solid black"><tr><td id="CB2" style="border:2px solid red;padding:0"><span class="i"></span><span class="i"></span></td></tr></table></div></div>
	<div class="t" id="CN" style="width:30px"><div id="CN0" style="display:inline-block;vertical-align:top"><table id="CN1"><tr><td id="CN2"><span class="i"></span><span class="i"></span></td><td id="CN3"><span class="i"></span></td></tr></table></div></div>
	<div class="t" id="AM" style="display:flex;width:50px"><div id="AM0" style="width:100px"><div class="i" id="AM1" style="width:80px"></div></div></div>
	<div class="t" id="MW" style="width:600px"><div id="MW0" style="display:inline-block;vertical-align:top"><div id="MW1" style="width:max-content;aspect-ratio:2;height:10px;background:blue"></div></div></div>
	<div class="t" id="FW" style="display:flex;width:600px"><div id="FW0" style="width:fit-content"><div id="FW1" style="display:flex;flex-direction:column"><div class="i" id="FW2" style="width:90px"></div></div></div></div>
	<div class="t" id="CX" style="display:flex;flex-direction:column;align-items:flex-start;width:600px"><div id="CX1" style="max-width:100px"><span class="i"></span><span class="i"></span><span class="i"></span></div><div id="CX2" style="min-width:150px"><span class="i"></span></div></div>
	<div class="t" id="CV" style="width:600px"><div id="CV0" style="width:fit-content"><div id="CV1" style="display:flex;flex-direction:column;flex-wrap:wrap;height:96px"><div id="CV2" style="width:50px;height:40px;background:blue"></div><div id="CV3" style="width:50px;height:40px;background:green"></div><div id="CV4" style="width:50px;height:40px;background:blue"></div><div id="CV5" style="width:50px;height:40px;background:green"></div></div></div></div>
	<div class="t" id="TF" style="width:600px"><div id="TF0" style="display:inline-block;vertical-align:top"><div id="TF1" style="display:flex"><div id="TF2"><table id="TF3"><tr><th id="TF4" style="width:50%"><span class="i"></span></th><td id="TF5"><span class="i"></span></td></tr></table></div></div></div></div>
	<div class="t" id="TP" style="position:relative;width:600px;height:50px"><div id="TP0" style="position:absolute;top:0;left:0"><table id="TP1"><tr><td id="TP2"><span class="i"></span></td><td id="TP3"><span class="i"></span></td></tr><tr><td style="width:25%"><span class="i"></span></td><td></td></tr></table></div></div>
	<div class="t" id="TC" style="position:relative;width:600px;height:30px"><div id="TC0" style="position:absolute;top:0;left:0"><table id="TC1"><tr><td id="TC2" style="width:80%"><span class="i"></span></td><td id="TC3" style="width:60%"><span class="i"></span></td></tr></table></div></div>
	<div class="t" id="TA" style="width:600px"><table id="TA0"><tr><td id="TA1" style="width:25%"><span class="i"></span></td><td id="TA2"><span class="i"></span></td></tr></table></div>
	<div class="t" id="TB" style="width:600px"><table id="TB0"><tr><td id="TB1"><span class="i"></span></td><td id="TB2"><span class="i"></span></td></tr><tr><td style="width:25%"><span class="i"></span></td><td></td></tr></table></div>
	<div class="t" id="TL" style="width:600px"><table id="TL0"><col style="width:25%"/><tr><td id="TL1"><span class="i"></span></td><td id="TL2"><span class="i"></span></td></tr></table></div>
	<div class="t" id="TK" style="width:600px"><table id="TK0"><tr><td id="TK1" colspan="2" style="width:50%"><span class="i"></span></td><td id="TK2"><span class="i"></span></td></tr><tr><td id="TK3"><span class="i"></span></td><td id="TK4"><span class="i"></span></td><td id="TK5"><span class="i"></span></td></tr></table></div>
	<div class="t" id="TS" style="position:relative;width:600px;height:50px"><div id="TS0" style="position:absolute;top:0;left:0"><table id="TS1"><tr><td id="TS2" style="width:20%"><span class="i"></span></td><td id="TS3"><span class="i"></span></td><td id="TS4"><span class="i"></span></td></tr><tr><td colspan="3" style="width:90%"><span class="i"></span></td></tr></table></div></div>
	<div class="t" id="FV" style="width:600px"><div id="FV0" style="width:fit-content"><div id="FV1" style="display:flex;flex-direction:column;flex-wrap:wrap;height:96px"><div id="FV2" style="flex:1 1 0%;width:50px"><div style="height:40px"></div></div><div id="FV3" style="flex:1 1 0%;width:50px"><div style="height:40px"></div></div><div id="FV4" style="flex:1 1 0%;width:50px"><div style="height:40px"></div></div></div></div></div>
	<div class="t" id="FB" style="width:600px"><div id="FB0" style="width:fit-content"><div id="FB1" style="display:flex;flex-direction:column;flex-wrap:wrap;height:96px"><div id="FB2" style="flex-basis:80px;max-height:40px;width:50px;background:blue"></div><div id="FB3" style="flex-basis:80px;max-height:40px;width:50px;background:green"></div><div id="FB4" style="flex-basis:80px;max-height:40px;width:50px;background:blue"></div></div></div></div>
</body>
</rml>
