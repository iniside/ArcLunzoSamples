<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Fonts/Fonts.rcss"/></head>
<body>
	<div class="t" id="S" style="display:flex;width:300px;height:100px"><div id="S1" style="width:50px"></div><div id="S2" style="width:50px;height:30px"></div><div id="S3" style="width:50px;height:20px;align-self:center"></div><div id="S4" style="flex:1;margin:10px"><div id="S4a" style="height:50%"></div></div></div>
	<div class="t" id="R" style="display:flex;width:300px"><div id="R1" style="width:100px"><div id="R1a" style="height:40px"></div></div><div id="R2" style="flex:1"><div id="R2a" style="height:70px"></div></div></div>
	<div class="t" id="W" style="display:flex;flex-wrap:wrap;width:200px;row-gap:10px;column-gap:5px"><div class="b" id="W1"></div><div class="b" id="W2"></div><div class="b" id="W3"></div><div class="b" id="W4"></div><div class="b" id="W5"></div></div>
	<div class="t" id="L" style="display:flex;flex-wrap:wrap;width:200px;height:100px"><div id="L1" style="width:120px"></div><div id="L2" style="width:120px;height:30px"></div></div>
	<div class="t" id="C" style="display:flex;flex-direction:column;width:200px;height:200px"><div id="C1" style="height:25%"></div><div id="C2" style="height:50%;width:50%"></div><div id="C3" style="flex:1"><div id="C3a" style="height:50%"></div></div></div>
	<div class="t" id="N" style="display:flex;width:300px"><div id="N1" style="width:40px;height:60px"></div><div id="N2" style="display:flex;flex-direction:column;flex:1;padding:5px"><div id="N2a" style="height:20px"></div><div id="N2b" style="width:30px;height:15px;align-self:flex-end"></div></div></div>
	<div class="t" id="H" style="display:flex;width:300px;align-items:flex-start"><div id="H1" style="width:100px"><div id="H1a" style="height:35px"></div><div id="H1b" style="height:15px"></div></div><div id="H2" style="flex:1"><div id="H2a" style="display:flex;flex-wrap:wrap"><div class="b" id="H2b"></div><div class="b"></div><div class="b"></div><div class="b" id="H2c"></div></div></div></div>
	<div class="t" id="O" style="display:flex;width:300px;height:80px"><div id="O1" style="overflow:scroll;flex:1"><div id="O1a" style="width:400px;height:200px"></div></div><div id="O2" style="width:100px"></div></div>
	<div class="t" id="P" style="display:flex;width:300px;height:100px"><div id="P1" style="width:50px;height:20px;position:relative;top:10%;left:10px"></div><div id="P2" style="width:50px;height:20px"></div></div>
	<div class="t" id="A" style="display:flex;width:300px;height:60px;position:relative;justify-content:center;align-items:center"><div id="A1" style="position:absolute;width:40px;height:20px"></div><div id="A2" style="width:50px;height:10px"></div></div>
	<div class="t" id="X" style="display:flex;position:relative;width:200px;padding:10px"><div id="X1" style="width:50px;height:80px"></div><div id="X2" style="position:absolute;left:0;top:0;width:20px;height:100%"></div><div id="X3" style="position:absolute;left:30px;top:50%;width:20px;height:10px"></div><div id="X4" style="position:absolute;left:60px;top:0;bottom:0;width:20px"></div></div>
	<div class="t" id="Y" style="display:flex;position:relative;width:200px"><div id="Y1" style="width:50px;height:80px"></div><div id="Y2" style="position:absolute;left:0;top:0;width:20px;height:100%"></div><div id="Y3" style="position:absolute;left:30px;top:50%;width:20px;height:10px"></div><div id="Y4" style="position:absolute;left:60px;top:0;bottom:0;width:20px"></div></div>
	<div class="t" id="Z" style="display:flex;flex-direction:column;position:relative;width:200px;padding:10px"><div id="Z1" style="width:50px;height:80px"></div><div id="Z2" style="position:absolute;left:0;top:0;width:20px;height:100%"></div><div id="Z3" style="position:absolute;left:30px;top:50%;width:20px;height:10px"></div><div id="Z4" style="position:absolute;left:60px;top:0;bottom:0;width:20px"></div></div>
	<div class="t" id="V" style="display:flex;width:200px"><div id="V1" style="width:50px;height:80px"></div><div id="V5" style="position:relative;width:100px"><div id="V2" style="position:absolute;left:0;top:0;width:20px;height:100%"></div><div id="V3" style="position:absolute;left:30px;top:50%;width:20px;height:10px"></div><div id="V4" style="position:absolute;left:60px;top:0;bottom:0;width:20px"></div></div></div>
	<div class="t" id="U" style="display:flex;width:200px"><div id="U1" style="width:50px;height:80px"></div><div id="U5" style="position:relative;width:100px;align-self:flex-start"><div id="U6" style="height:30px"></div><div id="U2" style="position:absolute;left:0;top:0;width:20px;height:100%"></div><div id="U3" style="position:absolute;left:30px;top:50%;width:20px;height:10px"></div><div id="U4" style="position:absolute;left:60px;top:0;bottom:0;width:20px"></div></div></div>
	<div class="t" id="FA" style="display:flex;width:300px;height:100px;align-items:flex-start"><div id="FA1" style="width:100px"><div id="FA1a" style="position:relative;top:50%;height:10px"></div><div style="height:40px"></div></div></div>
	<div class="t" id="FB" style="display:flex;width:300px"><div id="FB1" style="width:100px"><div id="FB1a" style="position:relative;top:50%;height:10px"></div><div style="height:40px"></div></div><div style="width:10px;height:100px"></div></div>
	<div class="t" id="FD" style="display:flex;flex-direction:column;width:300px;height:200px"><div id="FD1" style="flex:1"><div id="FD1a" style="position:relative;top:50%;height:10px"></div></div></div>
	<div class="t" id="SB" style="width:300px;overflow-y:scroll"><div id="SB1" style="position:relative;left:50%;width:10px;height:10px"></div></div>
	<div class="t" style="display:flex;width:300px;height:200px;align-items:flex-start"><div id="NF1" style="display:flex;flex-direction:column;width:100px"><div class="c" id="NF1a" style="height:50%"></div><div class="c" id="NF1b" style="height:40px"></div></div></div>
	<div class="t" style="display:flex;width:300px;height:200px;align-items:flex-start"><div id="NF2" style="display:flex;width:100px"><div class="c" id="NF2a"><div class="c" id="NF2c" style="height:50%"></div></div><div class="c" id="NF2b" style="height:40px"></div></div></div>
	<div class="t" style="display:flex;width:300px;height:200px;align-items:flex-start"><div id="NF3" style="display:flex;width:100px"><div class="c" id="NF3a" style="height:50%"></div><div class="c" id="NF3b" style="height:40px"></div></div></div>
	<div class="t" style="display:flex;width:300px;height:200px;align-items:flex-start"><div id="NG1" style="display:grid;grid-template-columns:30px 30px;width:100px"><div class="c" id="NG1a" style="height:50%"></div><div class="c" id="NG1b" style="height:40px"></div></div></div>
	<div class="t" style="display:flex;width:300px;height:200px;align-items:flex-start"><div id="NG2" style="display:grid;grid-template-rows:50% 20px;width:100px"><div class="c" id="NG2a"></div><div class="c" id="NG2b" style="height:40px"></div></div></div>
	<div class="t" style="display:flex;width:300px;height:200px;align-items:flex-start"><table id="NT1" style="border-spacing:0"><tbody><tr id="NT1r" style="height:50%"><td style="padding:0"><div class="c" style="height:20px"></div></td></tr><tr><td style="padding:0"><div class="c" id="NT1a" style="height:30px"></div></td></tr></tbody></table></div>
	<div class="t" style="display:flex;flex-direction:column;width:300px;min-height:200px"><div id="NC1" style="display:flex;flex-direction:column;width:100px"><div class="c" id="NC1a" style="height:50%"></div><div class="c" id="NC1b" style="height:40px"></div></div></div>
	<div class="t" style="display:flex;width:300px;height:200px"><div id="NS1" style="display:flex;flex-direction:column;width:100px"><div class="c" id="NS1a" style="height:50%"></div><div class="c" id="NS1b" style="height:40px"></div></div></div>
	<div class="t"><table style="border-spacing:0"><tbody><tr><td id="NE1" style="padding:0"><div id="NE1f" style="display:flex;flex-direction:column;height:100%;width:100px"><div class="c" id="NE1a" style="height:50%"></div><div class="c" id="NE1b" style="height:40px"></div></div></td><td style="padding:0"><div class="c" style="height:120px"></div></td></tr></tbody></table></div>
	<div class="t"><table style="border-spacing:0"><tbody><tr><td id="NE2" style="padding:0"><div id="NE2g" style="display:grid;grid-template-rows:50% auto;width:100px"><div class="c" id="NE2a"></div><div class="c" id="NE2b" style="height:40px"></div></div></td><td style="padding:0"><div class="c" style="height:120px"></div></td></tr></tbody></table></div>
	<div class="t" style="display:grid;width:300px;height:200px;align-items:start"><div id="GI1" style="display:flex;flex-direction:column;width:100px"><div class="c" id="GI1a" style="height:50%"></div><div class="c" id="GI1b" style="height:40px"></div></div></div>
	<div class="t" style="display:flex;width:300px;height:200px;align-items:flex-start"><div id="NF4" style="display:flex;flex-direction:column;width:100px;min-height:100px"><div class="c" id="NF4a" style="height:50%"></div><div class="c" id="NF4b" style="flex:1"></div></div></div>
	<div class="t" style="display:flex;flex-direction:column;width:100px"><table id="TF1" style="flex-basis:100px;border-spacing:0"><tbody><tr id="TF1r"><td style="padding:0"><div style="height:10px;width:20px"></div></td></tr></tbody></table></div>
	<div class="t" style="display:flex;flex-direction:column;width:100px;min-height:200px"><table id="TF2" style="flex:1;border-spacing:0"><tbody><tr id="TF2r"><td style="padding:0"><div style="height:10px;width:20px"></div></td></tr></tbody></table></div>
	<div class="t" style="display:flex;flex-direction:column;width:100px"><div id="DB1" style="flex-basis:100px"><div id="DB1c" style="height:50%;width:5px"></div></div></div>
	<div class="t" style="display:flex;flex-direction:column;width:100px"><div id="DB2" style="flex:0 0 100px"><div id="DB2c" style="height:50%;width:5px"></div></div></div>
	<div class="t" style="display:flex;flex-direction:column;width:100px;min-height:200px"><div id="DG1" style="flex:1"><div id="DG1c" style="height:50%;width:5px"></div></div></div>
	<div class="t" style="display:flex;flex-direction:column;width:100px"><div id="DG2" style="flex-basis:50%"><div style="height:10px;width:5px"></div><div id="DG2c" style="height:50%;width:5px"></div></div></div>
</body>
