<rml>
<head>
	<title>GridPort</title>
	<meta name="layer" content="UI.Layer.Menu"/>
	<meta name="input-mode" content="menu"/>
	<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Test/ChromeDiff/GridPort.rcss"/>
<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Fonts/Fonts.rcss"/></head>
<body>
	<div class="t" id="GC" style="display:grid;width:400px;grid-template-columns:repeat(3, minmax(0, 1fr));gap:16px"><div class="b" id="GC1"></div><div class="b" id="GC2" style="height:35px"></div><div class="b" id="GC3"></div><div class="b" id="GC4"></div><div class="b" id="GC5" style="height:10px"></div></div>
	<div class="t" id="CS" style="display:grid;width:400px;grid-template-columns:repeat(4, minmax(0, 1fr));gap:8px"><div class="b" id="CS1" style="grid-column:span 2 / span 2"></div><div class="b" id="CS2" style="grid-row:span 2 / span 2;height:auto"></div><div class="b" id="CS3"></div><div class="b" id="CS4" style="grid-column:2 / span 3"></div><div class="b" id="CS5" style="grid-column:1 / -1"></div></div>
	<div class="t" id="MM" style="display:grid;width:400px;grid-template-columns:100px minmax(50px, 1fr) auto;column-gap:10px"><div class="b" id="MM1"></div><div class="b" id="MM2"></div><div id="MM3"><span class="i"></span><span class="i"></span></div></div>
	<div class="t" id="AF" style="display:grid;width:350px;grid-template-columns:repeat(auto-fill, minmax(100px, 1fr));gap:5px"><div class="b" id="AF1"></div><div class="b" id="AF2"></div><div class="b" id="AF3"></div><div class="b" id="AF4"></div></div>
	<div class="t" id="AT" style="display:grid;width:450px;grid-template-columns:repeat(auto-fit, minmax(100px, 1fr));gap:5px"><div class="b" id="AT1"></div><div class="b" id="AT2"></div></div>
	<div class="t" id="PI" style="display:grid;width:300px;height:100px;grid-template-columns:repeat(2, minmax(0, 1fr));place-items:center"><div class="b" id="PI1" style="width:40px"></div><div id="PI2"><span class="i"></span></div><div class="b" id="PI3" style="width:60px;height:30px"></div></div>
	<div class="t" id="PS" style="display:grid;width:300px;grid-template-columns:repeat(3, minmax(0, 1fr));grid-template-rows:60px"><div class="b" id="PS1" style="width:30px;place-self:end"></div><div class="b" id="PS2" style="width:30px;align-self:flex-start;justify-self:center"></div><div class="b" id="PS3" style="justify-self:stretch;align-self:stretch;height:auto"></div></div>
	<div class="t" id="DN" style="display:grid;grid-auto-flow:row dense;width:300px;grid-template-columns:repeat(3, minmax(0, 1fr))"><div class="b" id="DN1"></div><div class="b" id="DN2" style="grid-column:span 3 / span 3"></div><div class="b" id="DN3" style="grid-column:span 2 / span 2"></div><div class="b" id="DN4"></div><div class="b" id="DN5"></div></div>
	<div class="t" id="SP" style="display:grid;width:300px;grid-template-columns:repeat(3, minmax(0, 1fr))"><div class="b" id="SP1"></div><div class="b" id="SP2" style="grid-column:span 3 / span 3"></div><div class="b" id="SP3" style="grid-column:span 2 / span 2"></div><div class="b" id="SP4"></div><div class="b" id="SP5"></div></div>
	<div class="t" id="FC" style="display:grid;grid-auto-flow:column;width:300px;grid-template-rows:repeat(3, minmax(0, 1fr));column-gap:4px"><div class="b" id="FC1" style="width:50px"></div><div class="b" id="FC2" style="width:50px"></div><div class="b" id="FC3" style="width:50px"></div><div class="b" id="FC4" style="width:50px;height:40px"></div></div>
	<div class="t" id="IR" style="display:grid;width:300px;grid-template-columns:repeat(2, minmax(0, 1fr));grid-auto-rows:40px;row-gap:6px"><div id="IR1"></div><div id="IR2"></div><div id="IR3"></div><div id="IR4" style="height:60px"></div><div id="IR5"></div></div>
	<div class="t" id="PT" style="display:grid;width:400px;height:120px;grid-template-columns:25% 75%;grid-template-rows:50% 25%"><div id="PT1"></div><div id="PT2"></div><div id="PT3"></div><div id="PT4"></div></div>
	<div class="t" id="FR" style="display:grid;width:200px;height:150px;grid-template-rows:1fr 2fr;row-gap:10px"><div id="FR1"></div><div id="FR2"></div></div>
	<div class="t" id="CT" style="display:grid;width:400px;height:100px;grid-template-columns:repeat(3, 60px);grid-template-rows:30px;justify-content:space-between;align-content:center"><div id="CT1"></div><div id="CT2"></div><div id="CT3"></div></div>
	<div class="t" id="CC" style="display:grid;width:400px;grid-template-columns:repeat(2, 80px);justify-content:center;gap:10px"><div class="b" id="CC1"></div><div class="b" id="CC2"></div></div>
	<div class="t areas" id="AR"><div class="head b" id="AR1"></div><div class="side" id="AR2" style="height:50px"></div><div class="main b" id="AR3"></div><div class="foot" id="AR4"></div></div>
	<div class="t" id="BL" style="display:grid;width:300px;grid-template-columns:repeat(3, 100px);align-items:baseline"><div id="BL1" style="padding-top:10px"><span class="i"></span></div><div id="BL2"><span class="i" style="height:40px"></span></div><div id="BL3" style="margin-top:5px"><span class="i"></span></div></div>
	<div class="t" id="NF" style="display:flex;width:400px"><div id="NF1" style="width:100px;height:50px"></div><div id="NF2" style="display:grid;flex:1 1 0%;grid-template-columns:repeat(2, minmax(0, 1fr));gap:6px"><div class="b" id="NF3"></div><div id="NF4" style="height:45px"></div><div class="b" id="NF5"></div></div></div>
	<div class="t" id="FG" style="display:grid;width:400px;grid-template-columns:150px 1fr"><div id="FG1" style="display:flex;flex-direction:column;gap:4px"><div class="b" id="FG2"></div><div class="b" id="FG3" style="flex:1"></div></div><div id="FG4" style="display:flex;align-items:center;height:80px"><div class="b" id="FG5" style="width:50px"></div><div class="b" id="FG6" style="flex:1"></div></div></div>
	<div class="t" id="SF" style="width:600px"><div id="SF0" style="display:inline-block"><div id="SF1" style="display:grid;grid-template-columns:auto auto;column-gap:10px"><div id="SF2"><span class="i"></span><span class="i"></span></div><div id="SF3"><span class="i"></span></div></div></div></div>
	<div class="t" id="SA" style="position:relative;width:600px;height:60px"><div id="SA1" style="position:absolute;left:0;top:0;display:grid;grid-template-columns:repeat(2, auto);gap:4px"><div id="SA2"><span class="i"></span><span class="i"></span><span class="i"></span></div><div id="SA3"><span class="i"></span></div></div></div>
	<div class="t" id="TB" style="display:grid;width:400px;grid-template-columns:auto 1fr"><div id="TB1" style="display:table"><div style="display:table-row"><div id="TB2" style="display:table-cell;width:70px;height:30px"></div><div id="TB3" style="display:table-cell;width:20px"></div></div></div><div class="b" id="TB4"></div></div>
	<div class="t" id="AB" style="display:grid;position:relative;width:300px;padding:10px;grid-template-columns:repeat(3, 1fr);grid-template-rows:40px 40px"><div class="b" id="AB1"></div><div id="AB2" style="position:absolute;grid-column:2 / 4;grid-row:2;left:0;right:0;top:0;bottom:0"></div><div id="AB3" style="position:absolute;width:20px;height:20px;grid-column:3;grid-row:1 / 3;justify-self:center;align-self:center"></div><div id="AB4" style="position:absolute;left:0;top:0;width:15px;height:15px"></div><div id="AB5" style="position:absolute;right:0;bottom:0;width:15px;height:15px;grid-column:1;grid-row:1"></div></div>
	<div class="t" id="AS" style="display:grid;width:100px;aspect-ratio:2"><div id="AS1" style="height:100px"></div></div>
	<div class="t" id="AQ" style="display:grid;width:200px;aspect-ratio:2;grid-template-rows:1fr"><div id="AQ1" style="height:30px"></div></div>
	<div class="t" id="AN" style="position:relative;width:300px;height:80px"><div id="AN0" style="display:grid;width:200px;grid-template-columns:1fr 1fr"><div class="b" id="AN1"></div><div id="AN2" style="position:absolute;width:20px;height:20px;justify-self:end;align-self:end"></div></div></div>
	<div class="t" id="AT" style="display:flex;width:300px;height:50px"><div id="AT1" style="display:grid;aspect-ratio:2;grid-template-rows:80px;align-self:stretch"><div id="AT2"></div></div></div>
	<div class="t" id="AU" style="display:grid;width:300px;grid-template-columns:300px;grid-template-rows:50px"><div id="AU1" style="display:grid;aspect-ratio:2;grid-template-rows:80px;align-self:stretch"><div id="AU2"></div></div></div>
</body>
</rml>
