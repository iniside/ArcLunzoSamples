#tg-translate { position: absolute; left: 40px; top: 40px; width: 100px; height: 60px; background-color: #3366cc; transform: translateX(200px); }
#tg-rotate { position: absolute; left: 40px; top: 200px; width: 80px; height: 80px; background-color: #cc6633; transform: rotate(45deg); }
#tg-scale-anc { position: absolute; left: 500px; top: 200px; width: 100px; height: 100px; transform: scale(2); }
#tg-scale { position: absolute; left: 10px; top: 10px; width: 30px; height: 30px; background-color: #33cc66; }
#tg-clip-panel { position: absolute; left: 760px; top: 60px; width: 160px; height: 160px; overflow: hidden; transform: rotate(45deg); background-color: #444444; }
#tg-clip-btn { width: 240px; height: 80px; background-color: #cc3366; }
#tg-fit-panel { position: absolute; left: 40px; top: 360px; width: 160px; height: 160px; overflow: hidden; transform: rotate(45deg); background-color: #444444; }
#tg-fit-btn { position: absolute; left: 20px; top: 20px; width: 40px; height: 40px; transform: translateX(200px); background-color: #cc3366; }
#tg-radius-panel { position: absolute; left: 400px; top: 400px; width: 160px; height: 160px; overflow: hidden; border-radius: 4px; background-color: #444444; }
#tg-radius-btn { position: absolute; left: 20px; top: 20px; width: 40px; height: 40px; transform: translateX(300px); background-color: #cc3366; }
#tg-list { position: absolute; left: 780px; top: 380px; width: 200px; height: 150px; overflow-y: auto; background-color: #222222; }
#tg-list::-webkit-scrollbar { width: 12px; }
#tg-list::-webkit-scrollbar-thumb { background: #888888; }
.tg-row { height: 50px; background-color: #555555; }
#tg-list-row { background-color: #cc9933; transform: translateY(-50px); }
#tg-wrap { position: absolute; left: 1150px; top: 40px; width: 40px; font-size: 14px; line-height: 40px; }
#tg-link { display: inline; }
#tg-persp { position: absolute; left: 1060px; top: 480px; width: 160px; height: 200px; background-color: #3399cc; transform: perspective(600px) rotateY(30deg); }
#tg-edge { position: absolute; left: 1100px; top: 300px; width: 100px; height: 60px; background-color: #9933cc; transform: perspective(600px) rotateY(89deg); }
#tg-plain { position: absolute; left: 560px; top: 40px; width: 100px; height: 60px; background-color: #999999; }
#tg-frac { position: absolute; left: 400.25px; top: 40px; width: 100px; height: 60px; background-color: #66cccc; }
#tg-mirror { position: absolute; left: 400px; top: 600px; width: 100px; height: 60px; background-color: #55aa77; transform: translateX(150px) scaleX(-1); }
