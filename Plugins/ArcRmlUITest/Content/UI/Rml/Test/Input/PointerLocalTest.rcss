#trk { position: absolute; left: 20px; top: 20px; width: 200px; height: 20px; background-color: #444444; drag: drag; }
#thumb { position: absolute; left: 0px; top: 0px; width: 20px; height: 20px; background-color: #cc6633; transform: translateX(140px); }
#bar { position: absolute; left: 20px; top: 80px; width: 240px; height: 26px; box-sizing: border-box; border: 1px solid #888888; padding: 3px; background-color: #333333; }
#bartrack { width: 232px; height: 18px; background-color: #33aa66; }
#sanc { position: absolute; left: 20px; top: 140px; width: 100px; height: 10px; transform: scale(2); transform-origin: left top; }
#strk { width: 100px; height: 10px; background-color: #3366cc; drag: drag; }
#keyel { position: absolute; left: 20px; top: 200px; width: 100px; height: 20px; background-color: #999999; tab-index: auto; }
