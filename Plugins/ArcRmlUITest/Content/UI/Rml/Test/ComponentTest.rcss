body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
	color: #e8ecf4;
}

div {
	display: block;
}

.col {
	position: absolute;
	top: 80px;
	width: 560px;
	padding: 12px;
	background-color: #0b0e14e0;
	border-radius: 8px;
}

.left {
	left: 40px;
}

.right {
	left: 640px;
}

.title {
	margin-top: 8px;
	font-size: 14px;
	color: #8890a0;
}

.chip {
	margin-right: 6px;
	color: #3a86ff;
}
