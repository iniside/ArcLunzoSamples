body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 14px;
	color: #e8ecf4;
}

div {
	display: block;
}

.list {
	position: absolute;
	left: 8px;
	top: 8px;
	width: 400px;
	height: 200px;
	overflow: hidden;
}

.row {
	display: flex;
	height: 20px;
	gap: 6px;
}

.name { width: 100px; }
.val { width: 60px; }
