<rml>
<head>
	<title>Hidden Area Tab</title>
	<meta name="frame" content="/ArcRmlUITest/UI/Rml/Test/Areas/AreaFrame.rml"/>
	<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Test/Focus/AreaBackTest.rcss"/>
	<viewmodel name="hiddenarea" preview="Preview/AreaTab.json"/>
<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Fonts/Fonts.rcss"/></head>
<body data-model="hiddenarea">
	<div class="abt-mid" data-focus-area="list" data-focus-primary="" data-if="ArcResolved">
		<div class="abt-btn" id="ha-row-1">{{ label }}</div>
	</div>
</body>
</rml>
