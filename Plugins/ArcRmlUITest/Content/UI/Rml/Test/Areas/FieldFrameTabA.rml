<rml>
<head>
	<title>Field Frame Tab A</title>
	<meta name="frame" content="/ArcRmlUITest/UI/Rml/Test/Areas/FieldFrame.rml"/>
	<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Test/Focus/AreaBackTest.rcss"/>
	<viewmodel name="fieldtab" preview="Preview/AreaTab.json"/>
<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Fonts/Fonts.rcss"/></head>
