<rml>
<head>
	<title>Field Area Tab</title>
	<meta name="frame" content="/ArcRmlUITest/UI/Rml/Test/Areas/AreaFrame.rml"/>
	<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Test/Focus/AreaBackTest.rcss"/>
	<viewmodel name="fieldarea" preview="Preview/AreaTab.json"/>
<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Fonts/Fonts.rcss"/></head>
<body data-model="fieldarea">
	<input type="text" id="fa-field" style="display: block; width: 300px; height: 30px;"/>
	<div class="abt-mid" data-focus-area="list" data-focus-primary="">
		<div class="abt-btn" id="fa-row-1" data-if="ArcResolved">{{ label }}</div>
	</div>
</body>
</rml>
