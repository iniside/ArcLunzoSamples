<rml>
<head>
	<title>Field Frame Tab C</title>
	<meta name="frame" content="/ArcRmlUITest/UI/Rml/Test/Areas/FieldFrame.rml"/>
	<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Test/Focus/AreaBackTest.rcss"/>
	<viewmodel name="fieldtabc" preview="Preview/AreaTab.json"/>
<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Fonts/Fonts.rcss"/></head>
<body data-model="fieldtabc">
	<div class="abt-mid" data-focus-area="list" data-focus-primary="">
		<div class="abt-btn" id="ffC-row-1" data-if="ArcResolved" data-event-click="call('', 'Picked', 'row')">{{ label }}</div>
	</div>
</body>
</rml>
