body { width: 100%; height: 100%; font-family: 'Space Grotesk', sans-serif; font-size: 18px; color: #e8ecf4; }
div { display: block; }
.nm-root { position: absolute; left: 40px; top: 40px; width: 1000px; height: 700px; background-color: #141821; }
.nm-area { position: absolute; width: 360px; padding: 10px; border: 2px dashed #3a4152; }
.nm-area .nm-label { color: #8090a8; font-size: 14px; }
.nm-btn { tab-index: auto; nav: auto; margin: 6px 0; padding: 8px 12px; border: 2px solid #3a4152; background-color: #1e2330; }
.nm-btn:focus-visible { border-color: #ffbe0b; background-color: #2c3346; }
.nm-vertical { nav: vertical; }
.nm-tabs { position: absolute; left: 40px; top: 20px; width: 900px; flex-direction: row; display: flex; }
.nm-tabs .nm-btn { margin: 0 8px 0 0; }
.nm-tabs .nm-btn[selected] { color: #3a86ff; }
.nm-embed { position: absolute; left: 0; top: 100px; width: 1000px; height: 580px; }
.nm-tab-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
