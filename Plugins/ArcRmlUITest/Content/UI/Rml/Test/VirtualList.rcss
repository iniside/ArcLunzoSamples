body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 14px;
	color: #e8ecf4;
}

div {
	display: block;
}

.panel {
	position: absolute;
	top: 80px;
	padding: 12px;
	background-color: #141821e8;
	border-radius: 8px;
}

.list-panel {
	left: 40px;
	width: 520px;
}

.grid-panel {
	left: 620px;
	width: 760px;
}

.mock-panel {
	left: 1420px;
	width: 460px;
}

.mock-panel .row .name {
	width: 160px;
}

.title {
	font-size: 18px;
	margin-bottom: 8px;
}

.frame {
	position: relative;
}

.scroller {
	height: 760px;
	overflow-y: auto;
	scrollbar-color: #8b8b8b #1c2230;
	padding: 6px;
	background-color: #0b0e14;
}

.row {
	height: 20px;
	line-height: 20px;
	white-space: nowrap;
}

.row .idx {
	display: inline-block;
	width: 60px;
	color: #ffbe0b;
}

.row .name {
	display: inline-block;
	width: 200px;
}

.row .val {
	color: #8ecae6;
}

.grid {
	display: grid;
	grid-template-columns: repeat(8, minmax(0, 1fr));
	column-gap: 4px;
	row-gap: 4px;
}

.tile {
	height: 44px;
	padding: 4px;
	border-radius: 4px;
	background-color: #3a86ff99;
	font-size: 12px;
}

.tile-index {
	display: block;
	color: #ffffff;
}

.tile-id {
	display: block;
	color: #ffbe0b;
}

.probe {
	position: absolute;
	right: 4px;
	width: 4px;
	height: 2px;
	pointer-events: none;
}

.probe-top {
	top: 19px;
}

.probe-end {
	bottom: 19px;
}
