<rml>
<head>
	<title>FormStates</title>
	<meta name="layer" content="UI.Layer.Menu"/>
	<meta name="input-mode" content="menu"/>
	<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Test/Form/FormStates.rcss"/>
	<viewmodel name="fs" preview="Preview/FormStates.json"/>
<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Fonts/Fonts.rcss"/></head>
<body data-model="fs">
	<div class="cell" id="fs-cell-text"><input id="fs-text" class="ctl" type="text" value="ab"/><span class="ind en">en</span><span class="ind dis">dis</span><span class="ind req">req</span><span class="ind opt">opt</span><span class="ind ro">ro</span><span class="ind rw">rw</span></div>
	<div class="cell" id="fs-cell-text-req"><input id="fs-text-req" class="ctl" type="text" required=""/><span class="ind en">en</span><span class="ind dis">dis</span><span class="ind req">req</span><span class="ind opt">opt</span><span class="ind ro">ro</span><span class="ind rw">rw</span></div>
	<div class="cell" id="fs-cell-text-ro"><input id="fs-text-ro" class="ctl" type="text" value="ab" readonly=""/><span class="ind en">en</span><span class="ind dis">dis</span><span class="ind req">req</span><span class="ind opt">opt</span><span class="ind ro">ro</span><span class="ind rw">rw</span></div>
	<div class="cell" id="fs-cell-text-off"><input id="fs-text-off" class="ctl" type="text" value="ab" disabled=""/><span class="ind en">en</span><span class="ind dis">dis</span><span class="ind req">req</span><span class="ind opt">opt</span><span class="ind ro">ro</span><span class="ind rw">rw</span></div>
	<div class="cell" id="fs-cell-text-ro-req"><input id="fs-text-ro-req" class="ctl" type="text" readonly="" required=""/><span class="ind en">en</span><span class="ind dis">dis</span><span class="ind req">req</span><span class="ind opt">opt</span><span class="ind ro">ro</span><span class="ind rw">rw</span></div>
	<div class="cell" id="fs-cell-email"><input id="fs-email" class="ctl" type="email" required=""/><span class="ind en">en</span><span class="ind dis">dis</span><span class="ind req">req</span><span class="ind opt">opt</span><span class="ind ro">ro</span><span class="ind rw">rw</span></div>
	<div class="cell" id="fs-cell-password"><input id="fs-password" class="ctl" type="password" value="ab" readonly=""/><span class="ind en">en</span><span class="ind dis">dis</span><span class="ind req">req</span><span class="ind opt">opt</span><span class="ind ro">ro</span><span class="ind rw">rw</span></div>
	<div class="cell" id="fs-cell-ta"><textarea id="fs-ta" class="ctl">ab</textarea><span class="ind en">en</span><span class="ind dis">dis</span><span class="ind req">req</span><span class="ind opt">opt</span><span class="ind ro">ro</span><span class="ind rw">rw</span></div>
	<div class="cell" id="fs-cell-ta-req"><textarea id="fs-ta-req" class="ctl" required=""></textarea><span class="ind en">en</span><span class="ind dis">dis</span><span class="ind req">req</span><span class="ind opt">opt</span><span class="ind ro">ro</span><span class="ind rw">rw</span></div>
	<div class="cell" id="fs-cell-ta-ro"><textarea id="fs-ta-ro" class="ctl" readonly="">ab</textarea><span class="ind en">en</span><span class="ind dis">dis</span><span class="ind req">req</span><span class="ind opt">opt</span><span class="ind ro">ro</span><span class="ind rw">rw</span></div>
	<div class="cell" id="fs-cell-ta-off"><textarea id="fs-ta-off" class="ctl" disabled="">ab</textarea><span class="ind en">en</span><span class="ind dis">dis</span><span class="ind req">req</span><span class="ind opt">opt</span><span class="ind ro">ro</span><span class="ind rw">rw</span></div>
	<div class="cell" id="fs-cell-select"><select id="fs-select" class="ctl"><option value="a">Apple</option></select><span class="ind en">en</span><span class="ind dis">dis</span><span class="ind req">req</span><span class="ind opt">opt</span><span class="ind ro">ro</span><span class="ind rw">rw</span></div>
	<div class="cell" id="fs-cell-select-req"><select id="fs-select-req" class="ctl" required=""><option value="a">Apple</option></select><span class="ind en">en</span><span class="ind dis">dis</span><span class="ind req">req</span><span class="ind opt">opt</span><span class="ind ro">ro</span><span class="ind rw">rw</span></div>
	<div class="cell" id="fs-cell-select-off"><select id="fs-select-off" class="ctl" disabled=""><option value="a">Apple</option></select><span class="ind en">en</span><span class="ind dis">dis</span><span class="ind req">req</span><span class="ind opt">opt</span><span class="ind ro">ro</span><span class="ind rw">rw</span></div>
	<div class="cell" id="fs-cell-button"><button id="fs-button" class="ctl" required="">Go</button><span class="ind en">en</span><span class="ind dis">dis</span><span class="ind req">req</span><span class="ind opt">opt</span><span class="ind ro">ro</span><span class="ind rw">rw</span></div>
	<div class="cell" id="fs-cell-button-off"><button id="fs-button-off" class="ctl" disabled="">Go</button><span class="ind en">en</span><span class="ind dis">dis</span><span class="ind req">req</span><span class="ind opt">opt</span><span class="ind ro">ro</span><span class="ind rw">rw</span></div>
	<div class="cell" id="fs-cell-submit"><input id="fs-submit" class="ctl" type="submit" value="Send" required=""/><span class="ind en">en</span><span class="ind dis">dis</span><span class="ind req">req</span><span class="ind opt">opt</span><span class="ind ro">ro</span><span class="ind rw">rw</span></div>
	<div class="cell" id="fs-cell-checkbox"><input id="fs-checkbox" class="ctl" type="checkbox"/><span class="ind en">en</span><span class="ind dis">dis</span><span class="ind req">req</span><span class="ind opt">opt</span><span class="ind ro">ro</span><span class="ind rw">rw</span></div>
	<div class="cell" id="fs-cell-checkbox-req"><input id="fs-checkbox-req" class="ctl" type="checkbox" required=""/><span class="ind en">en</span><span class="ind dis">dis</span><span class="ind req">req</span><span class="ind opt">opt</span><span class="ind ro">ro</span><span class="ind rw">rw</span></div>
	<div class="cell" id="fs-cell-radio-req"><input id="fs-radio-req" class="ctl" type="radio" name="fsr" required=""/><span class="ind en">en</span><span class="ind dis">dis</span><span class="ind req">req</span><span class="ind opt">opt</span><span class="ind ro">ro</span><span class="ind rw">rw</span></div>
	<div class="cell" id="fs-cell-range-req"><input id="fs-range-req" class="ctl" type="range" required=""/><span class="ind en">en</span><span class="ind dis">dis</span><span class="ind req">req</span><span class="ind opt">opt</span><span class="ind ro">ro</span><span class="ind rw">rw</span></div>
	<div class="cell" id="fs-cell-bound"><input id="fs-bound" class="ctl" type="text" placeholder="Bound" data-attrif-required="req" data-attrif-readonly="ro" data-attrif-disabled="off"/><span class="ind en">en</span><span class="ind dis">dis</span><span class="ind req">req</span><span class="ind opt">opt</span><span class="ind ro">ro</span><span class="ind rw">rw</span></div>
	<div class="cell" id="fs-cell-ta-bound"><textarea id="fs-ta-bound" class="ctl" data-attrif-required="req" data-attrif-readonly="ro" data-attrif-disabled="off">ab</textarea><span class="ind en">en</span><span class="ind dis">dis</span><span class="ind req">req</span><span class="ind opt">opt</span><span class="ind ro">ro</span><span class="ind rw">rw</span></div>
	<div class="cell" id="fs-cell-kind"><input id="fs-kind" class="ctl" type="text" required="" data-attr-type="kind"/><span class="ind en">en</span><span class="ind dis">dis</span><span class="ind req">req</span><span class="ind opt">opt</span><span class="ind ro">ro</span><span class="ind rw">rw</span></div>
	<div class="cell" id="fs-cell-tw"><input id="fs-tw-req" class="required:text-blue-600" type="text" value="ab" required=""/> <input id="fs-tw-opt" class="required:text-blue-600" type="text" value="ab"/></div>
	<div class="cell" id="fs-cell-ph"><input id="fs-ph" class="ph" type="text" placeholder="Your name"/> <input id="fs-ph-plain" type="text" placeholder="Your name"/> <input id="fs-ph-value" class="ph" type="text" placeholder="Your name" value="ab"/> <input id="fs-ph-bound" class="ph" type="text" placeholder="Your name" data-value="name"/></div>
	<div class="cell" id="fs-cell-ph-font"><input id="fs-ph-font" class="ph-font" type="text" placeholder="Your name"/> <input id="fs-ph-center" class="ph-center" type="text" placeholder="Mid"/> <input id="fs-ph-tw" class="placeholder:text-red" type="text" placeholder="Tailwind"/></div>
	<div class="cell" id="fs-cell-ph-ta"><textarea id="fs-ph-ta" class="ph" placeholder="Long placeholder text that wraps over more than one line of the textarea"></textarea> <span id="fs-ph-tag">placeholder</span></div>
</body>
</rml>
