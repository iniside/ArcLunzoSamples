<rml>
<head>
	<title>RangeDefaultPixelTest</title>
	<meta name="layer" content="UI.Layer.Menu"/>
	<meta name="input-mode" content="menu"/>
	<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Test/Form/RangeDefaultPixel.rcss"/>
<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Fonts/Fonts.rcss"/></head>
<body>
	<div class="row"><input id="rd-bare" type="range"/></div>
	<div class="row"><input id="rd-accent" class="accent" type="range"/></div>
	<div class="row"><input id="rd-quarter" type="range" min="0" max="100" step="1" value="25"/></div>
	<div class="row"><input id="rd-wide" class="wide accent" type="range" min="0" max="10" step="1" value="8"/></div>
	<div class="row"><input id="rd-tall" class="tall" type="range" min="0" max="100" step="1" value="0"/></div>
</body>
</rml>
