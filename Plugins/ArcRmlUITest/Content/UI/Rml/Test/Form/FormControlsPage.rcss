body {
	margin: 0;
	width: 100%;
	height: 100%;
	font-family: sans-serif;
	font-size: 16px;
	color: #111827;
	background-color: #f3f4f6;
}

.page {
	height: 100%;
	overflow-y: auto;
}

.stack {
	width: 720px;
	margin: 0 auto;
	padding: 16px 0 48px 0;
}

h1 {
	font-size: 24px;
	margin: 0 0 8px 0;
}

h2 {
	font-size: 18px;
	margin: 24px 0 8px 0;
	padding-bottom: 4px;
	border-bottom: 1px solid #d1d5db;
}

.row {
	display: flex;
	align-items: center;
	margin-bottom: 8px;
}

.label {
	width: 260px;
	flex: none;
	font-size: 14px;
	color: #4b5563;
}

.cell {
	flex: 1;
}

.accent {
	accent-color: #c9a24a;
}

.slider {
	-webkit-appearance: none;
	appearance: none;
	width: 240px;
	height: 6px;
	background: linear-gradient(to right, #c9a24a 50%, #2a2d32 50%);
}

.slider::-webkit-slider-runnable-track {
	height: 6px;
	background: transparent;
}

.slider::-webkit-slider-thumb {
	-webkit-appearance: none;
	width: 16px;
	height: 16px;
	margin-top: -5px;
	border-radius: 50%;
	background: #fff;
}

select.plain {
	-webkit-appearance: none;
	appearance: none;
	padding: 6px 30px 6px 10px;
	border: 1px solid #6b7280;
	border-radius: 4px;
	background-color: #fff;
	background-image: url(FormControlsChevron.png);
	background-repeat: no-repeat;
	background-position: right 10px center;
	background-size: 12px 9px;
}

input[type=checkbox].tick {
	-webkit-appearance: none;
	appearance: none;
	width: 16px;
	height: 16px;
	margin: 0;
	border: 1px solid #6b7280;
	border-radius: 3px;
	background-color: #fff;
	background-origin: border-box;
	color: #2563eb;
}

input[type=checkbox].tick:checked {
	border-color: transparent;
	background-color: currentColor;
	background-image: url(FormControlsTick.png);
	background-repeat: no-repeat;
	background-position: center;
	background-size: 100% 100%;
}

input.req:required {
	border: 2px solid #c2410c;
	background-color: #fff7ed;
}

button.big {
	width: 160px;
	height: 60px;
}

.contact {
	padding: 16px;
	background-color: #fff;
	border: 1px solid #d1d5db;
	border-radius: 8px;
}

.field {
	margin-bottom: 12px;
}

.field label {
	display: block;
	margin-bottom: 4px;
	font-size: 14px;
	font-weight: bold;
}

.field.inline label {
	display: inline;
	font-weight: normal;
}

.control {
	display: block;
	width: 100%;
	padding: 8px 12px;
	border: 1px solid #9ca3af;
	border-radius: 6px;
	background-color: #fff;
	box-sizing: border-box;
}

.send {
	padding: 10px 20px;
	border: 0;
	border-radius: 6px;
	background-color: #2563eb;
	color: #fff;
	font-weight: bold;
}
