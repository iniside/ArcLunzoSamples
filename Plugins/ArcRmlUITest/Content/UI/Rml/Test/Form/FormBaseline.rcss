body {
	margin: 0;
}

.row {
	display: block;
	margin-bottom: 4px;
}

.f16 {
	font-size: 16px;
}

.plain {
	appearance: none;
	width: 13px;
	height: 13px;
	border: 1px solid #000000;
}

.lh {
	line-height: 30px;
}

.mb3 {
	margin-bottom: 3px;
}

.reuse {
	display: inline-block;
	width: 300px;
}

.rmargin {
	margin: 6px;
}

.rtall {
	height: 30px;
}

.slider {
	-webkit-appearance: none;
	appearance: none;
	width: 240px;
	height: 6px;
	background: rgb(42, 45, 50);
}

.slider::-webkit-slider-runnable-track {
	height: 6px;
	background: transparent;
}

.slider::-webkit-slider-thumb {
	-webkit-appearance: none;
	width: 16px;
	height: 16px;
	margin-top: -5px;
	border-radius: 50%;
	background: #fff;
}
