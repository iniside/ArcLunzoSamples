body {
	width: 100%;
	height: 100%;
	font-size: 0;
}

@keyframes ph {
	from { height: 50%; }
	to { height: 100px; }
}

.holder {
	width: 100px;
}

.box {
	width: 5px;
}

.content {
	height: 20px;
}

#an-paused {
	animation: ph 1s linear -0.7s paused;
}

#an-running {
	animation: ph 1s linear forwards;
}
