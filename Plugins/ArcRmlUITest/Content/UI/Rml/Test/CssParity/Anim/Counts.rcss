body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
	color: #ffffff;
}

.row {
	display: block;
	width: 50px;
	height: 20px;
	margin-bottom: 4px;
}

@keyframes fade {
	from { opacity: 0; }
	to { opacity: 1; }
}

#i-zero {
	animation: fade 1s linear 0 forwards;
}

#i-half {
	animation: fade 1s linear 0.5 forwards;
}

#i-alt {
	animation: fade 1s linear 1.5 alternate forwards;
}

@keyframes mid {
	from { opacity: 0; }
	50% { opacity: 1; }
	to { opacity: 0; }
}

#z-half {
	animation: fade 0s linear 0.5 forwards;
}

#z-quarter {
	animation: fade 0s linear 0.25 forwards;
}

#z-alt {
	animation: fade 0s linear 1.5 alternate forwards;
}

#z-zero {
	animation: fade 0s linear 0 forwards;
}

#z-two {
	animation: fade 0s linear 2 forwards;
}

#z-mid {
	animation: mid 0s linear 0.5 forwards;
}
