body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
	color: #ffffff;
}

.row {
	display: block;
	width: 10px;
	height: 20px;
}

.trans {
	transition: width 1s linear;
}

@keyframes grow {
	from { width: 0px; }
	to { width: 400px; }
}

.grow {
	animation: grow 2s linear;
}

@keyframes fade {
	from { opacity: 0; }
	to { opacity: 1; }
}

.fade {
	background-color: #ff0000;
	opacity: 0.5 !important;
	animation: fade 2s linear;
}
