body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
	color: #ffffff;
}

.parent {
	display: block;
	opacity: 0.5;
	width: 100px;
	height: 40px;
	margin-bottom: 10px;
}

.child {
	display: block;
	width: 60px;
	height: 20px;
}

#plain {
	background-color: #ff0000;
}

#half {
	background-color: #0000ff;
	opacity: 0.5;
}

body.flat #p {
	opacity: 1;
}
