body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
	color: #ffffff;
}

.btn {
	display: block;
	width: 50px;
	height: 20px;
	opacity: 1;
	transition: opacity 1s linear;
}

body.go .btn {
	opacity: 0;
}

.plain {
	display: block;
	width: 50px;
	height: 20px;
	opacity: 1;
}

body.hover .plain {
	opacity: 0.5;
	transition: opacity 1s;
}
