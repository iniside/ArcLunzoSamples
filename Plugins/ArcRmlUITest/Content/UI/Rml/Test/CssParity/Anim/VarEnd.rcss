body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
	color: #ffffff;
}

.box {
	display: block;
	--o: 0.5;
	opacity: 1;
	width: 50px;
	height: 20px;
	transition: opacity 1s linear;
}

body.a .box {
	opacity: var(--o);
}

body.a.b .box {
	--x: 1;
}

.btn {
	display: block;
	opacity: 1;
	width: 50px;
	height: 20px;
	transition: opacity 1s linear;
}

body.hover .btn {
	opacity: 0.5;
}
