<rml>
<head>
	<title>Viewport Units Test</title>
	<meta name="layer" content="UI.Layer.Menu"/>
	<meta name="input-mode" content="game"/>
	<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Test/CssParity/Layout/ViewportUnits.rcss"/>
<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Fonts/Fonts.rcss"/></head>
<body>
	<div id="vu-dvw" class="box dvw"></div>
	<div id="vu-svw" class="box svw"></div>
	<div id="vu-lvw" class="box lvw"></div>
	<div id="vu-dvh" class="box dvh"></div>
	<div id="vu-svh" class="box svh"></div>
	<div id="vu-lvh" class="box lvh"></div>
	<div id="vu-vmin" class="box vmin"></div>
	<div id="vu-vmax" class="box vmax"></div>
	<div id="vu-calc-vmin" class="box calc-vmin"></div>
	<div id="vu-calc-dvh" class="box calc-dvh"></div>
	<div id="vu-calc-mixed" class="box calc-mixed"></div>
	<div id="vu-height" class="box height"></div>
	<div id="vu-upper" class="box upper"></div>
</body>
</rml>
