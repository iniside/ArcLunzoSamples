body {
	width: 100%;
	height: 100%;
	background-color: #202020;
	color: #ffffff;
	font-family: 'Space Grotesk';
	font-size: 16px;
}
div { display: block; }
.box { position: absolute; left: 20px; background-color: #303030; }
.bt { font-size: 28px; }
.calcrow { top: 700px; }
.calcrowflex { display: inline-flex; }
.calc50 { width: calc(50px); background-color: #505050; }
.imgrow { top: 640px; left: 700px; display: flex; width: 5px; }
.imgpct { height: 50%; }
.ib { display: inline-block; padding: 2px; background-color: #606060; }
.line5 { top: 920px; left: 20px; }
.itab { display: inline-table; width: 120px; padding: 3px; background-color: #606060; }
.trow { display: table-row; }
.tcell { display: table-cell; padding: 2px; }
.narrow { width: 20px; }
.tcelltop { display: table-cell; vertical-align: top; height: 30px; padding: 2px 2px 5px 2px; border-bottom: 1px #ffffff; }
.tl1 { top: 20px; left: 1100px; }
.tl2 { top: 120px; left: 1100px; display: flex; align-items: flex-start; }
.tl3 { top: 220px; left: 1100px; width: 400px; }
.tl4 { top: 360px; left: 1100px; width: 120px; }
.tl5 { top: 480px; left: 1100px; width: 400px; }
.tl6 { top: 620px; left: 1100px; width: 400px; }
.tauto { display: table; background-color: #404040; }
.itauto { display: inline-table; background-color: #404040; }
.twide { display: table; width: 300px; background-color: #404040; }
.tc { display: table-cell; padding: 3px; }
.big24 { font-size: 24px; }
.small12 { font-size: 12px; padding-top: 6px; }
.ctop { vertical-align: top; }
.cmid { vertical-align: middle; }
.empty { width: 10px; height: 4px; }
.fp1 { top: 760px; left: 1100px; display: flex; width: 300px; }
.fp2 { top: 840px; left: 1100px; display: flex; flex-direction: column; width: 300px; }
.fp3 { top: 940px; left: 1100px; display: flex; flex-direction: column; width: 300px; }
.fpa { background-color: #606060; }
.fpb { height: 40px; width: 50px; background-color: #808080; }
.mxh50 { max-height: 50%; }
.mnh50 { min-height: 50%; }
.h50 { height: 50%; }
.fb50 { flex-basis: 50%; }
.ovxline { width: 50px; }
.ovx1 { top: 1100px; }
.ovx2 { top: 1180px; }
.ibx { display: inline-block; width: 30px; height: 10px; }
.ibhid { overflow: hidden; }
.wide { width: 100px; height: 10px; background-color: #505050; }
