<rml>
<head>
	<title>Flex Min Auto Probe</title>
	<meta name="layer" content="UI.Layer.Menu"/>
	<meta name="input-mode" content="menu"/>
	<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Test/CssParity/Layout/FlexMinAutoProbe.rcss"/>
<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Fonts/Fonts.rcss"/></head>
<body>
	<div id="actions" class="box actions"><div id="act-use" class="act">Use the item now</div><div id="act-equip" class="act">Equip</div><div id="act-drop" class="act">Drop</div></div>
	<div id="word-row" class="box wordrow"><div id="word" class="grow">Extraordinarily</div><div id="word-b" class="grow">ab</div></div>
	<div id="col" class="box col"><div id="col-tall" class="colitem">one two three four five six seven eight nine ten eleven twelve</div><div id="col-b" class="colitem">b</div></div>
	<div id="hid-row" class="box wordrow"><div id="hid" class="grow hid">Extraordinarily</div><div id="hid-b" class="grow">ab</div></div>
	<div id="zero-row" class="box wordrow"><div id="zero" class="grow zero">Extraordinarily</div><div id="zero-b" class="grow">ab</div></div>
	<div id="spec-row" class="box wordrow"><div id="spec" class="spec">Extraordinarily</div><div id="spec-b" class="grow">ab</div></div>
	<div id="ar-row" class="box arrow"><div id="ar" class="ar"></div><div id="ar-b" class="grow">ab</div></div>
	<div id="colbasis" class="box col"><div id="colbasis-a" class="colitem basis0">one two three four five six seven eight nine ten</div><div id="colbasis-b" class="colitem basis0">b</div></div>
	<div id="nest-line" class="box line">Text <span id="outer-if" class="ifx"><span id="inner-if" class="ifx inner">ab</span></span> after</div>
	<div id="base-row" class="box baserow"><div id="base-text" class="bt">Hx</div><div id="base-grid" class="bgrid"><div id="base-grid-a">Gy</div><div id="base-grid-b">two</div></div><div id="base-flex" class="bflex"><div id="base-flex-a">Fz</div></div><div id="base-block" class="bblock"><div id="base-block-flex" class="bflex"><div>Bq</div></div></div></div>
	<div id="icol-line" class="box line2">Text <span id="icol" class="icol"><div id="icol-a">A</div><div id="icol-b" class="bl30">B</div></span> after</div>
	<div id="calccol" class="box calccol"><div id="calc20" class="calc20">one two three four five six seven eight</div></div>
	<div id="calcrow" class="box calcrow"><div id="calcrow-flex" class="calcrowflex"><div id="calc50" class="calc50">Extraordinarily</div></div></div>
	<div id="wr-start" class="box wr wrs"><div id="wr-start-a" class="wri">a</div><div id="wr-start-b" class="wri big">b</div></div>
	<div id="wr-end" class="box wr wre"><div id="wr-end-a" class="wri">a</div><div id="wr-end-b" class="wri big">b</div></div>
	<div id="wr-center" class="box wr wrc"><div id="wr-center-a" class="wri">a</div><div id="wr-center-b" class="wri big">b</div></div>
	<div id="wr-base" class="box wr wrb"><div id="wr-base-a" class="wri">a</div><div id="wr-base-b" class="wri big">b</div></div>
	<div id="wr-stretch" class="box wr wrst"><div id="wr-stretch-a" class="wri">a</div><div id="wr-stretch-b" class="wri big">b</div></div>
	<div id="img-row" class="box imgrow"><img id="img-pct" class="imgpct" src="/ArcRmlUITest/UI/Rml/Test/CssParity/Text/dot.png"/></div>
	<div id="ib-line" class="box line3">Text <span id="ib" class="ib"><div id="ib-a">line</div><div id="ib-ovh" class="ovh">x</div></span> after</div>
	<div id="ib-line2" class="box line4">Text <span id="ib2" class="ib"><div id="ib2-a">line</div><div id="ib2-flex" class="ovhflex">x</div></span> after</div>
	<div id="itab-line" class="box line5">Text <span id="itab" class="itab"><div class="trow"><div id="tc-a" class="tcell narrow">Ab cd</div><div id="tc-b" class="tcell">Ef</div></div><div class="trow"><div id="tc-c" class="tcell">Gh</div><div id="tc-d" class="tcell">Ij</div></div></span> after</div>
	<div id="tab-row" class="box tabrow"><div id="tab-text" class="bt">Hx</div><div id="tab-item" class="tab"><div class="trow"><div id="tc-e" class="tcell">Kl</div></div></div></div>
	<div id="ib-tab-line" class="box line6">Text <span id="ibt" class="ib"><div id="ibt-a">line</div><div id="ibt-tab" class="ibtab"><div class="trow"><div id="tc-f" class="tcell">Mn</div></div></div></span> after</div>
	<div id="tab-row2" class="box tabrow2"><div id="tab2-text" class="bt">Hx</div><div id="tab2-item" class="tab"><div class="trow"><div id="tc-g" class="tcelltop">Op</div></div></div></div>
	<div id="tl1" class="box tl1">Text <span id="ita" class="itauto"><div class="trow"><div id="ta1" class="tc">Short</div><div id="ta2" class="tc">A longer cell</div></div></span> after</div>
	<div id="tl2" class="box tl2"><div id="tfa" class="tauto"><div class="trow"><div id="tfa1" class="tc">One two</div><div id="tfa2" class="tc">Three</div></div></div></div>
	<div id="tl3" class="box tl3"><div id="tba" class="tauto"><div class="trow"><div id="tba1" class="tc">Alpha beta gamma</div><div id="tba2" class="tc">D</div></div><div class="trow"><div id="tba3" class="tc">E</div><div id="tba4" class="tc">Some much longer words in here</div></div></div></div>
	<div id="tl4" class="box tl4"><div id="tnr" class="tauto"><div class="trow"><div id="tnr1" class="tc">Narrow table wrapping words</div><div id="tnr2" class="tc">Second column text</div></div></div></div>
	<div id="tl5" class="box tl5"><div id="twd" class="twide"><div class="trow"><div id="twd1" class="tc">Ab</div><div id="twd2" class="tc">Longer text here</div></div></div></div>
	<div id="tl6" class="box tl6"><div id="tbl" class="tauto"><div class="trow"><div id="tbl1" class="tc big24">Big</div><div id="tbl2" class="tc small12">small</div><div id="tbl3" class="tc ctop">top</div><div id="tbl4" class="tc cmid">mid</div><div id="tbl5" class="tc"><div class="empty"></div></div></div><div class="trow"><div id="tbl6" class="tc small12">x</div><div id="tbl7" class="tc big24">Y</div><div id="tbl8" class="tc">z</div><div id="tbl9" class="tc">w</div><div id="tbl10" class="tc">v</div></div></div></div>
	<div id="fp1" class="box fp1"><div id="fp1-a" class="fpa mxh50">stretched max</div><div id="fp1-b" class="fpa mnh50">min</div><div id="fp1-c" class="fpb">tall</div></div>
	<div id="fp2" class="box fp2"><div id="fp2-a" class="fpa h50">height 50</div><div id="fp2-b" class="fpa mxh50">max 50</div></div>
	<div id="fp3" class="box fp3"><div id="fp3-a" class="fpa fb50">basis 50</div><div id="fp3-b" class="fpa mnh50">min 50</div></div>
</body>
</rml>
