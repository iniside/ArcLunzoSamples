body {
	margin: 0;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
}

.grid { display: grid; width: 100px; height: 100px; margin-bottom: 4px; background-color: #dde3ee; }
.flex { display: flex; width: 100px; height: 100px; margin-bottom: 4px; background-color: #dde3ee; }
.wrap { flex-wrap: wrap; }
.cell { width: 20px; height: 20px; background-color: #cc3366; }
.items { place-items: center; }
.tracks { grid-template-columns: 20px; grid-template-rows: 20px; place-content: center end; }
.self { place-self: end; }
.items-two { place-items: end center; }
.content-flex { place-content: center; }
