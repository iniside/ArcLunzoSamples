<rml>
<head>
	<title>OrderTest</title>
	<meta name="layer" content="UI.Layer.Menu"/>
	<meta name="input-mode" content="menu"/>
	<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Test/CssParity/Layout/OrderTest.rcss"/>
<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Fonts/Fonts.rcss"/></head>
<body>
	<div id="row" class="row">
		<div id="row-a" class="item o2"></div>
		<div id="row-b" class="item om1"></div>
		<div id="row-c" class="item o0"></div>
		<div id="row-d" class="item o1"></div>
		<div id="row-e" class="item op3"></div>
		<div id="row-abs" class="abs"></div>
	</div>
	<div id="wrap" class="row wrap">
		<div id="wrap-a" class="item o2"></div>
		<div id="wrap-b" class="item om1"></div>
		<div id="wrap-c" class="item o0"></div>
		<div id="wrap-d" class="item o1"></div>
		<div id="wrap-e" class="item op3"></div>
	</div>
	<div id="colrev" class="colrev">
		<div id="colrev-a" class="citem o2"></div>
		<div id="colrev-b" class="citem om1"></div>
		<div id="colrev-c" class="citem o0"></div>
	</div>
	<div id="contents" class="row">
		<div id="contents-a" class="item o1"></div>
		<div id="contents-wrapper" class="contents">
			<div id="contents-b" class="item o2"></div>
			<div id="contents-c" class="item om1"></div>
		</div>
	</div>
	<div id="grid" class="grid">
		<div id="grid-a" class="gitem o2"></div>
		<div id="grid-b" class="gitem om1"></div>
		<div id="grid-c" class="gitem o0"></div>
		<div id="grid-placed" class="gitem placed om1"></div>
		<div id="grid-d" class="gitem o1"></div>
	</div>
	<div id="overlap" class="overlap">
		<div id="overlap-a" class="oitem o1"></div>
		<div id="overlap-b" class="oitem o0"></div>
	</div>
	<div id="overlap-rel" class="overlap">
		<div id="overlap-rel-a" class="oitem rel o1"></div>
		<div id="overlap-rel-b" class="oitem rel o0"></div>
	</div>
	<div id="mix" class="mix">
		<div id="mix-a" class="mixa o1"></div>
		<span id="mix-b" class="mixb o0"></span>
	</div>
	<div id="flt" class="overlap">
		<div id="flt-a" class="oitem flta o0"></div>
		<div id="flt-b" class="oitem fltb o1"></div>
	</div>
</body>
</rml>
