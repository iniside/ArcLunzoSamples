body {
	width: 100%;
	height: 100%;
	background-color: #202020;
	color: #ffffff;
	font-family: 'Space Grotesk';
	font-size: 16px;
}
div { display: block; }
.box { position: absolute; left: 20px; background-color: #303030; }

.wordrow { width: 100px; display: flex; }
#auto-row { top: 20px; }
#none-row { top: 60px; }
.grow { flex: 1 1 auto; background-color: #505050; }
.zero { min-width: 0; }
.explicit { min-width: auto; }

#blk-wrap { top: 100px; width: 200px; }
.floor { min-width: 80px; min-height: 40px; background-color: #505050; }
.blk { width: 30px; height: 10px; min-width: auto; min-height: auto; }
