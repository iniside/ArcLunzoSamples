body > div {
	position: absolute;
	width: 120px;
	height: 60px;
}

#fixedbox { left: 200px; top: 150px; background: linear-gradient(#e6194b, #e6194b) no-repeat fixed; background-size: 50px 30px; background-position: 220px 160px; }
#localbox { left: 400px; top: 150px; overflow: auto; background: linear-gradient(#3cb44b, #3cb44b) no-repeat local; background-size: 50px 20px; background-position: 10px 100px; }
#localbox div { display: block; width: 100px; height: 300px; }
