		<div id="c6" class="b"></div>
		<div id="c7" class="b"></div>
		<div id="c8" class="b"></div>
		<div id="c9" class="b"></div>
		<div id="fl" class="b"><div id="fl-s" class="fbox"></div><div id="fl-e" class="fbox"></div><div id="fl-n" class="in"></div></div>
		<div id="cl" class="b"><div id="cl-l" class="fbox"></div><div id="cl-r" class="fbox"></div><div id="cl-s" class="in"></div></div>
		<div id="ce" class="b"><div id="ce-l" class="fbox"></div><div id="ce-r" class="fbox"></div><div id="ce-e" class="in"></div></div>
