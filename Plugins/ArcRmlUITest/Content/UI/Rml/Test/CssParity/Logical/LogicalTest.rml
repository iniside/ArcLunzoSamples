<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Fonts/Fonts.rcss"/></head>
<body>
	<div id="px" class="b"><div id="px-in" class="in"></div></div>
	<div id="py" class="b"><div id="py-in" class="in"></div></div>
	<div id="ps" class="b"><div id="ps-in" class="in"></div></div>
	<div id="mx" class="b"></div>
	<div id="ms" class="b"></div>
	<div id="me" class="b"></div>
	<div id="my" class="b"></div>
	<div id="bx" class="b"></div>
	<div id="by" class="b"></div>
	<div id="bs" class="b"></div>
	<div id="size" class="b"></div>
	<div id="minmax" class="b"></div>
	<div id="inset" class="b"><div id="inset-in" class="b"></div></div>
	<div id="ta-parent" class="b"><div id="ta-start" class="b"><span id="ta-start-ib" class="ib"></span></div></div>
	<div id="ta-end" class="b"><span id="ta-end-ib" class="ib"></span></div>
	<div id="o1" class="b"><div id="o1-in" class="in"></div></div>
