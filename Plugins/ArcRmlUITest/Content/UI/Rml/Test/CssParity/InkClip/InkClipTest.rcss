* { box-sizing: border-box; }
body { margin: 0; width: 100%; height: 100%; background-color: #000000; font-family: 'Space Grotesk', sans-serif; font-size: 16px; line-height: 20px; color: #ffffff; }
.abs { position: absolute; display: block; }
.clip { overflow: hidden; }
.child { display: block; margin: 10px; width: 100px; height: 40px; background-color: #333333; }
#p1 { left: 20px; top: 40px; width: 120px; height: 60px; background-color: #222222; }
#k1 { box-shadow: 0px 0px 0px 15px #ff0000; }
#p2 { left: 180px; top: 40px; width: 120px; height: 60px; background-color: #222222; border-radius: 16px; }
#k2 { box-shadow: 0px 0px 0px 15px #00ff00; }
#p3 { left: 340px; top: 40px; width: 160px; height: 100px; background-color: #222222; }
#p3in { display: block; margin: 10px; width: 120px; height: 60px; background-color: #444444; }
#k3 { box-shadow: 0px 0px 0px 20px #0000ff; }
#p4 { left: 540px; top: 40px; width: 120px; height: 60px; background-color: #222222; overflow-x: hidden; }
#k4 { box-shadow: 0px 0px 0px 15px #ff00ff; }
#p5 { left: 700px; top: 40px; width: 120px; height: 60px; background-color: #222222; }
#k5 { transform: rotate(20deg); box-shadow: 0px 0px 0px 10px #ffff00; }
#p6 { left: 860px; top: 40px; width: 120px; height: 40px; background-color: #222222; }
#k6 { display: block; margin: 10px; text-shadow: 0px 24px 0px #00ffff; }
#p7 { left: 1020px; top: 40px; width: 120px; height: 60px; background-color: #222222; }
#k7 { filter: drop-shadow(0px 30px 0px #ff8800); }
#p8 { left: 20px; top: 180px; width: 120px; height: 40px; background-color: #222222; }
#k8 { display: block; margin: 10px; font-effect: shadow(0px 24px #ff00aa); }
#p9 { left: 200px; top: 180px; width: 200px; height: 16px; background-color: #222222; }
#k9 { display: block; font-size: 48px; line-height: 16px; color: #ffff00; }
#p10 { left: 440px; top: 180px; width: 120px; height: 60px; background-color: #222222; }
#k10 { background-color: #5599cc; }
#p11 { left: 600px; top: 180px; width: 200px; height: 70px; background-color: #222222; }
#k11 { display: block; font-size: 48px; line-height: 16px; color: #ff66ff; }
