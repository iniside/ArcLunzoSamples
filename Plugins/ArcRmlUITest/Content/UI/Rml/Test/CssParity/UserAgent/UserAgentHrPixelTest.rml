<rml>
<head>
	<title>UserAgentHrPixelTest</title>
	<meta name="layer" content="UI.Layer.Menu"/>
	<meta name="input-mode" content="menu"/>
	<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Test/CssParity/UserAgent/UserAgentHrPixel.rcss"/>
<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Fonts/Fonts.rcss"/></head>
<body>
	<div style="top: 10px"><hr id="hr-default"/></div>
	<div style="top: 30px"><hr id="hr-wide" style="border-width: 4px"/></div>
	<div style="top: 50px"><hr id="hr-black" style="color: black"/></div>
	<div style="top: 70px"><hr id="hr-blue" style="border-color: #3366cc"/></div>
	<div id="inset-dark" style="top: 90px; height: 4px; border: 2px inset #303030"></div>
	<div id="inset-light" style="top: 110px; height: 4px; border: 2px inset #f0f0f0"></div>
	<div id="inset-white" style="top: 130px; height: 4px; border: 2px inset #ffffff"></div>
</body>
</rml>
