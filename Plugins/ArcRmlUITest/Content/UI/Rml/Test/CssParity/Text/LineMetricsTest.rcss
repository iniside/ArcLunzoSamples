body {
	width: 100%;
	height: 100%;
	background-color: #202020;
	color: #ffffff;
	font-family: 'Space Grotesk';
}

div {
	display: block;
}

.box {
	position: absolute;
	left: 20px;
}

.lh15 {
	top: 20px;
	font-size: 15px;
}

.lh16 {
	top: 60px;
	font-size: 16px;
}

.jbm9 {
	top: 100px;
	font-family: 'JetBrains Mono';
	font-size: 9px;
	line-height: 1.5;
}

.longword {
	top: 140px;
	width: 200px;
	font-size: 15px;
	word-break: break-all;
}
