body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
}

div {
	display: block;
}

.hud-dmg {
	position: absolute;
	white-space: nowrap;
	font-family: 'Barlow Condensed', sans-serif;
	font-style: normal;
	letter-spacing: 0.5px;
	text-transform: none;
	font-variant-numeric: tabular-nums;
	font-size: 33px;
	font-weight: 700;
	color: #c03020;
}

#dmg-111 {
	left: 40px;
	top: 40px;
}

#dmg-808 {
	left: 40px;
	top: 100px;
}

.zero {
	position: absolute;
	top: 200px;
	font-family: 'Space Grotesk';
	font-size: 96px;
	font-weight: 400;
	color: #c03020;
}

#zero-slashed {
	left: 40px;
	font-variant-numeric: slashed-zero;
}

#zero-plain {
	left: 240px;
}
