body {
	width: 100%;
	height: 100%;
	background-color: #202020;
	font-family: 'Space Grotesk', sans-serif;
	color: #ffffff;
}

div {
	display: block;
	position: absolute;
}

.cross {
	left: 100px;
	top: 100px;
	font-family: 'JetBrains Mono';
	font-size: 64px;
	white-space: nowrap;
	font-effect: shadow(-20px 0px #ff0000);
}

.lines {
	left: 100px;
	top: 300px;
	width: 120px;
	font-family: 'JetBrains Mono';
	font-size: 64px;
	line-height: 40px;
	font-effect: outline(6px #00ff00);
}
