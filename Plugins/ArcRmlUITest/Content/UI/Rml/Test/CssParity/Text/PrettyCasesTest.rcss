body {
	width: 100%;
	height: 100%;
	background-color: #202020;
	color: #ffffff;
	font-family: 'Space Grotesk';
	font-size: 16px;
}

div {
	display: block;
}

.t {
	position: absolute;
}

.pretty {
	text-wrap: pretty;
}

.prewrap {
	white-space: pre-wrap;
}

.breakall {
	word-break: break-all;
}

.nw {
	white-space: nowrap;
}

.fr {
	float: right;
}

.fl {
	float: left;
	width: 40px;
	height: 30px;
	background-color: #406080;
}

.tall {
	height: 100px;
}

.ib {
	display: inline-block;
}

.pl10 {
	padding-left: 10px;
}

.pl12 {
	padding-left: 12px;
}

.em {
	color: #d0a020;
}

.right {
	text-align: right;
}

.center {
	text-align: center;
}

.justify {
	text-align: justify;
}
