body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
	color: #e8ecf4;
}

div {
	display: block;
}

.line {
	position: absolute;
	left: 20px;
	white-space: nowrap;
}

.hdr {
	font-family: 'Space Grotesk';
	font-weight: 700;
	font-size: 12dp;
	letter-spacing: 1.8dp;
	text-transform: uppercase;
}

#hdr-compat { top: 10px; }
#hdr-item { top: 40px; }
#hdr-storage { top: 70px; }
#hdr-inv { top: 100px; }

.kern {
	font-weight: 600;
	font-size: 20px;
}

.kern-off {
	font-kerning: none;
}

#kern-on { top: 130px; }
#kern-off { top: 160px; }

.s12 {
	font-size: 12px;
	top: 190px;
}

.s10 {
	font-size: 10px;
	top: 215px;
}

.mono {
	top: 240px;
	font-family: 'JetBrains Mono';
	font-size: 20px;
	color: #10a0d0;
}

.fallback {
	top: 270px;
	font-family: 'JetBrains Mono', sans-serif;
	font-size: 16px;
	color: #d010a0;
}

.nnbsp {
	font-size: 16px;
	font-kerning: none;
}

#nnbsp {
	top: 300px;
	color: #2070d0;
}
#nnbsp-space { top: 330px; }
#nnbsp-none { top: 360px; }

.lig {
	top: 390px;
	font-size: 16px;
	color: #a0d010;
}

.lig-spaced {
	top: 420px;
	letter-spacing: 1px;
	color: #20d0a0;
}

.zw {
	top: 450px;
	font-family: 'JetBrains Mono';
	font-size: 16px;
	color: #d0a020;
}

.zw-control {
	top: 480px;
	color: #a020d0;
}
