body {
	width: 100%;
	height: 100%;
	background-color: #202020;
	color: #ffffff;
	font-family: 'Space Grotesk';
	font-size: 16px;
}

div {
	display: block;
}

.t {
	position: absolute;
	text-align: justify;
}

.pretty {
	text-wrap: pretty;
}

.prewrap {
	white-space: pre-wrap;
}

.nowrap {
	white-space: nowrap;
}

.nw {
	white-space: nowrap;
}

.ls {
	letter-spacing: 2px;
}

.pad {
	padding: 0 6px;
	color: #d0a020;
}

.ib {
	display: inline-block;
	padding: 0 4px;
}

.fl {
	float: left;
	width: 40px;
	height: 30px;
	background-color: #406080;
}

.last-justify {
	text-align-last: justify;
}

.last-center {
	text-align-last: center;
}

.last-right {
	text-align-last: right;
}

.centered {
	text-align: center;
}

.left {
	text-align: left;
}

.tja {
	text-justify: auto;
}

.tjn {
	text-justify: none;
}

.tjw {
	text-justify: inter-word;
}

.tjc {
	text-justify: inter-character;
}

.tjd {
	text-justify: distribute;
}
