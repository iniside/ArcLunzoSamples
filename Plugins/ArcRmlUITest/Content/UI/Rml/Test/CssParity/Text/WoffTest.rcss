body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
	color: #e8ecf4;
}

div {
	display: block;
}

.line {
	position: absolute;
	left: 20px;
	white-space: nowrap;
}

.woff {
	top: 10px;
	font-family: 'Arc Woff Test', 'Space Grotesk';
}

.control {
	top: 40px;
	font-family: 'Space Grotesk';
}

.mono {
	top: 70px;
	font-family: 'JetBrains Mono';
	font-size: 20px;
}
