body {
	display: block;
	width: 100%;
	height: 100%;
	font-size: 16px;
	color: #000000;
}

div {
	display: block;
}

* { box-sizing: border-box; }
body { margin: 0; }

.tm-root {
	position: relative;
	width: 100%;
	height: 100%;
	overflow: hidden;
	font-family: var(--font-sans);
	user-select: none;
}

.tm-footer {
	position: absolute;
	right: 90px;
	bottom: 26px;
	display: flex;
	align-items: center;
	gap: 20px;
}

.tm-footer-default {
	display: contents;
}

.tm-footer-gear, .tm-footer-reqs, .tm-footer-abilities {
	display: none;
}

body[data-focus-active="gear"] .tm-footer-default, body[data-focus-active="reqs"] .tm-footer-default, body[data-focus-active="abilities"] .tm-footer-default {
	display: none;
}

body[data-focus-active="gear"] .tm-footer-gear, body[data-focus-active="reqs"] .tm-footer-reqs, body[data-focus-active="abilities"] .tm-footer-abilities {
	display: contents;
}
