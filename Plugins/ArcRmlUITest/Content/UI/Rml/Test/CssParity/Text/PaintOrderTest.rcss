body {
	width: 100%;
	height: 100%;
	background-color: #101010;
	font-family: 'Barlow Condensed';
	font-size: 33px;
	font-weight: 700;
}

div {
	display: block;
}

.t {
	position: absolute;
}

.po-normal {
	color: #2a7fd4;
	-webkit-text-stroke: 4px #d4342a;
}

.po-stroke-fill {
	color: #d4b02a;
	-webkit-text-stroke: 4px #2ad48c;
	paint-order: stroke fill;
}
