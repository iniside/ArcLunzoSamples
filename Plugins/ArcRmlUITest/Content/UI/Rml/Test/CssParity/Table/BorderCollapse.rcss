body {
	margin: 0;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 0;
}

.cb { display: flow-root; margin-bottom: 8px; }
.b { display: inline-block; width: 40px; height: 20px; }
td, th { padding: 10px 8px; }

.collapse { border-collapse: collapse; }

.pf thead { border-bottom: 2px solid #204080; }
.pf tbody tr { border-bottom: 1px solid #a03030; }

.all td { border: 1px solid #208040; }

.wide td { border: 1px solid #806020; }
.wide td.w3 { border: 3px solid #602080; }

.dash td { border: 2px solid #2060a0; }
.dash td.d { border-style: dashed; border-color: #a02060; }

.sep { border-spacing: 0; }
.sep tr { border-bottom: 1px solid #c08000; }

.spc { border-spacing: 4px 2px; padding: 3px; border: 1px solid #404040; }
.spc td { background-color: #d0e0d0; }

.ft { border-spacing: 0; }

.kw { width: 200px; }
.kw table { border-spacing: 0; }
.kw td { padding: 0; font-size: 16px; }
.kw .fit { width: fit-content; }
.ib60 { display: inline-block; width: 60px; height: 10px; background-color: #3366cc; }
.ib30 { display: inline-block; width: 30px; height: 10px; background-color: #cc3366; }
