*, ::before, ::after {
	margin: 0;
	padding: 0;
}

html, body {
	background-color: #ffffff;
}

body {
	font-size: 16px;
	color: #000000;
}

ol, ul, menu {
	list-style: none;
}

.box {
	position: absolute;
	width: 200px;
}

.list-disc {
	list-style-type: disc;
}

.list-decimal {
	list-style-type: decimal;
}

.list-none {
	list-style-type: none;
}

.list-inside {
	list-style-position: inside;
}

.list-outside {
	list-style-position: outside;
}

.pl-5 {
	padding-left: 20px;
}

.pl-6 {
	padding-left: 24px;
}
