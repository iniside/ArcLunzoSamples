body {
	display: block;
}

.swatch {
	display: block;
	width: 40px;
	height: 10px;
}

#rgb-alpha {
	background-color: rgb(0 0 0 / 0.1);
}

#rgb-plain {
	background-color: rgb(255 128 0);
}

#rgba-percent-alpha {
	background-color: rgba(10 20 30 / 50%);
}

#rgb-percent {
	background-color: rgb(100% 50% 0% / 25%);
}

#rgb-none {
	background-color: rgb(none 200 none);
}

#rgb-tight-slash {
	background-color: rgb(40 80 120/0.6);
}

#rgb-fraction {
	background-color: rgb(127.6 0.4 254.5);
}

#hsl-plain {
	background-color: hsl(120 100% 50%);
}

#hsl-deg-alpha {
	background-color: hsl(240deg 100% 50% / 0.5);
}

#hsla-turn {
	background-color: hsla(0.5turn 100% 25% / 40%);
}

#hsl-numbers {
	background-color: hsl(30 80 60);
}

#hsl-rad {
	background-color: hsl(3.14159rad 50% 50%);
}

#oklch-alpha {
	background-color: oklch(62.3% 0.214 259.815 / 50%);
}

#mix-modern {
	background-color: color-mix(in srgb, rgb(255 0 0 / 0.5) 50%, rgb(0 0 255));
}

#rgb-comma {
	background-color: rgb(1, 2, 3);
}
