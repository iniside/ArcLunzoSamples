<rml>
<head>
	<title>NestingTest</title>
	<meta name="layer" content="UI.Layer.Menu"/>
	<meta name="input-mode" content="game"/>
	<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Test/CssParity/AtRules/Nesting.rcss"/>
<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Fonts/Fonts.rcss"/></head>
<body>
	<div id="a" class="a"></div>
	<div id="a-on" class="a on"></div>
	<div class="b"><div id="b-a" class="a"></div></div>
	<div class="list"><div id="item" class="item"></div><div><div id="entry" class="entry"></div></div><div id="item-on" class="item on"></div></div>
	<div class="wrap"><div class="list"><div id="wrap-item" class="item"></div></div></div>
	<div class="desc"><div id="direct" class="direct"></div><div class="grow"><div id="child" class="child"></div><div id="indirect" class="direct"></div></div><div id="mid" class="mid"><div id="leaf" class="leaf"></div></div></div>
	<div id="m" class="m"></div>
	<div id="m-s" class="m s"></div>
	<div id="container" class="container"></div>
	<div id="hover-blue" class="hover-blue"></div>
	<div id="after-nest" class="after-nest"></div>
</body>
</rml>
