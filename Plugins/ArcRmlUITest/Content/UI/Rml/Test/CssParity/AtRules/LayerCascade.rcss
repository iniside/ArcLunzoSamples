@layer a, b;

body {
	width: 100%;
	height: 100%;
}

.row {
	display: block;
	width: 40px;
	height: 10px;
}

@layer b { #stmt { background-color: #0b0b0b; } }
@layer a { #stmt { background-color: #0a0a0a; } }

@layer d { #blk { background-color: #0d0d0d; } }
@layer c { #blk { background-color: #0c0c0c; } }

@layer a { #spec { background-color: #1a1a1a; } }
@layer b { .sp { background-color: #1b1b1b; } }

@layer b { #unl { background-color: #2b2b2b; } }
.un { background-color: #2f2f2f; }

@layer a { #imp { background-color: #3a3a3a !important; } }
@layer b { #imp { background-color: #3b3b3b !important; } }

@layer a { #mix { background-color: #4a4a4a !important; } }
@layer b { #mix { background-color: #4b4b4b; } }

@layer a { #uimp { background-color: #5a5a5a !important; } }
#uimp { background-color: #5f5f5f !important; }

@layer a { #ln { background-color: #6a6a6a !important; } }
#ln { background-color: #6f6f6f; }

@layer outer {
	@layer inner { #nest { background-color: #7a7a7a; } }
	#nest { background-color: #7b7b7b; }
}

@layer p { @layer x { #nx { background-color: #8a8a8a; } } }
@layer q { #nx { background-color: #8b8b8b; } }

@layer m.n { #dot { background-color: #9a9a9a; } }
@layer m { #dot { background-color: #9b9b9b; } }

@layer s.t { #sib { background-color: #aaaaaa; } }
@layer s.u { #sib { background-color: #ababab; } }

@layer outer2 {
	@layer inner2 { #nimp { background-color: #cacaca !important; } }
	#nimp { background-color: #cbcbcb !important; }
}
