@layer lo, hi;

body {
	width: 100%;
	height: 100%;
}

.row {
	display: block;
	width: 40px;
	height: 10px;
}

@layer ya { #ord { background-color: #0a0a0a; } }
@layer p1 { #late { background-color: #1a1a1a; } }
#unl { background-color: #2a2a2a; }
@layer lo { #xs-imp { background-color: #3a3a3a !important; } }
