body {
	width: 100%;
	height: 100%;
}

.block {
	display: block;
}

#rem-pad {
	width: 100px;
	padding: 1rem;
}

#rem-inner {
	height: 10px;
}

#em-box {
	width: 2em;
	height: 1em;
}

#rem-box {
	width: 3rem;
	height: 0.5rem;
}

#kw-parent {
	color: red;
	font-size: 10px;
}

#kw-child {
	color: initial;
	font-size: initial;
	width: 2em;
	height: 1em;
}

body { margin: 0; }
