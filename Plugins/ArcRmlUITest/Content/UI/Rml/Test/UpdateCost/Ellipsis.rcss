body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
	color: #ff0080;
}

.box {
	display: block;
	position: absolute;
	left: 20px;
	top: 20px;
	width: 80px;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

body.wide .box {
	width: 600px;
}
