body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 12px;
	color: #e8ecf4;
}

div {
	display: block;
}

.list {
	position: absolute;
	left: 20px;
	top: 20px;
	width: 400px;
	bottom: 20px;
}

.row {
	display: flex;
	height: 16px;
	gap: 4px;
}

.cell {
	width: 60px;
	background-color: #202838;
}

.cell.hot {
	background-color: #cc3333;
}
