body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
	color: #e8ecf4;
}

.plain {
	display: block;
	position: absolute;
	left: 20px;
	top: 20px;
	width: 300px;
	height: 100px;
}

.btn {
	display: block;
	position: absolute;
	left: 20px;
	width: 120px;
	height: 30px;
	tab-index: auto;
	focus: auto;
}

#first { top: 200px; }
#second { top: 260px; }
