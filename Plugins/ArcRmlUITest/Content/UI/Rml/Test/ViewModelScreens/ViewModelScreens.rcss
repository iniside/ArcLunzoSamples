body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 30px;
	color: #e8ecf4;
	background-color: #0e1420;
}

div {
	display: block;
}

.card {
	width: 960px;
	margin: 180px auto 0 auto;
	padding: 40px 48px;
	background-color: #1b2436;
	border: 2px solid #4a6fa5;
	border-radius: 12px;
}

.title {
	font-size: 56px;
	font-weight: bold;
	color: #ffd27a;
}

.source {
	margin-bottom: 28px;
	font-size: 22px;
	color: #8fa3c4;
}

.row {
	display: flex;
	padding: 8px 0;
	border-bottom: 1px solid #2c3a52;
}

.key {
	width: 260px;
	color: #8fa3c4;
}

.value {
	color: #ffffff;
	font-weight: bold;
}
