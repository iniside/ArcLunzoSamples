body {
	width: 100%;
	height: 100%;
}

div {
	display: block;
}

.sf {
	position: absolute;
	left: 20px;
	display: flex;
	height: 100px;
	background-color: #141821;
}

#fa-stretch { top: 20px; }
#fa-start { top: 140px; }
#fa-wrap { top: 260px; }
#fa-two { top: 380px; }
#fa-padded { top: 500px; }

.sf.start {
	align-items: flex-start;
}

.sf.wrap {
	flex-wrap: wrap;
}

.sf.padded {
	padding: 6px;
}

.sf-inline {
	position: absolute;
	left: 400px;
	top: 20px;
	display: inline-flex;
	height: 50px;
	background-color: #141821;
}

.ar {
	aspect-ratio: 2;
	background-color: #3a86ff;
}

.ar.half {
	aspect-ratio: 0.5;
	background-color: #ff006e;
}

.ar.edges {
	padding: 4px;
	border: 2px solid #ffffff;
}

.cb0 {
	position: absolute;
	left: 400px;
	top: 140px;
	width: 0;
	height: 0;
}

#fa-min {
	left: 0;
	top: 0;
}

.cb200 {
	position: absolute;
	top: 300px;
	width: 0;
	height: 200px;
}

#cb-inset { left: 700px; }
#cb-pct { left: 950px; }
#cb-inset-min { left: 1200px; }

.sf-abs {
	position: absolute;
	left: 0;
	top: 0;
	display: flex;
	background-color: #141821;
}

.sf-abs.inset {
	bottom: 100px;
}

.sf-abs.pct {
	height: 50%;
}

.sf-abs.inset-min {
	bottom: 150px;
}

.w10 {
	flex: none;
	width: 10px;
	background-color: #ff006e;
}
