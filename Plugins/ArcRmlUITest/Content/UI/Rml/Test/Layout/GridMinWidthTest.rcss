body {
	width: 100%;
	height: 100%;
}

div {
	display: block;
}

.grid {
	position: absolute;
	left: 20px;
	width: 200px;
	display: grid;
	grid-template-columns: auto auto;
	background-color: #141821;
}

#g-auto { top: 20px; }
#g-zero { top: 120px; }
#g-initial { top: 220px; }
#g-inherit { top: 320px; }
#g-inherit-px { top: 420px; min-width: 30px; }
#g-inline { top: 520px; }

#g-contents { top: 1220px; }
#g-flex-inherit { top: 1320px; }

#g-zero > div { min-width: 0; }
#g-initial > div { min-width: initial; }
#g-inherit > div { min-width: inherit; }
#g-inherit-px > div { min-width: inherit; }

.a, .b {
	display: flex;
	flex-wrap: wrap;
	align-content: flex-start;
}

.a { background-color: #3a86ff; }
.b { background-color: #ff006e; }

.b35, .b41, .b63, .b72 {
	flex: none;
	height: 20px;
	background-color: #ffbe0b;
}

.b35 { width: 35px; }
.b41 { width: 41px; }
.b63 { width: 63px; }
.b72 { width: 72px; }

.contents {
	display: contents;
}

.grid.narrow {
	width: 40px;
	grid-template-columns: auto;
}

.flexitem {
	display: flex;
	width: 40px;
}

.inherit-min {
	min-width: inherit;
	background-color: #3a86ff;
}
