<rml>
<head>
	<title>Flex Aspect Ratio Test</title>
	<meta name="layer" content="UI.Layer.Menu"/>
	<meta name="input-mode" content="game"/>
	<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Test/Layout/FlexAspectTest.rcss"/>
<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Fonts/Fonts.rcss"/></head>
<body>
	<div id="fa-stretch" class="sf"><div id="fa-stretch-item" class="ar"></div></div>
	<div id="fa-start" class="sf start"><div id="fa-start-item" class="ar"></div></div>
	<div id="fa-wrap" class="sf wrap"><div id="fa-wrap-item" class="ar"></div></div>
	<div id="fa-two" class="sf"><div id="fa-two-a" class="ar"></div><div id="fa-two-b" class="ar half"></div></div>
	<div id="fa-padded" class="sf padded"><div id="fa-padded-item" class="ar edges"></div></div>
	<div id="fa-inline" class="sf-inline"><div id="fa-inline-item" class="ar"></div></div>
	<div id="cb-fa-min" class="cb0"><div id="fa-min" class="sf"><div id="fa-min-item" class="ar"></div></div></div>
	<div id="cb-inset" class="cb200"><div id="fa-inset" class="sf-abs inset"><div id="fa-inset-item" class="ar"></div></div></div>
	<div id="cb-pct" class="cb200"><div id="fa-pct" class="sf-abs pct"><div id="fa-pct-item" class="ar"></div></div></div>
	<div id="cb-inset-min" class="cb200"><div id="fa-inset-min" class="sf-abs inset-min"><div class="ar"></div><div class="w10"></div></div></div>
</body>
</rml>
