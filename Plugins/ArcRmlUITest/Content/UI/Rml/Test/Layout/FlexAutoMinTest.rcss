body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 14px;
	color: #e8ecf4;
}

div {
	display: block;
}

.cb0 {
	position: absolute;
	left: 100px;
	width: 0;
	height: 0;
}

.cb400 {
	position: absolute;
	left: 600px;
	width: 400px;
	height: 40px;
}

#cb-cap { top: 20px; }
#cb-border { top: 60px; }
#cb-cap-mix { top: 100px; }
#cb-sum { top: 180px; }
#cb-hidden { top: 220px; }
#cb-max { top: 260px; }
#cb-specified { top: 300px; }
#cb-wide { top: 20px; }
#cb-wide-wrap { top: 80px; }
#cb-dropdown { top: 360px; }
#cb-inline { top: 440px; }

.fx {
	position: absolute;
	left: 0;
	top: 0;
	display: flex;
	background-color: #141821;
}

.fx.wrap {
	flex-wrap: wrap;
}

.item {
	background-color: #3a86ff;
}

.w50 {
	width: 50px;
	height: 20px;
	background-color: #ff006e;
}

.cap { flex: 0 1 40px; }
.raise { flex: 0 0 60px; }

.border-box {
	box-sizing: border-box;
	padding: 0 4px;
	border-left: 2px solid #ffffff;
}

.hidden { overflow: hidden; }
.max45 { max-width: 45px; }
.width70 { width: 70px; }

.mix {
	display: flex;
	flex-wrap: wrap;
}

.w10 {
	flex: none;
	width: 10px;
	height: 10px;
	background-color: #ffbe0b;
}

.menu {
	position: absolute;
	left: 0;
	top: 0;
	display: flex;
	gap: 4px;
	padding: 4px;
	background-color: #1f2937;
	border-radius: 6px;
}

.menu-item {
	flex-basis: 2.5rem;
	padding: 8px 12px;
	font-size: 14px;
	line-height: 20px;
	background-color: #374151;
}

.btn-row {
	display: inline-flex;
	background-color: #111827;
}

.btn {
	flex-basis: 4rem;
	padding: 8px 12px;
	line-height: 20px;
	background-color: #4f46e5;
}
