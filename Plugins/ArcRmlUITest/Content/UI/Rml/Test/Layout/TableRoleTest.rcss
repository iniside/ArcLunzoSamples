body {
	width: 100%;
	height: 100%;
}

.wrap {
	display: block;
	width: 600px;
	height: 40px;
}

.t {
	display: table;
	margin: 0 auto;
}

.t.inline {
	display: inline-table;
}

.t.float {
	float: left;
}

.row {
	display: table-row;
}

.cell {
	display: table-cell;
	width: 100px;
	height: 20px;
}

body { margin: 0; }
