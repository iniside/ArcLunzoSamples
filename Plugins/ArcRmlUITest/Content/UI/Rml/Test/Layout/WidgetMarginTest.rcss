body {
	width: 100%;
	height: 100%;
}

progress {
	display: block;
	position: absolute;
	left: 20px;
	top: 20px;
	width: 200px;
	height: 20px;
	background-color: #141821;
}

progress fill {
	width: 100px;
	margin-left: auto;
	margin-right: auto;
	background-color: #3a86ff;
}

progress.ib {
	top: 60px;
}

progress.ib fill {
	display: inline-block;
}
