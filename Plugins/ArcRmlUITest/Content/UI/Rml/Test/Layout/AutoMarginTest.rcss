body {
	width: 100%;
	height: 100%;
}

div {
	display: block;
}

.cb0 {
	position: absolute;
	left: 100px;
	width: 0;
	height: 0;
}

#cb-abs-both { top: 40px; }
#cb-abs-left { top: 100px; }
#cb-abs-right { top: 160px; }
#cb-abs-vert { top: 220px; }
#cb-stf-min { top: 340px; }

.abs {
	position: absolute;
	left: 0;
	right: 0;
	width: 60px;
	height: 20px;
	background-color: #3a86ff;
}

.abs.vert {
	right: auto;
	top: 0;
	bottom: 0;
	margin-top: auto;
	margin-bottom: auto;
}

.narrow {
	position: absolute;
	left: 300px;
	width: 40px;
	background-color: #141821;
}

.wide {
	position: absolute;
	left: 300px;
	width: 100px;
	background-color: #141821;
}

#cb-flow-both { top: 40px; }
#cb-flow-left { top: 100px; }
#cb-flow-right { top: 160px; }
#cb-flow-fit { top: 220px; }
#cb-flow-min { top: 280px; }
#cb-float { top: 400px; height: 20px; }
#cb-ib { top: 460px; height: 20px; }

.flow {
	width: 60px;
	height: 20px;
	background-color: #ff006e;
}

.flow-min {
	min-width: 70px;
	width: 50px;
	height: 20px;
	background-color: #ffbe0b;
}

.both {
	margin-left: auto;
	margin-right: auto;
}

.left-auto {
	margin-left: auto;
	margin-right: 4px;
}

.right-auto {
	margin-left: 4px;
	margin-right: auto;
}

.stf {
	position: absolute;
	left: 0;
	top: 0;
	background-color: #141821;
}

#stf-max {
	left: 500px;
	top: 40px;
}

.float {
	float: left;
}

.ib {
	display: inline-block;
}

.cb200 {
	position: absolute;
	left: 700px;
	width: 200px;
	height: 100px;
}

#cb-abs-l { top: 20px; }
#cb-abs-r { top: 140px; }
#cb-abs-s { top: 260px; }

.abs-auto {
	position: absolute;
	width: 60px;
	height: 20px;
	margin-left: auto;
	margin-right: auto;
	background-color: #3a86ff;
}

.abs-auto.la {
	right: 0;
}

.abs-auto.ra {
	left: 0;
}
