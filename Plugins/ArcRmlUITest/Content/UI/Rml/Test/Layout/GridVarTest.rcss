body {
	width: 100%;
	height: 100%;
}

div {
	display: block;
}

.grid {
	position: absolute;
	left: 20px;
	width: 200px;
	display: grid;
	grid-template-columns: auto auto;
	background-color: #141821;
}

.a, .b {
	display: flex;
	flex-wrap: wrap;
	align-content: flex-start;
}

.b35, .b41, .b63, .b72 {
	flex: none;
	height: 20px;
	background-color: #ffbe0b;
}

.b35 { width: 35px; }
.b41 { width: 41px; }
.b63 { width: 63px; }
.b72 { width: 72px; }

#v-initial { top: 20px; }
#v-initial > div { --mw: initial; min-width: var(--mw); }
#v-fb-initial { top: 120px; }
#v-fb-initial > div { min-width: var(--nope, initial); }
#v-fb-inherit { top: 220px; }
#v-fb-inherit > div { min-width: var(--nope, inherit); }
#v-zero { top: 320px; }
#v-zero > div { --z: 0px; min-width: var(--z); }
#v-cinherit { top: 420px; }
#v-cinherit > div { --mw: inherit; min-width: var(--mw); }
#v-undef { top: 520px; }
#v-undef > div { min-width: var(--nope); }
