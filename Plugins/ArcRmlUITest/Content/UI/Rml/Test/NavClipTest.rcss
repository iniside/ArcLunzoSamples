body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
	color: #e8ecf4;
}

div {
	display: block;
}

.nc-root {
	position: absolute;
	left: 60px;
	top: 200px;
	width: 600px;
	height: 300px;
	background-color: #141821e8;
}

.nc-left {
	position: absolute;
	left: 20px;
	top: 20px;
	width: 120px;
	height: 90px;
	tab-index: auto;
	nav: auto;
	border: 2px solid #3a4152;
	background-color: #1e2330;
}

.nc-list {
	position: absolute;
	left: 260px;
	top: 80px;
	width: 200px;
	height: 120px;
	overflow-y: auto;
	border: 1px solid #2a3040;
}

.nc-row {
	height: 30px;
	tab-index: auto;
	nav: auto;
	background-color: #1e2330;
}

.nc-row:focus-visible {
	margin-left: 20px;
	background-color: #2c3346;
}

.nc-left:focus-visible {
	margin-left: 20px;
	background-color: #2c3346;
}
