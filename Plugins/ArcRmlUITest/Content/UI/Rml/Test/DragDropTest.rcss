body { margin: 0; width: 100%; height: 100%; font-family: "Space Grotesk"; color: #e8e8ea; }
.dd-root { position: absolute; left: 80px; top: 80px; width: 900px; padding: 24px; background: rgba(16,18,22,0.92); border: 1px solid #3a3d42; border-radius: 10px; }
.dd-help { font-size: 14px; color: #a0a4ab; margin-bottom: 18px; }
.dd-row { display: flex; gap: 24px; }
.dd-panel { display: flex; flex-direction: column; gap: 10px; padding: 14px; border: 1px solid #2a2d32; border-radius: 8px; }
.dd-title { font-size: 15px; font-weight: 600; }
.dd-grid { display: grid; grid-template-columns: repeat(3, 110px); gap: 10px; }
.dd-slot { width: 110px; height: 110px; display: flex; align-items: center; justify-content: center; background: #1c1f23; border: 2px solid #3a3d42; border-radius: 8px; tab-index: auto; nav: auto; }
.dd-wide { width: 260px; height: 70px; font-size: 14px; }
.dd-slot:focus-visible { border-color: #f0c060; }
.dd-slot.drop-over { border-color: #43aa8b; background: #1f3a30; }
.dd-slot.drop-invalid { border-color: #e63946; background: #3a1f22; }
.dd-item { width: 86px; height: 86px; display: flex; align-items: center; justify-content: center; border-radius: 6px; font-size: 14px; font-weight: 600; }
.dd-weapon { background: #2060d0; }
.dd-potion { background: #b0306a; }
.dd-source { drag: clone; }
.dd-source.drag-source .dd-item { opacity: 0.35; }
.dd-source:drag { opacity: 0.8; }
