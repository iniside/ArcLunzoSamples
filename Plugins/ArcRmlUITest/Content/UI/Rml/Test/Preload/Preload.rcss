body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
	color: #e8ecf4;
}

div {
	display: block;
}

@keyframes pLeave {
	from { opacity: 1; }
	to { opacity: 0; }
}

body.leave {
	animation: pLeave .1s linear forwards;
}

.p-row {
	height: 20px;
}

#pf-embed {
	height: 200px;
}
