body {
	width: 100%;
	height: 100%;
	margin: 0;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
	color: #ffffff;
}

.box {
	position: absolute;
	left: 100px;
	width: 100px;
	height: 40px;
	background-color: #4060a0;
}

@keyframes mix {
	from { width: 100px; transform: translateX(-50%); }
	to { width: 200px; transform: translateX(100px); }
}

@keyframes decomposed {
	from { transform: translateX(-50%) skewX(0deg); }
	to { transform: skewX(0deg) translateX(0px); }
}

#mix {
	top: 100px;
	animation: 2s linear mix;
}

#decomposed {
	top: 200px;
	animation: 2s linear decomposed;
}

body.wide #decomposed {
	width: 150px;
}
