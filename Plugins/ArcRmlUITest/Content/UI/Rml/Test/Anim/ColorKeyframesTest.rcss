body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
	color: #ffffff;
}

div {
	display: block;
}

@keyframes tint {
	from { color: #ff2020; }
	to { color: #20ffff; }
}

@keyframes fill {
	from { background-color: #ff2020; }
	to { background-color: #20ffff; }
}

#tint {
	animation: 4s linear tint;
}

.fill {
	width: 40px;
	height: 40px;
	animation: 4s linear fill;
}
