div {
	display: block;
}

body {
	margin: 0;
}

@keyframes grow {
	from { width: 100px; }
	to { width: 300px; }
}

@keyframes pulse {
	from { opacity: 1; }
	to { opacity: 0.5; }
}

#driver {
	width: 40px;
	height: 16px;
	background-color: #775533;
	animation: pulse 1s linear infinite;
}

#grow {
	height: 16px;
	background-color: #335577;
	animation: grow 4s linear forwards;
}

body.hide #grow {
	display: none;
}
