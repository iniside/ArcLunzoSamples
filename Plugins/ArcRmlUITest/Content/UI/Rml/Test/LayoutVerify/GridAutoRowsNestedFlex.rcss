* { box-sizing: border-box; }
div { display: block; }
body { display: block; width: 100%; height: 100%; margin: 0; padding-top: 30px; font-family: 'Space Grotesk', sans-serif; font-size: 12px; line-height: 1.25; color: #e6ebf0; background-color: #0f1318; }
.rb { position: absolute; top: 4px; margin: 0; }
.rb-a { left: 10px; }
.rb-b { left: 40px; }
.rb-anim { left: 70px; }
.grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 4px; width: 600px; padding: 4px; background-color: #151b22; }
#r-b:checked ~ .grid { width: 820px; }
@keyframes grid-w { from { width: 420px; } to { width: 900px; } }
#r-anim:checked ~ .grid { animation: grid-w 1.1s linear infinite alternate; }
.item { border: 1px solid #3fa7ff; padding: 2px; background-color: #1b232c; }
.row { display: flex; flex-direction: row; gap: 3px; align-items: center; }
.col { display: flex; flex-direction: column; gap: 2px; }
.wrap { display: flex; flex-wrap: wrap; gap: 2px; }
.chip { flex: 0 1 auto; padding: 1px 3px; background-color: #2a2f45; }
.grow { flex: 1 1 auto; min-width: 0; background-color: #24303c; }
.icon { flex: none; width: 14px; height: 14px; background-color: #34465a; }
.tail { font-size: 10px; color: #9fb0c2; }
@keyframes sp-h { from { height: 4px; } to { height: 40px; } }
.sp { width: 24px; height: 4px; background-color: #ff7a59; animation: sp-h 0.8s linear infinite alternate; }
