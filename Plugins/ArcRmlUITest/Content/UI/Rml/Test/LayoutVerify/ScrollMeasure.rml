<rml>
<head>
	<title>Layout Verify Scroll Measure Test</title>
	<meta name="layer" content="UI.Layer.Menu"/>
	<meta name="input-mode" content="menu"/>
	<link type="text/rcss" href="ScrollMeasure.rcss"/>
<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Fonts/Fonts.rcss"/></head>
<body>
<div class="root">
	<div class="page">
		<section class="grid2">
			<div class="col"><span class="heading">Other</span><div class="other"></div></div>
			<div class="col">
				<span class="heading">Panel</span>
				<div class="host">
					<div class="panel">
						<div class="header"><span>Recipes</span><span>All</span></div>
						<div class="body" id="list">
							<div class="row"><div class="main"><div class="well"></div><div class="text"><div class="label">Healing Draught</div><div class="sub"><span>Alchemy · click to select</span></div></div></div></div>
							<div class="row"><div class="main"><div class="well"></div><div class="text"><div class="label">Mana Tonic</div><div class="sub"><span>Alchemy · click to select</span></div></div></div></div>
							<div class="row"><div class="main"><div class="well"></div><div class="text"><div class="label">Stamina Brew</div><div class="sub"><span>Alchemy · click to select</span></div></div></div></div>
						</div>
					</div>
				</div>
			</div>
		</section>
	</div>
</div>
</body>
</rml>
