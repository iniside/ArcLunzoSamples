* { box-sizing: border-box; }
div { display: block; }
body { display: block; width: 100%; height: 100%; margin: 0; padding-top: 30px; font-family: 'Space Grotesk', sans-serif; font-size: 12px; line-height: 1.25; color: #e6ebf0; background-color: #0f1318; }
.rel { position: relative; width: 300px; margin: 4px; padding: 4px; border: 1px solid #3fa7ff; background-color: #1b232c; }
.sp { width: 30px; height: 20px; background-color: #ff7a59; }
@keyframes am-m { from { margin-left: 0px; } to { margin-left: 40px; } }
.am { position: absolute; top: 2px; left: 2px; width: 10px; height: 10px; background-color: #c792ea; animation: am-m 0.8s linear infinite alternate; }
@keyframes aw-w { from { width: 10px; } to { width: 50px; } }
.aw { position: absolute; right: 0; top: 0; height: 12px; background-color: #c3e88d; animation: aw-w 0.8s linear infinite alternate; }
.fill { height: 100%; background-color: #82aaff; }
@keyframes ab-b { from { bottom: 0px; } to { bottom: 20px; } }
.ab { position: absolute; left: 0; top: 0; width: 8px; background-color: #ffcb6b; animation: ab-b 0.8s linear infinite alternate; }
.fr { display: flex; width: 300px; margin: 4px; background-color: #151b22; }
.fi { width: 120px; border: 1px solid #3fa7ff; }
.mid { padding: 6px; }
.host { position: relative; width: 300px; height: 60px; margin: 4px; }
.outer { position: absolute; left: 10px; top: 4px; width: 200px; background-color: #24303c; }
