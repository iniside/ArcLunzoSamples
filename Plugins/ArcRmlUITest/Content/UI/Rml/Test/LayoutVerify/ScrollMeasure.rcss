body { display: block; width: 100%; height: 100%; overflow-y: auto; margin: 0; font-family: 'Space Grotesk', sans-serif; font-size: 16px; color: #ffffff; }
div, section { display: block; }
* { box-sizing: border-box; scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.22) transparent; }
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-thumb { background: #808080; }
.root { min-height: 100vh; padding: 48px 56px 80px; }
.page { max-width: 1180px; margin: 0 auto; display: flex; flex-direction: column; gap: 36px; }
.grid2 { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 28px; align-items: start; }
.col { display: flex; flex-direction: column; gap: 12px; }
.heading { font-size: 12px; }
.host { width: 360px; height: 260px; }
.panel { position: relative; width: 100%; height: 100%; display: flex; flex-direction: column; border: 1px solid #404040; }
.header { flex: none; display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 11px 16px; font-size: 12px; }
.body { flex: 1 1 0px; min-height: 0; display: flex; flex-direction: column; gap: 6px; padding: 14px; overflow: auto; }
.row { display: flex; flex-direction: column; padding: 9px 11px; border: 1px solid #505050; }
.main { display: flex; align-items: center; gap: 11px; }
.well { flex: none; width: 28px; height: 28px; }
.text { flex: 1; min-width: 0; }
.label { font-size: 13px; }
.sub { display: flex; gap: 5px; font-size: 10.5px; margin-top: 2px; }
.other { height: 400px; }
