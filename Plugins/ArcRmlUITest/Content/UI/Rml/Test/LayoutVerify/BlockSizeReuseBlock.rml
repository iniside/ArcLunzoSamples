<rml>
<head>
	<title>BlockSizeReuseBlock</title>
	<meta name="layer" content="UI.Layer.Menu"/>
	<meta name="input-mode" content="menu"/>
	<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Test/LayoutVerify/BlockSizeReuse.rcss"/>
<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Fonts/Fonts.rcss"/></head>
<body>
<input type="radio" name="c" id="r-r00" class="rb" style="left: 10px;" checked=""/>
<input type="radio" name="c" id="r-r14" class="rb" style="left: 318px;"/>
<input type="radio" name="c" id="r-r15" class="rb" style="left: 340px;"/>
<input type="radio" name="c" id="r-r16" class="rb" style="left: 362px;"/>
<input type="radio" name="c" id="r-r17" class="rb" style="left: 384px;"/>
<input type="radio" name="c" id="r-r18" class="rb" style="left: 406px;"/>
<div class="case r14"><div class="lbl">r14 block container: flow-root, overflow, inline-block, float, flex, grid and table children</div><div class="row"><div class="E"><div class="froot">flow-root <span class="n">1</span></div><div class="ovh">overflow hidden<div class="mini">m</div></div><div class="ova">overflow auto box with text long enough to scroll inside it a lot</div><div class="ib">ib one</div> <div class="ib">ib two</div></div><div class="E"><div class="fl">float l</div><div class="flr">r</div>text beside the floats wraps here<div class="ovh">bfc next to floats</div><div class="clr"></div><div class="cd"><div class="ic"></div><div class="tx"><div class="nm">Ember</div><div class="sb"><span>rare</span> <span class="n">7</span></div></div></div></div><div class="E"><div class="fcol"><div class="cd"><div class="ic"></div><div class="tx"><div class="nm">Ember</div><div class="sb"><span>rare</span> <span class="n">7</span></div></div></div><div class="cd"><div class="ic"></div><div class="tx"><div class="nm">Storm Caller</div><div class="sb"><span>common drop</span> <span class="n">7</span></div></div></div></div><div class="grid"><div class="cd"><div class="ic"></div><div class="tx"><div class="nm">Ember</div><div class="sb"><span>rare</span> <span class="n">7</span></div></div></div></div><div class="fcol j-c fixh"><div class="cd"><div class="ic"></div><div class="tx"><div class="nm">Ember</div><div class="sb"><span>rare</span> <span class="n">7</span></div></div></div></div></div><div class="E"><table class="tbs"><tr><td class="td">t1</td><td class="td vm">t2</td></tr></table><div class="cd"><div class="ic"></div><div class="tx"><div class="nm">Ember</div><div class="sb"><span>rare</span> <span class="n">7</span></div></div></div><div class="cd"><div class="ic"></div><div class="tx"><div class="nm">Storm Caller</div><div class="sb"><span>common drop</span> <span class="n">7</span></div></div></div></div></div></div>
<div class="case r15"><div class="lbl">r15 block container: absolutes whose containing block is the animating block</div><div class="row"><div class="E rel"><div class="ovh">overflow hidden<div class="absE"></div></div><div class="ib">ib<div class="absS"></div></div><div class="fl">fl<div class="absE2"></div></div><div class="clr"></div><div class="cd"><div class="ic"></div><div class="tx"><div class="nm">Ember</div><div class="sb"><span>rare</span> <span class="n">7</span></div></div></div><div class="froot">flow-root<div class="absI"></div></div></div><div class="E rel"><div class="fcol"><div class="cd"><div class="ic"></div><div class="tx"><div class="nm">Ember</div><div class="sb"><span>rare</span> <span class="n">7</span></div></div></div><div class="absE"></div></div><div class="grid"><div class="cd"><div class="ic"></div><div class="tx"><div class="nm">Ember</div><div class="sb"><span>rare</span> <span class="n">7</span></div></div></div><div class="absE2"></div></div></div></div></div>
<div class="case r16"><div class="lbl">r16 negative block: children read the block size</div><div class="row"><div class="E"><div class="froot ph">flow-root h 30%</div><div class="ovh pmt">margin-top 10%</div><div class="froot pma">auto margin</div><div class="ovh prt">relative top 10%</div></div><div class="E"><div class="ib pmin">ib min-h 20%</div><div class="fl ph">float 30%</div><div class="clr"></div><div class="fcol ph"><div class="cd"><div class="ic"></div><div class="tx"><div class="nm">Ember</div><div class="sb"><span>rare</span> <span class="n">7</span></div></div></div></div></div><div class="E rel"><div class="abs1"></div><div class="cd"><div class="ic"></div><div class="tx"><div class="nm">Ember</div><div class="sb"><span>rare</span> <span class="n">7</span></div></div></div><div class="ovh pmax">max-h 10% tall text that wraps a lot of times in a narrow box</div><div class="abs2"></div></div></div></div>
<div class="case r17"><div class="lbl">r17 nested: percentage-height block wrapper and list markers</div><div class="row"><div class="E"><div class="wrap50"><div class="froot">in wrapper</div><div class="ib">ib</div><div class="cd"><div class="ic"></div><div class="tx"><div class="nm">Ember</div><div class="sb"><span>rare</span> <span class="n">7</span></div></div></div></div><div class="cd"><div class="ic"></div><div class="tx"><div class="nm">Ember</div><div class="sb"><span>rare</span> <span class="n">7</span></div></div></div></div><div class="E"><div class="lst"><div class="li20">one</div><div class="li20">two</div><div class="lin">three</div></div></div></div></div>
<div class="case r18"><div class="lbl">r18 block scroll container: overflow auto animating block</div><div class="row"><div class="E ovf"><div class="cd"><div class="ic"></div><div class="tx"><div class="nm">Ember</div><div class="sb"><span>rare</span> <span class="n">7</span></div></div></div><div class="cd"><div class="ic"></div><div class="tx"><div class="nm">Storm Caller</div><div class="sb"><span>common drop</span> <span class="n">7</span></div></div></div><div class="cd"><div class="ic"></div><div class="tx"><div class="nm">Gilded Crown</div><div class="sb"><span>bound on pickup</span> <span class="n">7</span></div></div></div><div class="froot">flow-root</div><div class="cd"><div class="ic"></div><div class="tx"><div class="nm">Ember</div><div class="sb"><span>rare</span> <span class="n">7</span></div></div></div><div class="cd"><div class="ic"></div><div class="tx"><div class="nm">Storm Caller</div><div class="sb"><span>common drop</span> <span class="n">7</span></div></div></div><div class="cd"><div class="ic"></div><div class="tx"><div class="nm">Gilded Crown</div><div class="sb"><span>bound on pickup</span> <span class="n">7</span></div></div></div><div class="ib">ib</div> <div class="ib">ib2</div></div><div class="E ovf"><div class="fl">fl</div><div class="cd"><div class="ic"></div><div class="tx"><div class="nm">Ember</div><div class="sb"><span>rare</span> <span class="n">7</span></div></div></div><div class="cd"><div class="ic"></div><div class="tx"><div class="nm">Storm Caller</div><div class="sb"><span>common drop</span> <span class="n">7</span></div></div></div><div class="ovh">ovh</div><div class="cd"><div class="ic"></div><div class="tx"><div class="nm">Ember</div><div class="sb"><span>rare</span> <span class="n">7</span></div></div></div><div class="cd"><div class="ic"></div><div class="tx"><div class="nm">Storm Caller</div><div class="sb"><span>common drop</span> <span class="n">7</span></div></div></div></div></div></div>
</body>
</rml>
