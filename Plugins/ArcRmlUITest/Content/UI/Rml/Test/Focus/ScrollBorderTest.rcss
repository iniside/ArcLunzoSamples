body {
	margin: 0;
}

#sb-box {
	margin-left: 40px;
	margin-top: 30px;
	width: 200px;
	height: 100px;
	border: 10px solid rgb(0, 0, 0);
	overflow: hidden;
}

#sb-inner {
	box-sizing: border-box;
	width: 1000px;
	height: 1000px;
	padding-left: 500px;
	padding-top: 500px;
}

#sb-target {
	width: 40px;
	height: 20px;
	tab-index: auto;
}
