body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
	color: #e8ecf4;
}

div {
	display: block;
}

@keyframes rootLeave { from { opacity: 1; } to { opacity: 0; } }
body.leave { animation: rootLeave .2s ease forwards; }

.abt-root {
	position: absolute;
	left: 60px;
	top: 100px;
	width: 400px;
	padding: 20px;
	background-color: #141821e8;
}

.abt-mid, .abt-leaf {
	margin-top: 16px;
	padding-left: 16px;
}

.abt-btn {
	tab-index: auto;
	nav: auto;
	width: 160px;
	height: 40px;
	margin-bottom: 8px;
	background-color: #1e2330;
}

[arc-embed] {
	height: 400px;
}
