body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 12px;
	color: #e8ecf4;
}

div {
	display: block;
}

#list {
	position: absolute;
	left: 20px;
	top: 20px;
	width: 400px;
	height: 200px;
	overflow-y: scroll;
	background-color: #101418;
}

.row {
	width: 300px;
	height: 20px;
	background-color: #202838;
}

.row.mark {
	background-color: #13579b;
}

.a {
	display: inline-block;
	width: 60px;
}

.b {
	display: inline-block;
	width: 30px;
	height: 10px;
	background-color: #3c6aca;
}
