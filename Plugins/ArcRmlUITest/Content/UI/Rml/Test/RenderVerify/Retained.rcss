body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 20px;
	color: #ffffff;
}

div {
	display: block;
	position: absolute;
	width: 60px;
	height: 30px;
}

.stat { top: 10px; }
#s1 { left: 10px; background-color: #101010; }
#s2 { left: 80px; background-color: #202020; }
#s3 { left: 150px; background-color: #303030; }
#s4 { left: 220px; background-color: #404040; }
#s5 { left: 290px; background-color: #505050; }
#s6 { left: 360px; background-color: #606060; }

#cls { left: 10px; top: 60px; background-color: #336699; }
#cls.hot { background-color: #cc3333; }

#txt { left: 100px; top: 60px; width: 150px; color: #12ab34; }

#atr { left: 270px; top: 60px; background-color: #669933; }
#atr[data-mode="b"] { background-color: #993366; }

#hov { left: 340px; top: 60px; background-color: #3366cc; }
#hov:hover { background-color: #cc6633; }

#anc { left: 420px; top: 60px; width: 100px; height: 40px; background-color: #444477; }
#anc.spin { transform: translateX(10px) rotate(3deg); }
#kid { left: 5px; top: 5px; width: 20px; height: 10px; background-color: #aa55aa; }

#clipper { left: 10px; top: 140px; width: 200px; height: 40px; overflow: hidden; background-color: #224422; }
#clipper.narrow { width: 50px; }
#inner { left: 0px; top: 5px; width: 300px; height: 20px; background-color: #88aa22; }

#scr { left: 300px; top: 140px; width: 200px; height: 100px; overflow-y: scroll; background-color: #202838; }
.row { position: static; width: 150px; height: 20px; }
.r0 { background-color: #2a6f6f; }
.r1 { background-color: #6f2a6f; }

#img { position: absolute; left: 560px; top: 140px; width: 20px; height: 20px; }
