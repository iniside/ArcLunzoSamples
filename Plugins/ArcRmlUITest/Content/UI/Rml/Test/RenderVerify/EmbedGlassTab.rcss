body {
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
	color: #e8ecf4;
}

div {
	display: block;
}

.eg-root {
	display: flex;
	gap: 12px;
	height: 100%;
}

.eg-col {
	flex: 1;
	min-height: 0;
	display: flex;
	flex-direction: column;
}

.eg-glass {
	position: relative;
	width: 100%;
	height: 100%;
	display: flex;
	flex-direction: column;
	background: linear-gradient(180deg, #20242c, #101216);
	backdrop-filter: blur(8px);
	border: 1px solid #3a3f4a;
	border-radius: 8px;
	box-shadow: 0px 4px 12px #00000080;
}

.eg-glass::before {
	content: '';
	position: absolute;
	inset: -1px;
	padding: 1px;
	border-radius: inherit;
	pointer-events: none;
	background: linear-gradient(135deg, #b08a48 0%, #ffffff00 50%, #b08a48 100%);
	mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
}

.eg-header {
	display: flex;
	padding: 10px 14px;
}

.eg-body {
	flex: 1;
	min-height: 0;
	display: flex;
	flex-direction: column;
	gap: 6px;
	padding: 14px;
	overflow: auto;
}

.eg-flush {
	flex: 1;
	min-height: 0;
	display: flex;
	flex-direction: column;
}

.eg-item {
	display: block;
}

.eg-row {
	height: 30px;
	background-color: #2a6f6f;
}
