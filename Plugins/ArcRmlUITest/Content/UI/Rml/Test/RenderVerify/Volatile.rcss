body {
	width: 100%;
	height: 100%;
}

div {
	display: block;
	position: absolute;
	width: 100px;
	height: 40px;
}

.stat { top: 10px; }
#s1 { left: 10px; background-color: #101010; }
#s2 { left: 130px; background-color: #202020; }

#shd { left: 40px; top: 80px; background-color: #5a5a00; box-shadow: 0px 0px 8px #ff00ff; }
#shd.big { width: 160px; box-shadow: 0px 0px 20px #ff00ff; }

#behind { left: 300px; top: 70px; width: 260px; height: 60px; background-color: #aa3300; }
#bd { left: 320px; top: 80px; border-radius: 12px; backdrop-filter: blur(4px); background-color: #ffffff33; }
#bd.big { width: 200px; }

#rr { left: 10px; top: 200px; border-radius: 12px; overflow: hidden; background-color: #2244aa; }
#rr.big { width: 160px; }
#rrk { left: 0px; top: 0px; width: 100%; height: 100%; background-color: #ffcc00; }
