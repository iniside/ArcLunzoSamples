body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 20px;
}

div {
	display: block;
}

#line {
	position: absolute;
	left: 20px;
	top: 20px;
	width: 300px;
	height: 40px;
}

#slot {
	display: inline-block;
	width: 40px;
	height: 30px;
	background-color: #303030;
}

.e {
	color: #aa1111;
}

.d {
	color: #11aa11;
}
