body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
	color: #e8ecf4;
}

div {
	display: block;
}

.panel {
	position: absolute;
	left: 40px;
	top: 120px;
	width: 560px;
	padding: 12px;
	background-color: #141821e0;
	border-radius: 8px;
}

.title {
	font-size: 18px;
	margin-bottom: 8px;
}

.row {
	margin-bottom: 8px;
}

.swatch {
	width: 120px;
	padding: 4px 8px;
	margin-bottom: 8px;
	border-radius: 4px;
	color: #141821;
}

.item {
	display: flex;
	flex-direction: row;
	margin-bottom: 4px;
}

.cell {
	width: 180px;
}

.tag {
	margin-right: 8px;
	color: #8890a0;
}

.warning {
	margin-bottom: 8px;
	color: #ffbe0b;
}

.button {
	padding: 8px 12px;
	background-color: #3a86ff;
	border-radius: 6px;
	cursor: pointer;
}
