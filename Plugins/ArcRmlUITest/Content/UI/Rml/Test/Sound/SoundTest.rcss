body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
	color: #e8ecf4;
	--sound-back: "asset:/ArcRmlUITest/UI/Sound/MS_Back.MS_Back";
	--sound-close: "asset:/ArcRmlUITest/UI/Sound/MS_Close.MS_Close";
}

div {
	display: block;
}

.sn-root {
	position: absolute;
	left: 60px;
	top: 100px;
	width: 400px;
	height: 500px;
}

.sn-themed {
	--sound-click: "asset:/ArcRmlUITest/UI/Sound/MS_Click.MS_Click";
	--sound-hover: "asset:/ArcRmlUITest/UI/Sound/MS_Hover.MS_Hover";
	--sound-focus: "asset:/ArcRmlUITest/UI/Sound/MS_Focus.MS_Focus";
}

.sn-focusable {
	position: absolute;
	left: 0px;
	tab-index: auto;
	nav: auto;
	background-color: #1e2330;
}

#sn-btn { top: 0px; width: 200px; height: 60px; }
#sn-gone { top: 80px; width: 200px; height: 60px; }
#sn-group { top: 160px; width: 300px; height: 120px; nav-right: #sn-inner; }
#sn-close { top: 300px; width: 200px; height: 60px; }

#sn-icon {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 60px;
	height: 60px;
	background-color: #334466;
}

#sn-label {
	position: absolute;
	left: 60px;
	top: 0px;
	width: 140px;
	height: 60px;
}

#sn-inner {
	position: absolute;
	left: 150px;
	top: 0px;
	width: 150px;
	height: 120px;
	tab-index: auto;
	nav: auto;
	background-color: #2a3144;
}

#sn-embed {
	position: absolute;
	left: 0px;
	top: 380px;
	width: 400px;
	height: 100px;
}
