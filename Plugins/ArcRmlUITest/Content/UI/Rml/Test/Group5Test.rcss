body {
	width: 100%;
	height: 100%;
	margin: 0;
	background-color: #1a1d23;
}

div {
	display: block;
}

.panel {
	position: absolute;
	left: 20px;
	top: 20px;
	width: 820px;
	height: 660px;
	background-color: #2a2f3a;
}

.cell {
	position: absolute;
	width: 100px;
	height: 100px;
	background-color: #4a5160;
}

/* drop-shadow() in CSS argument order */

.slot-host {
	position: absolute;
	left: 18px;
	top: 18px;
	width: 64px;
	height: 64px;
}

.listrow-host {
	position: absolute;
	left: 34px;
	top: 34px;
}

.icon-host {
	position: absolute;
	left: 24px;
	top: 24px;
	display: flex;
	align-items: center;
	gap: 6px;
}

.shadow-color-first {
	position: absolute;
	left: 25px;
	top: 25px;
	width: 50px;
	height: 50px;
	background-color: #ffffff;
	filter: drop-shadow(#ff006e 4px 4px 0);
}

.shadow-currentcolor {
	position: absolute;
	left: 25px;
	top: 25px;
	width: 50px;
	height: 50px;
	background-color: #e0e0e0;
	color: #2060ff;
	filter: drop-shadow(4px 4px 2px);
}

.stripes {
	background: linear-gradient(90deg, #c87850 0%, #c8b450 20%, #64b464 40%, #50a0c8 60%, #7864c8 80%, #c864a0 100%);
}

.backdrop-shadow {
	position: absolute;
	left: 20px;
	top: 20px;
	width: 60px;
	height: 60px;
	backdrop-filter: drop-shadow(rgba(0,0,0,0.8) 6px 6px 0);
}

/* object-fit and object-position */

.fit {
	position: absolute;
	width: 120px;
	height: 60px;
	border: 1px solid #8090a0;
	background-color: #303844;
}

.fit-svg {
	position: absolute;
	width: 80px;
	height: 80px;
	border: 1px solid #8090a0;
	background-color: #303844;
}

.fill { object-fit: fill; }
.contain { object-fit: contain; }
.cover { object-fit: cover; }
.none { object-fit: none; }
.scale-down { object-fit: scale-down; }

.pos-left-top { object-position: left top; }
.pos-edges { object-position: right 10px bottom 5px; }
.pos-percent { object-position: 25% 75%; }
.pos-top { object-position: top; }
.pos-left-bottom { object-position: left bottom; }

/* Scrollbars: TabMenus v2.dc.html:19-24 verbatim */

* { scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.22) transparent; }
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.18); border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: color-mix(in srgb, var(--accent) 70%, transparent); }
::-webkit-scrollbar-corner { background: transparent; }

.scroller {
	position: absolute;
	width: 140px;
	height: 110px;
	overflow: auto;
	background-color: #3a4150;
}

.scroll-content {
	width: 300px;
	height: 400px;
	background: linear-gradient(135deg, #a05050, #50a050);
}

.webkit-only {
	scrollbar-width: auto;
	scrollbar-color: auto;
}

.standard-colors {
	scrollbar-width: auto;
	scrollbar-color: #e0b050 #303844;
}

.standard-none {
	scrollbar-width: none;
}

.webkit-class {
	scrollbar-width: auto;
	scrollbar-color: auto;
}
.webkit-class::-webkit-scrollbar { width: 12px; height: 12px; }
.webkit-class::-webkit-scrollbar-thumb { background: #e05050; border-radius: 6px; }
.webkit-class::-webkit-scrollbar-corner { background: #f0d060; }

/* saturate() and brightness() in backdrop-filter */

.backdrop {
	position: absolute;
	left: 40px;
	top: 560px;
	width: 700px;
	height: 80px;
}

.backdrop-cell {
	position: absolute;
	top: 10px;
	width: 100px;
	height: 60px;
}

.saturate { backdrop-filter: saturate(1.5); }
.brightness { backdrop-filter: brightness(0.8); }
.saturate-brightness { backdrop-filter: saturate(1.5) brightness(0.8); }
