body {
	width: 100%;
	height: 100%;
}

div {
	display: block;
}

.bg {
	position: absolute;
	width: 620px;
	height: 140px;
}

.white { background-color: rgb(255,255,255); }
.grey { background-color: rgb(128,128,128); }
.orange { background-color: rgb(200,120,60); }

.sw {
	position: absolute;
	width: 100px;
	height: 100px;
}

.k75 { background-color: rgba(0,0,0,0.75); }
.k50 { background-color: rgba(0,0,0,0.5); }
.glasstop { background-color: rgba(14,15,17,0.72); }
.glassbot { background-color: rgba(4,5,6,0.78); }
.blue { background-color: rgb(0,0,255); }
.red50 { background-color: rgba(255,0,0,0.5); }
.bright08 { backdrop-filter: brightness(0.8); }
.sat15 { backdrop-filter: saturate(1.5); }
.satbright { backdrop-filter: saturate(1.5) brightness(0.8); }
.glassnoblur {
	background-color: rgba(14,15,17,0.72);
	backdrop-filter: saturate(1.5) brightness(0.8);
}
.glassfull {
	background: linear-gradient(180deg, rgba(14,15,17,0.72), rgba(4,5,6,0.78));
	backdrop-filter: blur(30px) saturate(1.5) brightness(0.8);
}
