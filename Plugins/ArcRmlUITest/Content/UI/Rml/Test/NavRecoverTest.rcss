body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
	color: #e8ecf4;
}

div {
	display: block;
}

.nrt-root {
	position: absolute;
	left: 60px;
	top: 200px;
	width: 600px;
	height: 400px;
	background-color: #141821e8;
}

.nrt-b {
	position: absolute;
	left: 20px;
	width: 120px;
	height: 40px;
	tab-index: auto;
	nav: auto;
	background-color: #1e2330;
}

.nrt-outer {
	margin-left: 260px;
	margin-top: 100px;
	width: 200px;
	overflow: hidden;
}

.nrt-list {
	width: 200px;
	overflow-y: auto;
}

.nrt-row {
	height: 40px;
	tab-index: auto;
	nav: auto;
	background-color: #1e2330;
}

.nrt-abs {
	position: absolute;
	left: 20px;
	top: 160px;
	width: 120px;
	height: 40px;
	tab-index: auto;
	nav: auto;
	background-color: #1e2330;
}

.nrt-dialog {
	position: absolute;
	left: 50%;
	top: 50%;
	width: 200px;
	transform: translate(-50%, -50%);
	background-color: #2a3040;
}

.nrt-dbtn {
	height: 40px;
	tab-index: auto;
	nav: auto;
	background-color: #1e2330;
}

.nrt-row:focus-visible, .nrt-b:focus-visible, .nrt-abs:focus-visible, .nrt-dbtn:focus-visible {
	margin-left: 20px;
	background-color: #2c3346;
}
