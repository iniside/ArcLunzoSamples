body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 16px;
	color: #e8ecf4;
}

div {
	display: block;
}

.fat-root {
	position: absolute;
	left: 60px;
	top: 80px;
	width: 760px;
	padding: 16px;
	background-color: #141821e8;
	border-radius: 8px;
}

.fat-root .glassbar-column {
	flex-direction: row;
	margin-bottom: 12px;
}

.fat-embed {
	position: relative;
	height: 330px;
}

.fat-tab-root {
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
}

.fat-tab, .fat-button, .fat-cell {
	tab-index: auto;
	nav: auto;
	padding: 8px 12px;
	border: 2px solid #3a4152;
	border-radius: 6px;
	background-color: #1e2330;
}

.fat-tab[selected] {
	border-color: #3a86ff;
	color: #ffffff;
}

.fat-tab:focus-visible, .fat-button:focus-visible, .fat-cell:focus-visible {
	border-color: #ffbe0b;
	background-color: #2c3346;
}

.fat-row {
	display: flex;
	margin-bottom: 12px;
}

.fat-scroll {
	display: flex;
	gap: 16px;
	height: 150px;
	overflow: auto;
	margin-bottom: 12px;
	padding: 4px;
	border: 1px solid #2a3040;
}

.fat-grid {
	display: grid;
	grid-template-columns: 90px 90px 90px;
	gap: 8px;
}

.fat-cell {
	text-align: center;
}

.fat-cell.picked {
	color: #3a86ff;
}

.fat-side {
	display: flex;
	flex-direction: column;
	gap: 8px;
}

.fat-details {
	padding: 8px;
	border: 1px solid #2a3040;
}

.fat-title {
	margin-bottom: 8px;
}

.fat-qty {
	display: flex;
	align-items: center;
	gap: 8px;
	margin-bottom: 8px;
}

.fat-step {
	width: 28px;
	height: 28px;
	text-align: center;
	border: 1px solid #3a4152;
	border-radius: 4px;
}

.fat-qty-value {
	width: 40px;
	text-align: center;
}

.fat-actions {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	gap: 8px;
}
