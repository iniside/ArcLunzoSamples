body {
	width: 100%;
	height: 100%;
	font-family: Roboto;
	font-size: 14px;
	color: #e8ecf2;
}

div, p {
	display: block;
}

.grid {
	position: absolute;
	left: 40px;
	top: 40px;
	width: 1080px;
}

.card {
	float: left;
	width: 160px;
	height: 150px;
	margin: 0 20px 20px 0;
	padding: 12px;
	box-sizing: border-box;
	background-color: #141821cc;
	border: 1px solid #ffffff22;
	border-radius: 10px;
}

.card p {
	margin-top: 8px;
	font-size: 12px;
	color: #aab4c4;
}

.swatch {
	width: 100%;
	height: 80px;
	border-radius: 8px;
}

.linear {
	decorator: linear-gradient(120deg, #ff5f6d, #ffc371);
}

.radial {
	decorator: radial-gradient(circle, #6dd5ed 0%, #2193b0 60%, #0b1f3a 100%);
}

.conic {
	decorator: conic-gradient(from 45deg, #f72585, #7209b7, #3a0ca3, #4cc9f0, #f72585);
}

.repeating {
	decorator: repeating-linear-gradient(45deg, #f9c74f 0px, #f9c74f 8px, #43aa8b 8px, #43aa8b 16px);
}

.shadowed {
	background-color: #4361ee;
	box-shadow: #000a 0px 8px 18px 2px, #4cc9f088 0px 0px 0px 3px;
}

.clip {
	width: 100%;
	height: 80px;
	border-radius: 24px;
	overflow: hidden;
	background-color: #222222;
}

.clip-content {
	width: 200px;
	height: 120px;
	margin-left: -30px;
	margin-top: -20px;
	decorator: linear-gradient(90deg, #06d6a0, #118ab2);
}

.masked {
	decorator: linear-gradient(90deg, #ef476f, #ffd166);
	mask-image: radial-gradient(circle, #000f 40%, #0000 70%);
}

.rotated {
	background-color: #ffd166;
	transform: rotate(15deg) scale(0.8);
}

@keyframes spin {
	from { transform: rotate(0deg); }
	to { transform: rotate(360deg); }
}

.spinner {
	width: 64px;
	height: 64px;
	margin: 8px auto 0 auto;
	border-radius: 32px;
	decorator: conic-gradient(#7bdff200, #7bdff2);
	animation: spin 1.5s linear-in-out infinite;
}

.filtered {
	decorator: linear-gradient(90deg, #ff0000, #00ff00, #0000ff);
	filter: hue-rotate(90deg) brightness(1.2) drop-shadow(#000c 4px 4px 6px);
}

svg {
	display: block;
	width: 64px;
	height: 64px;
	margin: 8px auto 0 auto;
	image-color: #7bdff2;
}

input {
	display: block;
	width: 136px;
	height: 22px;
	margin-top: 24px;
	padding: 2px 6px;
	background-color: #000000aa;
	border: 1px solid #ffffff66;
	border-radius: 4px;
	color: #ffffff;
	font-size: 14px;
	cursor: text;
}

.stripes {
	position: absolute;
	left: 40px;
	top: 400px;
	width: 680px;
	height: 160px;
	decorator: repeating-linear-gradient(90deg, #e63946 0px, #e63946 40px, #f1faee 40px, #f1faee 80px, #457b9d 80px, #457b9d 120px);
}

.glass {
	position: absolute;
	left: 120px;
	top: 430px;
	width: 520px;
	height: 100px;
	padding: 16px;
	box-sizing: border-box;
	border-radius: 16px;
	background-color: #ffffff22;
	border: 1px solid #ffffff55;
	backdrop-filter: blur(10px) saturate(1.8);
}

.glass.scene {
	left: 50%;
	top: 50%;
	width: 360px;
	height: 160px;
	margin-left: -180px;
	margin-top: -80px;
	backdrop-filter: blur(16px) saturate(1.5);
}
