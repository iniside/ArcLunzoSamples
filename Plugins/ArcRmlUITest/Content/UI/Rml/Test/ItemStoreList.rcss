body {
	width: 100%;
	height: 100%;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 14px;
	color: #e8ecf4;
}

div {
	display: block;
}

.panel {
	position: absolute;
	top: 80px;
	left: 40px;
	width: 760px;
	padding: 12px;
	background-color: #141821e8;
	border-radius: 8px;
}

.title {
	font-size: 18px;
	margin-bottom: 8px;
}

.buttons {
	margin-bottom: 8px;
}

.button {
	display: inline-block;
	padding: 4px 10px;
	margin-right: 8px;
	background-color: #2a3346;
	border-radius: 4px;
}

.button:hover {
	background-color: #3d4a66;
}

.scroller {
	height: 600px;
	overflow-y: auto;
	scrollbar-color: #8b8b8b #1c2230;
	padding: 6px;
	background-color: #0b0e14;
}

.row {
	height: 20px;
	line-height: 20px;
	white-space: nowrap;
}

.row span {
	display: inline-block;
}

.idx { width: 40px; color: #ffbe0b; }
.name { width: 260px; }
.stacks { width: 80px; color: #8ecae6; }
.level { width: 80px; }
.slot { width: 160px; }
.eq { width: 60px; color: #90be6d; }
