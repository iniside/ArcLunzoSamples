body {
	width: 100%;
	height: 100%;
}

div {
	display: block;
	position: absolute;
}

.p { width: 140px; height: 90px; top: 20px; background-color: #c8643299; }
.k { left: 70px; top: 0px; width: 70px; height: 90px; background-color: #145ac8cc; }

#a { left: 20px; filter: contrast(1.5) blur(4px) invert(0.8); }
#b { left: 200px; filter: blur(6px) saturate(1.5) brightness(0.8); }
#c { left: 380px; filter: brightness(1.2) contrast(0.7) opacity(0.6); }
#d { left: 560px; filter: hue-rotate(60deg) sepia(0.7); }
#e { left: 740px; filter: sepia(0.5) blur(4px) hue-rotate(90deg); }
#f { left: 920px; filter: grayscale(0.6) invert(0.5) blur(3px); }

#s1 { left: 20px; top: 200px; width: 150px; height: 140px; background-color: #c05030; }
#s2 { left: 170px; top: 200px; width: 350px; height: 140px; background-color: #2060d0; }
#s3 { left: 520px; top: 200px; width: 180px; height: 140px; background-color: #30a050; }
#g1 { left: 60px; top: 220px; width: 220px; height: 100px; background-color: #ffffff26; backdrop-filter: blur(5px) saturate(1.2) brightness(0.8); }
#g2 { left: 400px; top: 220px; width: 220px; height: 100px; background-color: #ffffff26; backdrop-filter: contrast(1.15) blur(5px) invert(0.9); }

.q { top: 400px; width: 120px; height: 80px; background-color: #c86432; }
#h { left: 20px; filter: sepia(1) drop-shadow(8px 8px 0 #2060d0); }
#i { left: 200px; filter: blur(3px) invert(0.25); mask-image: linear-gradient(to right, #000000, #000000); }
#j { left: 380px; filter: invert(0.25); mask-image: linear-gradient(to right, #000000, #000000); }
