body {
	width: 100%;
	height: 100%;
}

div {
	display: block;
	position: absolute;
}

#band { left: 20px; top: 20px; width: 520px; height: 100px; background-color: #3366cc; }
.e { top: 40px; width: 90px; height: 40px; }
#blur { left: 40px; filter: blur(4px); }
#opacity { left: 150px; filter: opacity(0.5); }
#matrix { left: 260px; filter: invert(1); }
#drop { left: 370px; filter: drop-shadow(6px 6px 4px #000000cc); }
#mask { left: 480px; width: 50px; mask-image: linear-gradient(to right, #000000, #00000000); }
#ctl { left: 20px; top: 160px; width: 100px; height: 60px; background-color: #cc3333; filter: blur(4px) invert(1); }
