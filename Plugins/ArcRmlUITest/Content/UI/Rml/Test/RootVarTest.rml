<rml>
<head>
	<title>ArcRmlUI :root Variable Test</title>
	<meta name="layer" content="UI.Layer.Menu"/>
	<meta name="input-mode" content="game"/>
	<link type="text/rcss" href="RootVarTest.rcss"/>
<link type="text/rcss" href="/ArcRmlUITest/UI/Rml/Fonts/Fonts.rcss"/></head>
<body>
	<div class="page">
		<div class="cell">
			<span class="label">:root, [data-theme] colour (gold)</span>
			<div class="swatch accent"></div>
		</div>

		<div class="cell local">
			<span class="label">local override (blue), then [data-theme="dark"] (gold)</span>
			<div class="swatch accent"></div>
			<div data-theme="dark"><div class="swatch accent"></div></div>
		</div>

		<div class="cell">
			<span class="label">:root beats body (green)</span>
			<div class="swatch spec"></div>
		</div>

		<div class="cell">
			<span class="label">.never:root never matches (grey, not red)</span>
			<div class="swatch never"></div>
		</div>

		<div class="cell">
			<span class="label">quoted font vars</span>
			<div class="sans">Space Grotesk 0123 via var(--font-sans)</div>
			<div class="mono">JetBrains Mono 0123 via var(--font-mono)</div>
			<div class="damage">Barlow Condensed 0123 via var(--font-damage)</div>
		</div>

		<div class="cell">
			<span class="label">unquoted var: gap 24px, radius 8px</span>
			<div class="gaprow"><div class="swatch accent"></div><div class="swatch accent"></div><div class="swatch accent"></div></div>
		</div>
	</div>
</body>
</rml>
