<rml>
<head>
	<title>ArcRmlUI Demo Save / Load</title>
	<meta name="layer" content="UI.Layer.Menu"/>
	<meta name="input-mode" content="menu"/>
	<meta name="hide-lower" content="true"/>
	<meta name="keep-alive" content="true"/>
	<meta name="input-mapping" content="/ArcRmlUIDemo/Demo/Input/IMC_ArcDemo_SaveLoad"/>
	<link type="text/rcss" href="/ArcRmlUIDemo/UI/Rml/Demo/tokens.rcss"/>
	<link type="text/rcss" href="/ArcRmlUIDemo/UI/Rml/Fonts/Fonts.rcss"/>
	<link type="text/rcss" href="GameUI.rcss"/>
	<link type="text/rcss" href="SaveLoad.rcss"/>
	<viewmodel name="ui"
		class="/ArcRmlUIDemo/Demo/ViewModels/BP_ArcRmlDemoUIVM.BP_ArcRmlDemoUIVM_C"
		context="VM_ArcRmlDemoUI"/>
	<viewmodel name="saveload"
		class="/ArcRmlUIDemo/Demo/ViewModels/BP_ArcRmlDemoSaveLoadVM.BP_ArcRmlDemoSaveLoadVM_C"
		resolver="/Script/ArcRmlUIDemo.ArcRmlDemoViewModelResolver"/>
</head>
<body data-model="ui"
	data-class-theme-ember="Theme == 'ember'"
	data-class-theme-daylight="Theme == 'daylight'" data-class-theme-slate="Theme == 'slate'" data-class-theme-relic="Theme == 'relic'"
	data-event-back="call('', 'Back'); stopPropagation()"
	data-event-uiaction="callIf(ev.action == 'IA_ArcDemo_DevBar', '', 'ToggleDevBar')">
	<div class="gu-layer">
		<div class="gu-screen" data-model="saveload">
			<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/SceneBackdrop" label="Game scene" dim="strong"/>
			<div class="sl-frame">
				<div class="sl-head">
					<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/Breadcrumb"
						items="{{ Crumbs }}"
						field="crumbs"
						nofocus="{{ true }}"/>
					<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/SectionHeader"
						title="{{ Title }}"
						count="{{ CountLabel }}"
						meta="Profile · Aurelia"
						style="width: 100%">
						<div class="sl-sort" data-focus-area="sort">
							<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/Dropdown"
								data-focus-owner=""
								value="Most recent"
								field="sort"
								style="width: 100%"/>
						</div>
					</dc-import>
				</div>
				<div class="sl-body">
					<div class="sl-list">
						<div class="sl-grid" data-if="Slots.size &gt; 0" data-focus-area="slots" data-focus-primary="">
							<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/SaveSlotCard"
								data-for="slSlot, slSlot_index : Slots"
								state="{{ slSlot.State }}"
								slot-label="{{ slSlot.SlotLabel }}"
								title="{{ slSlot.Title }}"
								location="{{ slSlot.Location }}"
								playtime="{{ slSlot.Playtime }}"
								date="{{ slSlot.Date }}"
								autosave-label="Auto"
								empty-label="Empty slot"
								empty-hint="{{ slSlot.EmptyHint }}"
								corrupted-label="Data corrupted"
								corrupted-hint="This file cannot be read."
								selected="{{ slSlot_index == SelectedSlot }}"
								focusable="{{ true }}"
								autofocus="{{ slSlot_index == SelectedSlot }}"
								data-event-click="call('', 'Activate', slSlot_index)"
								style="width: 100%"/>
						</div>
						<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/EmptyState"
							data-if="Slots.size == 0"
							icon="/ArcRmlUIDemo/UI/Rml/icons/folder-x.svg"
							title="No saved games"
							body="Your saves and autosaves will appear here."
							style="width: 100%">
							<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/Button"
								label="New game"
								icon-left="/ArcRmlUIDemo/UI/Rml/icons/plus.svg"/>
						</dc-import>
					</div>
					<div class="sl-col">
						<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/Panel"
							title="{{ DetailTitle }}"
							subtitle="{{ DetailSlotLabel }}"
							scroll="{{ true }}"
							fill="{{ true }}"
							has-footer="{{ true }}"
							style="width: 100%; height: 100%">
							<div class="sl-thumb">
								<span class="sl-thumb-label">Save screenshot</span>
							</div>
							<div class="sl-stats">
								<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/StatRow"
									data-for="slStat : DetailStats"
									label="{{ slStat.Label }}"
									value="{{ slStat.Value }}"/>
							</div>
							<div slot="footer" class="sl-actions" data-focus-area="actions" data-focus-parent="slots">
								<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/Button"
									label="Delete"
									variant="ghost"
									icon-left="/ArcRmlUIDemo/UI/Rml/icons/trash-2.svg"
									disabled="{{ bNoDelete }}"
									focusable="{{ true }}"
									data-focus-enter="modal"
									data-event-click="callIf(!bNoDelete, '', 'Delete')"/>
								<dc-import data-if="Mode == 'save'"
									name="/ArcRmlUIDemo/UI/Rml/Demo/Components/Button"
									label="{{ PrimaryLabel }}"
									variant="primary"
									icon-left="/ArcRmlUIDemo/UI/Rml/icons/save.svg"
									disabled="{{ bNoPrimary }}"
									focusable="{{ true }}"
									data-event-click="callIf(!bNoPrimary, '', 'Primary')"/>
								<dc-import data-if="Mode != 'save'"
									name="/ArcRmlUIDemo/UI/Rml/Demo/Components/Button"
									label="{{ PrimaryLabel }}"
									variant="primary"
									icon-left="/ArcRmlUIDemo/UI/Rml/icons/play.svg"
									disabled="{{ bNoPrimary }}"
									focusable="{{ true }}"
									data-event-click="callIf(!bNoPrimary, '', 'Primary')"/>
							</div>
						</dc-import>
					</div>
				</div>
				<div class="sl-footer">
					<span class="sl-cloud">Cloud sync · up to date · 2026-10-21 21:41</span>
					<div class="gu-prompts gu-all" data-if="bConfirm"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/PromptBar"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt"
						key-label="{{ ArcKeys.confirm }}"
						label="Confirm"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt"
						key-label="{{ ArcKeys.back }}"
						label="Cancel"/></dc-import></div>
					<div class="gu-prompts gu-default" data-area="slots" data-if="!bConfirm"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/PromptBar"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt"
						key-label="{{ ArcKeys.confirm }}"
						label="{{ Mode == 'save' ? 'Save' : 'Load' }}"
						disabled="{{ bNoPrimary }}"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt"
						key-label="{{ ArcKeys.IA_ArcDemo_Delete }}"
						label="Delete"
						disabled="{{ bNoDelete }}"
						data-hotkey="IA_ArcDemo_Delete"
						data-focus-enter="modal"
						data-event-click="callIf(!bNoDelete, '', 'Delete')"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt"
						key-label="{{ ArcKeys.back }}"
						label="Back"/></dc-import></div>
					<div class="gu-prompts" data-area="actions" data-if="!bConfirm"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/PromptBar"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt"
						key-label="{{ ArcKeys.confirm }}"
						label="Select"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt"
						key-label="{{ ArcKeys.IA_ArcDemo_Delete }}"
						label="Delete"
						disabled="{{ bNoDelete }}"
						data-hotkey="IA_ArcDemo_Delete"
						data-focus-enter="modal"
						data-event-click="callIf(!bNoDelete, '', 'Delete')"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt"
						key-label="{{ ArcKeys.back }}"
						label="Back"/></dc-import></div>
					<div class="gu-prompts" data-area="sort" data-if="!bConfirm"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/PromptBar"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt"
						key-label="{{ ArcKeys.back }}"
						label="Back"/></dc-import></div>
				</div>
			</div>
			<div class="gu-area" data-if="bConfirm" data-focus-area="modal" data-focus-contain="">
				<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/Modal"
					backdrop="{{ true }}"
					variant="danger"
					title="Delete this save?"
					body="{{ ConfirmBody }}"
					buttons="{{ ConfirmButtons }}"
					focused="{{ 0 }}"/>
			</div>
		</div>
	</div>
	<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/DevBar" data-if="DevOpen"/>
</body>
</rml>
