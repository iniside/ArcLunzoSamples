<rml>
<head>
	<title>ArcRmlUI Demo Settings</title>
	<meta name="layer" content="UI.Layer.Menu"/>
	<meta name="input-mode" content="menu"/>
	<meta name="hide-lower" content="true"/>
	<meta name="keep-alive" content="true"/>
	<meta name="input-mapping" content="/ArcRmlUIDemo/Demo/Input/IMC_ArcDemo_Settings"/>
	<link type="text/rcss" href="/ArcRmlUIDemo/UI/Rml/Demo/tokens.rcss"/>
	<link type="text/rcss" href="/ArcRmlUIDemo/UI/Rml/Fonts/Fonts.rcss"/>
	<link type="text/rcss" href="GameUI.rcss"/>
	<link type="text/rcss" href="Settings.rcss"/>
	<viewmodel name="ui" class="/ArcRmlUIDemo/Demo/ViewModels/BP_ArcRmlDemoUIVM.BP_ArcRmlDemoUIVM_C" context="VM_ArcRmlDemoUI"/>
	<viewmodel name="settings" class="/ArcRmlUIDemo/Demo/ViewModels/BP_ArcRmlDemoSettingsVM.BP_ArcRmlDemoSettingsVM_C" resolver="/Script/ArcRmlUIDemo.ArcRmlDemoViewModelResolver"/>
</head>
<body data-model="ui" data-class-theme-ember="Theme == 'ember'" data-class-theme-daylight="Theme == 'daylight'" data-class-theme-slate="Theme == 'slate'" data-class-theme-relic="Theme == 'relic'" data-event-back="call('', 'Back'); stopPropagation()" data-event-uiaction="callIf(ev.action == 'IA_ArcDemo_DevBar', '', 'ToggleDevBar')">
	<div class="gu-layer">
		<div class="gu-screen">
			<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/SceneBackdrop" label="Game scene" dim="strong"/>
			<div class="st-frame" data-model="settings" data-event-back="call('', 'Back'); stopPropagation()">
				<div class="st-head">
					<div class="st-titles">
						<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/Breadcrumb" items="{{ Crumbs }}" field="crumbs" nofocus="{{ true }}"/>
						<span class="st-title">Settings</span>
					</div>
					<div class="st-search" data-focus-area="search">
						<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/SearchField" value="{{ Query }}" placeholder="Search settings" field="search" style="width: 100%"/>
					</div>
				</div>
				<div class="gu-cycle">
					<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/TabBar" tabs="{{ Tabs }}" active="{{ ActiveTab }}" prompts="{{ true }}" area="main" nofocus="{{ true }}" data-hotkey-cycle="IA_ArcDemo_PrevTab IA_ArcDemo_NextTab" style="width: 100%"/>
				</div>
				<div class="st-body">
					<div class="st-col">
						<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/Panel" scroll="{{ true }}" fill="{{ true }}" style="width: 100%; height: 100%">
							<div class="gu-area" data-focus-area="rows" data-focus-primary="">
								<div class="st-group" data-for="stGroup : Groups">
									<div class="st-divider">
										<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/Divider" label="{{ stGroup.Title }}"/>
									</div>
									<div class="gu-area" data-for="stRow : stGroup.Rows" data-attr-data-focus-enter="stRow.Type == 'dropdown' ? 'dropdown' : (stRow.Type == 'keybind' ? 'stkey' + stRow.Row : ((stRow.Type == 'text' &amp;&amp; ArcKeys.scheme != 'gamepad') ? 'sttext' + stRow.Row : ''))">
										<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/SettingRow" data-focus-owner="" label="{{ stRow.Label }}" description="{{ stRow.Description }}" changed="{{ stRow.bChanged }}" disabled="{{ stRow.bLocked }}" tag="{{ stRow.Tag }}" tag-tone="{{ stRow.TagTone }}" field="{{ stRow.Field }}" nofocus="{{ stRow.Type == 'slider' }}" steps="{{ stRow.Type == 'stepper' || stRow.Type == 'radio' || stRow.Type == 'toggle' || stRow.Type == 'checkbox' }}" autofocus="{{ stRow.Row == SelectedRow &amp;&amp; stRow.Type != 'slider' }}" data-event-click="call('', 'Activate', stRow.Field)" data-event-back="callIf(stRow.KeyState == 'listening', '', 'KeybindCancel', stRow.Field); stopPropagation(stRow.KeyState == 'listening')" data-event-uiaction="callIf(stRow.KeyState != 'listening' &amp;&amp; ev.action == 'IA_ArcDemo_Reset', '', 'FieldReset', stRow.Field); stopPropagation((stRow.KeyState == 'listening' &amp;&amp; ev.action != 'IA_ArcDemo_DevBar') || ev.action == 'IA_ArcDemo_Reset' || (stRow.bOpen &amp;&amp; (ev.action == 'IA_ArcDemo_PrevTab' || ev.action == 'IA_ArcDemo_NextTab')))" style="width: 100%">
											<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/Toggle" data-if="stRow.Type == 'toggle'" on="{{ stRow.bOn }}" on-label="On" off-label="Off" disabled="{{ stRow.bLocked }}" data-event-click="callIf(!stRow.bLocked, '', 'Activate', stRow.Field); stopPropagation()"/>
											<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/Slider" data-if="stRow.Type == 'slider'" value="{{ stRow.Value }}" min="{{ stRow.Min }}" max="{{ stRow.Max }}" step="{{ stRow.Step }}" value-label="{{ stRow.ValueLabel }}" disabled="{{ stRow.bLocked }}" autofocus="{{ stRow.Row == SelectedRow }}" field="{{ stRow.Field }}" style="width: 100%"/>
											<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/Stepper" data-if="stRow.Type == 'stepper'" value="{{ stRow.ValueLabel }}" index="{{ stRow.Index }}" count="{{ stRow.Count }}" disabled="{{ stRow.bLocked }}" field="{{ stRow.Field }}" nofocus="{{ true }}" style="width: 100%"/>
											<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/Dropdown" data-if="stRow.Type == 'dropdown'" value="{{ stRow.ValueLabel }}" options="{{ stRow.Options }}" selected-index="{{ stRow.Index }}" highlight-index="{{ -1 }}" open="{{ stRow.bOpen }}" disabled="{{ stRow.bLocked }}" field="{{ stRow.Field }}" nofocus="{{ true }}" style="width: 100%"/>
											<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/RadioGroup" data-if="stRow.Type == 'radio'" options="{{ stRow.Options }}" value="{{ stRow.Index }}" disabled="{{ stRow.bLocked }}" field="{{ stRow.Field }}"/>
											<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/Checkbox" data-if="stRow.Type == 'checkbox'" label="{{ stRow.ValueLabel }}" checked="{{ stRow.bOn }}" disabled="{{ stRow.bLocked }}" data-event-click="callIf(!stRow.bLocked, '', 'Activate', stRow.Field); stopPropagation()"/>
											<div class="gu-area" data-if="stRow.Type == 'text'"><div class="gu-area" data-attr-data-focus-area="'sttext' + stRow.Row" data-focus-parent="rows">
												<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/TextField" value="{{ stRow.ValueLabel }}" placeholder="{{ stRow.Placeholder }}" disabled="{{ stRow.bLocked }}" field="{{ stRow.Field }}" style="width: 100%"/>
											</div></div>
											<div class="gu-area" data-if="stRow.Type == 'keybind'"><div class="gu-area" data-attr-data-focus-area="'stkey' + stRow.Row" data-focus-parent="rows" data-event-back="callIf(stRow.KeyState == 'listening', '', 'KeybindCancel', stRow.Field); stopPropagation(stRow.KeyState == 'listening')">
												<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/KeybindField" key-label="{{ stRow.ValueLabel }}" state="{{ stRow.KeyState }}" listening-label="Press a key…" unbound-label="Unbound" conflict-label="{{ stRow.ConflictLabel }}" disabled="{{ stRow.bLocked }}" field="{{ stRow.Field }}" style="width: 100%"/>
											</div></div>
										</dc-import>
									</div>
								</div>
							</div>
						</dc-import>
					</div>
					<div class="st-col">
						<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/Panel" title="{{ DetailLabel }}" icon="/ArcRmlUIDemo/UI/Rml/icons/info.svg" scroll="{{ true }}" fill="{{ true }}" style="width: 100%; height: 100%">
							<div class="st-preview">
								<span class="st-preview-label">{{ DetailPreview }}</span>
							</div>
							<p class="st-long">{{ DetailLong }}</p>
							<div class="st-stats">
								<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/StatRow" label="Current" value="{{ DetailCurrent }}"/>
								<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/StatRow" label="Default" value="{{ DetailDefault }}"/>
								<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/StatRow" label="Performance impact">
									<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/Badge" label="{{ DetailImpact }}" tone="{{ DetailImpactTone }}"/>
								</dc-import>
							</div>
						</dc-import>
					</div>
				</div>
				<div class="st-footer">
					<span class="st-changes"><span class="st-dot"></span>{{ ChangesLabel }}</span>
					<div class="gu-prompts gu-all" data-if="bListening"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/PromptBar"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="Any key" glyph="—" label="Bind"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.back }}" label="Cancel"/></dc-import></div>
					<div class="gu-prompts gu-default" data-if="!bListening &amp;&amp; !bDropdownOpen"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/PromptBar"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.confirm }}" label="Change"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="← →" glyph="← →" label="Change"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.IA_ArcDemo_Apply }}" label="Apply" disabled="{{ !bCanApply }}" data-hotkey="IA_ArcDemo_Apply" data-event-click="call('', 'Apply')"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.back }}" label="Back"/></dc-import></div>
					<div class="gu-prompts" data-area="rows" data-if="!bListening &amp;&amp; !bDropdownOpen"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/PromptBar"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.confirm }}" label="Change"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="← →" glyph="← →" label="Change"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.IA_ArcDemo_Reset }}" label="Reset to default" disabled="{{ !bCanReset }}"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.IA_ArcDemo_Apply }}" label="Apply" disabled="{{ !bCanApply }}" data-hotkey="IA_ArcDemo_Apply" data-event-click="call('', 'Apply')"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.back }}" label="Back"/></dc-import></div>
					<div class="gu-prompts" data-area="search" data-if="!bListening &amp;&amp; !bDropdownOpen"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/PromptBar"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.confirm }}" label="Search"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.back }}" label="Back"/></dc-import></div>
					<div class="gu-prompts gu-all" data-if="!bListening &amp;&amp; bDropdownOpen"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/PromptBar"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.confirm }}" label="Select"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="↑↓" glyph="D-pad" label="Choose"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.back }}" label="Close"/></dc-import></div>
				</div>
			</div>
		</div>
	</div>
	<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/DevBar" data-if="DevOpen"/>
</body>
</rml>
