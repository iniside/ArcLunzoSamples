.vd-frame {
	position: relative;
	height: 100%;
	box-sizing: border-box;
	display: grid;
	grid-template-rows: auto auto minmax(0, 1fr) auto;
	gap: var(--ui-space-4);
	padding: clamp(24px, 3.5vw, 72px);
}

.vd-head {
	display: flex;
	align-items: flex-end;
	justify-content: space-between;
	gap: var(--ui-space-4);
	flex-wrap: wrap;
}

.vd-who {
	display: flex;
	align-items: center;
	gap: var(--ui-space-4);
}

.vd-titles {
	display: flex;
	flex-direction: column;
	gap: var(--ui-space-2);
}

.vd-role {
	font-family: var(--ui-font-mono);
	font-size: var(--ui-fs-1);
	letter-spacing: 0.12em;
	text-transform: uppercase;
	color: var(--ui-text-muted);
}

.vd-name {
	font-family: var(--ui-font-display);
	font-size: var(--ui-fs-6);
	font-weight: 700;
	line-height: 1;
	text-transform: var(--ui-display-case);
	letter-spacing: var(--ui-display-tracking);
	text-shadow: var(--ui-text-glow);
}

.vd-body {
	display: grid;
	grid-template-columns: minmax(0, 1fr) minmax(360px, 25%) minmax(0, 0.8fr);
	gap: var(--ui-space-5);
	min-height: 0;
}

.vd-col {
	display: flex;
	min-height: 0;
	min-width: 0;
}

.vd-stock {
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(84px, 1fr));
	gap: var(--ui-space-3);
}

.vd-cell {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: var(--ui-space-1);
	min-width: 0;
}

.vd-qty {
	display: flex;
	flex-direction: column;
	gap: var(--ui-space-2);
}

.vd-label {
	font-size: var(--ui-fs-2);
	color: var(--ui-text-muted);
}

.vd-rows {
	display: flex;
	flex-direction: column;
}

.vd-total {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: var(--ui-space-3);
	padding: var(--ui-space-3) var(--ui-space-4);
	border-radius: var(--ui-radius-md);
	background: var(--ui-surface);
	border: 1px solid var(--ui-border);
}

.vd-total-label {
	font-family: var(--ui-font-display);
	font-size: var(--ui-fs-3);
	font-weight: 700;
	text-transform: var(--ui-display-case);
	letter-spacing: var(--ui-display-tracking);
}

.vd-footer-slot {
	display: flex;
	width: 100%;
}

.vd-bag {
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(60px, 1fr));
	gap: var(--ui-space-2);
}

.vd-footer {
	display: flex;
	justify-content: flex-end;
	align-items: center;
	gap: var(--ui-space-4);
	flex-wrap: wrap;
	border-top: 1px solid var(--ui-border);
	padding-top: var(--ui-space-4);
}
