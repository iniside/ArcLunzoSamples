.hb-frame {
	position: absolute;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	box-sizing: border-box;
	display: grid;
	grid-template-rows: auto minmax(0, 1fr);
	grid-template-columns: minmax(0, 1fr);
	gap: var(--ui-space-4);
	padding: clamp(24px, 3.5vw, 72px);
}

.hb-embed {
	position: relative;
	min-height: 0;
	min-width: 0;
}
