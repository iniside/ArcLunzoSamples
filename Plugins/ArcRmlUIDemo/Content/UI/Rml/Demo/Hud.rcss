html, body { margin: 0; padding: 0; height: 100%; background: transparent; }

[data-hud-dock] { display: flex; flex-direction: column; min-width: 0; min-height: 0; gap: var(--ui-space-3); }

[data-hud-dock="tl"] { grid-area: tl; align-items: flex-start; justify-content: flex-start; }

[data-hud-dock="tc"] { grid-area: tc; align-items: center; justify-content: flex-start; justify-self: center; width: 100%; max-width: calc((var(--hud-vw) - 2 * var(--hud-safe)) * 0.4); }

[data-hud-dock="tr"] { grid-area: tr; align-items: flex-end; justify-content: flex-start; }

[data-hud-dock="ml"] { grid-area: ml; align-items: flex-start; justify-content: center; }

[data-hud-dock="c"] { grid-area: c; align-items: center; justify-content: center; justify-self: center; max-width: calc((var(--hud-vw) - 2 * var(--hud-safe)) * 0.4); }

[data-hud-dock="mr"] { grid-area: mr; align-items: flex-end; justify-content: center; }

[data-hud-dock="bl"] { grid-area: bl; align-items: flex-start; justify-content: flex-end; }

[data-hud-dock="bc"] { grid-area: bc; align-items: center; justify-content: flex-end; justify-self: center; max-width: calc((var(--hud-vw) - 2 * var(--hud-safe)) * 0.6); }

[data-hud-dock="br"] { grid-area: br; align-items: flex-end; justify-content: flex-end; }

[data-hud-row="frames"] { display: flex; flex-direction: row; flex-wrap: wrap; align-items: flex-start; gap: var(--ui-space-3); width: 100%; min-width: 0; }

[data-hud-row="bars"] { display: flex; flex-direction: row; flex-wrap: wrap-reverse; justify-content: center; align-items: flex-end; gap: var(--ui-space-3); min-width: 0; max-width: 100%; }

[data-hud-row="feed"] { display: flex; flex-direction: row; flex-wrap: wrap; justify-content: flex-end; align-items: flex-end; gap: var(--ui-space-3); min-width: 0; max-width: 100%; }

[data-hud-cell] { display: flex; flex-direction: column; min-width: 0; max-width: 100%; }

[data-hud-cell="player"] { width: 340px; max-width: 100%; flex: 0 1 auto; }

[data-hud-cell="target"] { width: 300px; max-width: 100%; flex: 0 1 auto; }

[data-hud-anchors="on"] [data-hud-dock] { border: 1px dashed var(--ui-accent); }

@media (max-aspect-ratio: 3/2) { [data-hud-row="frames"] { flex-direction: column; } [data-hud-row="feed"] { flex-direction: column; align-items: flex-end; } }

[data-hud-aspect="narrow"] [data-hud-row="frames"] { flex-direction: column; }

[data-hud-aspect="narrow"] [data-hud-row="feed"] { flex-direction: column; align-items: flex-end; }

.dk-hud {
	position: relative;
	width: 100%;
	height: 100vh;
	min-height: 480px;
	overflow: hidden;
	--hud-safe: 32px;
	--ui-text: var(--hud-text);
	--ui-text-muted: var(--hud-text-muted);
	--ui-surface: var(--hud-plate);
	--ui-surface-2: var(--hud-plate-2);
	--ui-border: var(--hud-stroke);
	--ui-border-strong: var(--hud-stroke-strong);
}

.dk-hud.safe-0 {
	--hud-safe: 0px;
}

.dk-hud.safe-64 {
	--hud-safe: 64px;
}

.dk-hud-e3 {
	position: absolute;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	overflow: hidden;
	pointer-events: none;
}

.dk-hud-regions {
	position: absolute;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	box-sizing: border-box;
	padding: var(--hud-safe);
	display: grid;
	grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
	grid-template-rows: auto minmax(0, 1fr) auto;
	grid-template-areas: "tl tc tr" "ml c mr" "bl bc br";
	column-gap: var(--ui-space-4);
	row-gap: var(--ui-space-4);
}

.dk-hud-dim {
	transition: opacity var(--ui-dur-fast) var(--ui-ease);
}

.dk-hud-e14 {
	width: 100%;
}

.dk-hud-e16 {
	width: 100%;
}

.dk-hud-e19 {
	width: 100%;
	align-items: center;
}

[data-hud-cell] > .sc-host { display: contents; }

.dk-hud-e21 {
	width: 100%;
	align-items: center;
}

.dk-hud-e24 {
	align-items: flex-end;
	gap: var(--hud-space-xs);
}

.dk-hud-zone-s {
	font-family: var(--ui-font-display);
	font-size: var(--ui-fs-3);
	font-weight: 700;
	text-transform: var(--ui-display-case);
	letter-spacing: var(--ui-display-tracking);
	color: var(--hud-text);
	text-shadow: var(--hud-text-shadow);
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
	max-width: 100%;
}

.dk-hud-time-s {
	font-family: var(--ui-font-mono);
	font-size: var(--ui-fs-2);
	color: var(--hud-text);
	text-shadow: var(--hud-text-shadow);
}

.dk-hud-e27 {
	width: 100%;
	align-items: flex-end;
}

.dk-hud-banners-s {
	align-items: center;
	gap: var(--ui-space-2);
}

.dk-hud-e32 {
	align-items: center;
}

.dk-hud-e37 {
	width: 100%;
	align-items: center;
}

.dk-hud-e47 {
	width: 100%;
	max-width: 380px;
}

.dk-hud-e50 {
	align-items: flex-end;
}

.dk-hud-prompt-s {
	align-items: flex-end;
	max-width: 100%;
	padding: var(--ui-space-1) var(--ui-space-2);
	box-sizing: border-box;
	border-radius: var(--hud-radius);
	background: var(--hud-plate);
	border: 1px solid var(--hud-stroke);
	box-shadow: var(--hud-plate-shadow);
}

.dk-hud-m {
	display: flex;
	flex-direction: column;
	align-items: inherit;
	gap: inherit;
	min-width: 0;
	max-width: 100%;
}
