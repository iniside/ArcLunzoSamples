@keyframes ui-banner-in {
	0% { opacity: 0; transform: scale(1.08); }
	100% { opacity: 1; transform: scale(1); }
}

.mr-frame {
	position: relative;
	height: 100%;
	box-sizing: border-box;
	display: grid;
	grid-template-rows: auto minmax(0, 1fr) auto;
	gap: var(--ui-space-5);
	padding: clamp(24px, 3.5vw, 72px);
}

.mr-band {
	--band-c: var(--ui-accent);
	position: relative;
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: var(--ui-space-2);
	padding: var(--ui-space-4) 0;
	background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--ui-accent) 18%, transparent) 30%, color-mix(in srgb, var(--ui-accent) 18%, transparent) 70%, transparent);
}

.mr-band.defeat {
	--band-c: var(--ui-danger);
	background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--ui-danger) 18%, transparent) 30%, color-mix(in srgb, var(--ui-danger) 18%, transparent) 70%, transparent);
}

.mr-band::before {
	content: '';
	position: absolute;
	left: 10%;
	right: 10%;
	top: 0;
	height: 1px;
	background: linear-gradient(90deg, transparent, var(--band-c), transparent);
}

.mr-band::after {
	content: '';
	position: absolute;
	left: 10%;
	right: 10%;
	bottom: 0;
	height: 1px;
	background: linear-gradient(90deg, transparent, var(--band-c), transparent);
}

.mr-mode {
	font-family: var(--ui-font-mono);
	font-size: var(--ui-fs-2);
	letter-spacing: 0.14em;
	text-transform: uppercase;
	color: var(--ui-text-muted);
}

.mr-banner {
	font-family: var(--ui-font-display);
	font-size: var(--ui-fs-7);
	font-weight: 700;
	line-height: 1;
	text-transform: uppercase;
	letter-spacing: 0.12em;
	color: var(--ui-accent);
	text-shadow: 0 0 32px color-mix(in srgb, var(--ui-accent) 55%, transparent);
	animation: ui-banner-in 600ms cubic-bezier(0.2,0.7,0.2,1);
}

.mr-banner.defeat {
	color: var(--ui-danger);
	text-shadow: 0 0 32px color-mix(in srgb, var(--ui-danger) 55%, transparent);
}

.mr-score {
	display: flex;
	align-items: center;
	gap: var(--ui-space-4);
	font-family: var(--ui-font-mono);
	font-size: var(--ui-fs-5);
	font-weight: 600;
}

.mr-score-a {
	color: var(--ui-accent);
}

.mr-vs {
	color: var(--ui-text-muted);
	font-size: var(--ui-fs-3);
}

.mr-score-b {
	color: var(--ui-danger);
}

.mr-body {
	display: grid;
	grid-template-columns: minmax(0, 1fr) minmax(340px, 26%);
	gap: var(--ui-space-5);
	min-height: 0;
}

.mr-teams {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(460px, 1fr));
	gap: var(--ui-space-5);
	min-height: 0;
	overflow-y: auto;
	overflow-x: hidden;
	align-content: start;
}

.mr-rows {
	display: flex;
	flex-direction: column;
	gap: 2px;
	padding: var(--ui-space-3) var(--ui-space-4) var(--ui-space-4);
}

.mr-side {
	display: flex;
	flex-direction: column;
	gap: var(--ui-space-5);
	min-height: 0;
	min-width: 0;
	overflow-y: auto;
	overflow-x: hidden;
}

.mr-mvp {
	display: flex;
	align-items: center;
	gap: var(--ui-space-4);
}

.mr-mvp-text {
	display: flex;
	flex-direction: column;
	gap: var(--ui-space-1);
	min-width: 0;
}

.mr-mvp-name {
	font-family: var(--ui-font-display);
	font-size: var(--ui-fs-5);
	font-weight: 700;
	text-transform: var(--ui-display-case);
	letter-spacing: var(--ui-display-tracking);
	color: var(--ui-rarity-legendary);
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.mr-mvp-sub {
	font-size: var(--ui-fs-2);
	color: var(--ui-text-muted);
}

.mr-stats {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: var(--ui-space-2);
}

.mr-stat {
	display: flex;
	flex-direction: column;
	gap: 2px;
	padding: var(--ui-space-2) var(--ui-space-3);
	border-radius: var(--ui-radius-md);
	background: var(--ui-surface);
	border: 1px solid var(--ui-border);
	min-width: 0;
}

.mr-stat-value {
	font-family: var(--ui-font-mono);
	font-size: var(--ui-fs-4);
	font-weight: 600;
	color: var(--ui-text);
}

.mr-stat-label {
	font-size: var(--ui-fs-1);
	color: var(--ui-text-muted);
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.mr-rewards {
	display: flex;
	flex-wrap: wrap;
	gap: var(--ui-space-2);
}

.mr-footer {
	display: flex;
	justify-content: space-between;
	align-items: center;
	gap: var(--ui-space-4);
	flex-wrap: wrap;
	border-top: 1px solid var(--ui-border);
	padding-top: var(--ui-space-4);
}

.mr-actions {
	display: flex;
	gap: var(--ui-space-3);
	flex-wrap: wrap;
}
