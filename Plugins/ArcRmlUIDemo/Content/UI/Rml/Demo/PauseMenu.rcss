.pm-frame {
	position: relative;
	height: 100%;
	box-sizing: border-box;
	display: flex;
	align-items: center;
	justify-content: center;
	padding: clamp(24px, 4vw, 72px);
}

.pm-col {
	width: min(480px, 100%);
	max-height: 100%;
	min-height: 0;
	display: flex;
	flex-direction: column;
}

.pm-items {
	display: flex;
	flex-direction: column;
	gap: var(--ui-space-1);
	margin: 0 calc(var(--ui-space-3) * -1);
}

.pm-footer {
	width: 100%;
}

.pm-toast {
	position: absolute;
	right: clamp(24px, 4vw, 72px);
	bottom: clamp(24px, 4vw, 72px);
	width: min(420px, calc(100% - 48px));
}
