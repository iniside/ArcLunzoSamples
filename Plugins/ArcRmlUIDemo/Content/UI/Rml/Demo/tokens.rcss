  --ui-blur: 0px;
  --ui-ease: cubic-bezier(0.3,0.6,0.2,1);
  --ui-panel-bg: linear-gradient(180deg, #13261d, #0b1813);
  --ui-scene-bg: radial-gradient(ellipse at 40% 30%, #1f3d2e 0%, #0c1a14 45%, #040907 100%);
  --ui-thumb-bg: linear-gradient(135deg, #24412f, #10211a 55%, #2d2a16);
  --ui-rarity-common: #d6ccb0;
  --ui-rarity-uncommon: #8fcf6a;
  --ui-rarity-rare: #72aaea;
  --ui-rarity-epic: #c48ee9;
  --ui-rarity-legendary: #f0a640;
  --ui-online: #97c46f;
  --ui-away: #e6ac3f;
  --ui-busy: #e0684d;
  --ui-offline: #6f7a68;
  --ui-ornament: 2;
  --ui-ornament-color: #c9a24e;
  --ui-ornament-1: 1;
  --ui-ornament-2: 1;
}
html, body {
  margin: 0;
  padding: 0;
  height: 100%;
}
body {
  background: var(--ui-bg);
  color: var(--ui-text);
  font-family: var(--ui-font-body);
  font-size: var(--ui-fs-3);
}
