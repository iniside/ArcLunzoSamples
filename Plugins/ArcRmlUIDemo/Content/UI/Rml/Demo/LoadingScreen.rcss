@keyframes ui-pulse {
	0% { opacity: 1; }
	50% { opacity: 0.4; }
	100% { opacity: 1; }
}

.ld-scrim {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 60%;
	background: linear-gradient(180deg, transparent, var(--ui-scrim));
}

.ld-frame {
	position: relative;
	height: 100%;
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
	justify-content: space-between;
	gap: var(--ui-space-6);
	padding: clamp(24px, 4.5vw, 88px);
}

.ld-bottom {
	display: grid;
	grid-template-columns: minmax(0, 1fr) minmax(280px, 520px);
	align-items: end;
	gap: var(--ui-space-6);
}

.ld-progress {
	display: flex;
	flex-direction: column;
	gap: var(--ui-space-3);
}

.ld-step {
	display: flex;
	align-items: center;
	gap: var(--ui-space-2);
	color: var(--ui-text-muted);
	font-family: var(--ui-font-mono);
	font-size: var(--ui-fs-1);
}

.ld-press {
	display: flex;
	justify-content: flex-end;
	animation: ui-pulse 1.6s ease-in-out infinite;
}

.ld-root {
	tab-index: auto;
}
