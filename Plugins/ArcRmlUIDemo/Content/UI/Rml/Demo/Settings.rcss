.st-frame {
	position: relative;
	height: 100%;
	box-sizing: border-box;
	display: grid;
	grid-template-rows: auto auto minmax(0, 1fr) auto;
	gap: var(--ui-space-4);
	padding: clamp(24px, 3.5vw, 72px);
}

.st-head {
	display: flex;
	align-items: flex-end;
	justify-content: space-between;
	gap: var(--ui-space-4);
	flex-wrap: wrap;
}

.st-titles {
	display: flex;
	flex-direction: column;
	gap: var(--ui-space-2);
}

.st-title {
	font-family: var(--ui-font-display);
	font-size: var(--ui-fs-6);
	font-weight: 700;
	line-height: 1;
	text-transform: var(--ui-display-case);
	letter-spacing: var(--ui-display-tracking);
	text-shadow: var(--ui-text-glow);
}

.st-search {
	width: min(360px, 100%);
}

.st-body {
	display: grid;
	grid-template-columns: minmax(0, 1fr) minmax(300px, 30%);
	gap: var(--ui-space-5);
	min-height: 0;
}

.st-col {
	display: flex;
	min-height: 0;
	min-width: 0;
}

.st-group {
	display: flex;
	flex-direction: column;
	gap: var(--ui-space-1);
}

.st-divider {
	padding: var(--ui-space-2) var(--ui-space-3);
}

.st-preview {
	aspect-ratio: 16 / 9;
	border-radius: var(--ui-radius-md);
	border: 1px solid var(--ui-border);
	background: var(--ui-thumb-bg);
	display: flex;
	align-items: flex-end;
	padding: var(--ui-space-3);
	box-sizing: border-box;
}

.st-preview-label {
	font-family: var(--ui-font-mono);
	font-size: var(--ui-fs-1);
	letter-spacing: 0.08em;
	text-transform: uppercase;
	color: var(--ui-text-muted);
}

.st-long {
	margin: 0;
	font-size: var(--ui-fs-3);
	line-height: 1.55;
	color: var(--ui-text-muted);
}

.st-stats {
	display: flex;
	flex-direction: column;
}

.st-footer {
	display: flex;
	justify-content: space-between;
	align-items: center;
	gap: var(--ui-space-4);
	flex-wrap: wrap;
	border-top: 1px solid var(--ui-border);
	padding-top: var(--ui-space-4);
}

.st-changes {
	font-family: var(--ui-font-mono);
	font-size: var(--ui-fs-2);
	color: var(--ui-accent);
	display: flex;
	align-items: center;
	gap: var(--ui-space-2);
}

.st-dot {
	width: 8px;
	height: 8px;
	border-radius: 50%;
	background: var(--ui-accent);
}
