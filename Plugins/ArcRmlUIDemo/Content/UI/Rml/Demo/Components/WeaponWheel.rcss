.dk-weapon-wheel-centre {
	position: absolute;
	left: 50%;
	top: 50%;
	transform: translate(-50%, -50%);
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: var(--hud-space-xs);
	text-align: center;
}

.dk-weapon-wheel-name-s {
	font-family: var(--ui-font-display);
	font-size: var(--ui-fs-4);
	font-weight: 700;
	text-transform: var(--ui-display-case);
	color: var(--hud-text);
	text-shadow: var(--hud-text-shadow);
	white-space: nowrap;
}

.dk-weapon-wheel-sub-s {
	font-size: var(--ui-fs-1);
	color: var(--hud-text);
	text-shadow: var(--hud-text-shadow);
	opacity: 0.75;
}
