@keyframes hud-wheel-in { from { opacity: 0; transform: scale(0.9); } to { opacity: 1; transform: scale(1); } }

.dk-weapon-wheel {
	position: relative;
	animation: hud-wheel-in var(--ui-dur-fast) var(--ui-ease);
}

.dk-weapon-wheel-ring {
	position: absolute;
	left: 50px;
	top: 50px;
	right: 50px;
	bottom: 50px;
	border-radius: 50%;
	background: radial-gradient(circle, var(--hud-plate) 55%, color-mix(in srgb, var(--hud-plate) 45%, transparent) 56%, color-mix(in srgb, var(--hud-plate) 45%, transparent) 70%, transparent 71%);
}

.dk-weapon-wheel-w-pos {
	position: absolute;
	left: 50%;
	top: 50%;
	width: 0;
	height: 0;
	--dk-weapon-wheel-w-pos-transform-1: -150px;
	transform: rotate(0deg) translateY(var(--dk-weapon-wheel-w-pos-transform-1)) rotate(-0deg);
}

.dk-weapon-wheel-w-s {
	position: absolute;
	box-sizing: border-box;
	display: flex;
	align-items: center;
	justify-content: center;
	border-radius: 50%;
	box-shadow: var(--hud-plate-shadow);
	transition: transform var(--ui-dur-fast) var(--ui-ease);
}

.dk-weapon-wheel-e5 {
	display: inline-flex;
}

.dk-weapon-wheel-w-pos-2 {
	position: absolute;
	left: 50%;
	top: 50%;
	width: 0;
	height: 0;
	--dk-weapon-wheel-w-pos-transform-1: -150px;
	transform: rotate(45deg) translateY(var(--dk-weapon-wheel-w-pos-transform-1)) rotate(-45deg);
}

