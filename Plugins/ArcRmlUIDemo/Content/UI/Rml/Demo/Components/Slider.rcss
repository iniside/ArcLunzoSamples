.dk-slider {
	display: flex;
	align-items: center;
	gap: var(--ui-space-4);
	width: 100%;
	min-width: 180px;
}

.dk-slider-input {
	-webkit-appearance: none;
	appearance: none;
	flex: 1;
	min-width: 0;
	height: 28px;
	margin: 0;
	background: transparent;
	cursor: pointer;
}

.dk-slider-input::-webkit-slider-runnable-track {
	height: 6px;
	border-radius: 3px;
	border: 1px solid var(--ui-border);
	box-sizing: border-box;
	background-color: var(--ui-surface-2);
	background-image: linear-gradient(90deg, color-mix(in srgb, var(--ui-accent) 55%, transparent) 0%, var(--ui-accent) var(--fill), transparent var(--fill));
	background-repeat: no-repeat;
}

.dk-slider.disabled .dk-slider-input::-webkit-slider-runnable-track {
	background-image: linear-gradient(90deg, var(--ui-text-disabled) 0%, var(--ui-text-disabled) var(--fill), transparent var(--fill));
}

.dk-slider-input::-webkit-slider-thumb {
	-webkit-appearance: none;
	appearance: none;
	width: 22px;
	height: 22px;
	margin: -9px -11px 0;
	box-sizing: border-box;
	border-radius: 50%;
	background: var(--ui-text);
	border: 3px solid var(--ui-accent);
	box-shadow: var(--ui-shadow-sm);
	cursor: pointer;
	transition: transform var(--ui-dur-fast) var(--ui-ease);
}

.dk-slider-input::-webkit-slider-thumb:hover {
	transform: scale(1.15);
}

.dk-slider-input::-webkit-slider-thumb:active {
	transform: scale(0.95);
}

.dk-slider.disabled .dk-slider-input {
	cursor: default;
}

.dk-slider.disabled .dk-slider-input::-webkit-slider-thumb {
	background: var(--ui-surface-2);
	border: 3px solid var(--ui-text-disabled);
	cursor: default;
}

.dk-slider.disabled .dk-slider-input::-webkit-slider-thumb:hover,
.dk-slider.disabled .dk-slider-input::-webkit-slider-thumb:active {
	transform: none;
}

.dk-slider-value {
	flex: none;
	min-width: 52px;
	text-align: right;
	font-family: var(--ui-font-mono);
	font-size: var(--ui-fs-2);
	color: var(--ui-text);
}

.dk-slider.disabled .dk-slider-value {
	color: var(--ui-text-disabled);
}
