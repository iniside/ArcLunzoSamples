.dk-action-bar {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: var(--hud-space-sm);
}

.dk-action-bar-row {
	display: flex;
	align-items: flex-end;
	gap: var(--hud-space-sm);
	padding: var(--ui-space-1);
	border-radius: var(--hud-radius);
	background: var(--hud-plate);
	border: 1px solid var(--hud-stroke);
	box-shadow: var(--hud-plate-shadow);
}

.dk-action-bar-set {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: var(--ui-space-1);
}

.dk-action-bar-cap {
	font-family: var(--ui-font-mono);
	font-size: var(--hud-fs-sm);
	font-weight: 700;
	color: var(--hud-text);
	text-shadow: var(--hud-text-shadow);
}

.dk-action-bar-cap.on {
	color: var(--ui-accent);
}

.dk-action-bar-set-row {
	display: flex;
	gap: var(--hud-space-sm);
}
