.dk-playercard {
	display: flex;
	align-items: center;
	gap: var(--ui-space-3);
	min-height: 72px;
	box-sizing: border-box;
	width: 100%;
	padding: var(--ui-space-3);
	background: var(--ui-surface);
	border: 1px solid var(--ui-border);
	border-radius: var(--ui-radius-md);
	box-shadow: none;
	cursor: pointer;
	transition: background-color var(--ui-dur-fast) var(--ui-ease), border-color var(--ui-dur-fast) var(--ui-ease), transform var(--ui-dur-fast) var(--ui-ease);
	--h-bd: var(--ui-accent);
	--h-bg: var(--ui-surface);
	--p-tf: scale(0.99);
}

.dk-playercard.ready {
	border: 1px solid color-mix(in srgb, var(--ui-success) 45%, var(--ui-border));
}

.dk-playercard.selected {
	background: var(--ui-accent-soft);
	border: 1px solid var(--ui-accent);
	--h-bg: var(--ui-accent-soft);
}

.dk-playercard.empty {
	background: transparent;
	border: 1px dashed var(--ui-border);
	--h-bg: var(--ui-accent-soft);
}

.dk-playercard:hover {
	border-color: var(--h-bd);
	background: var(--h-bg);
}

.dk-playercard:active {
	transform: var(--p-tf);
}

.dk-playercard:focus-visible {
	border-color: var(--ui-focus);
	box-shadow: var(--ui-focus-ring);
	--h-bd: var(--ui-focus);
}

.dk-playercard.focusable {
	tab-index: auto;
	nav: auto;
}

.dk-playercard-addbox {
	display: flex;
	align-items: center;
	justify-content: center;
	flex: none;
	width: 48px;
	height: 48px;
	border-radius: var(--ui-radius-md);
	border: 1px dashed var(--ui-border-strong);
	color: var(--ui-text-muted);
}

.dk-playercard-addicon {
	display: inline-flex;
}

.dk-playercard-addicon svg {
	display: block;
}

.dk-playercard-emptylabel {
	flex: 1;
	min-width: 0;
	color: var(--ui-text-muted);
	font-size: var(--ui-fs-3);
}

.dk-playercard-avatar {
	display: flex;
	align-items: center;
	justify-content: center;
	flex: none;
	width: 48px;
	height: 48px;
	border-radius: var(--ui-radius-md);
	background: var(--ui-thumb-bg);
	border: 2px solid var(--ui-border-strong);
	box-sizing: border-box;
	font-family: var(--ui-font-display);
	font-weight: 700;
	font-size: var(--ui-fs-4);
	color: var(--ui-text);
}

.dk-playercard.ready .dk-playercard-avatar {
	border: 2px solid var(--ui-success);
}

.dk-playercard-main {
	display: flex;
	flex-direction: column;
	gap: 2px;
	min-width: 0;
	flex: 1;
}

.dk-playercard-head {
	display: flex;
	align-items: center;
	gap: var(--ui-space-2);
	min-width: 0;
}

.dk-playercard-name {
	font-size: var(--ui-fs-3);
	font-weight: 600;
	color: var(--ui-text);
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.dk-playercard-host {
	display: inline-flex;
	flex: none;
	color: var(--ui-warning);
}

.dk-playercard-host svg {
	display: block;
}

.dk-playercard-sub {
	font-family: var(--ui-font-mono);
	font-size: var(--ui-fs-1);
	color: var(--ui-text-muted);
	white-space: nowrap;
}
