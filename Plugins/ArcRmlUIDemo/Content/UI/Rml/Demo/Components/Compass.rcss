.dk-compass-centre-s {
	position: absolute;
	left: calc(50% - 1px);
	top: 0;
	width: 2px;
	height: 22px;
	background: var(--ui-warning);
}

.dk-compass-m-s {
	position: absolute;
	top: 22px;
	transform: translateX(-50%);
	display: flex;
	flex-direction: column;
	align-items: center;
}

.dk-compass-e53 {
	display: inline-flex;
}

.dk-compass-dist-s {
