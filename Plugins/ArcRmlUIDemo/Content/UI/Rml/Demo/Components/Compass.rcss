.dk-compass {
	position: relative;
	width: 100%;
	max-width: 480px;
	min-width: 0;
	height: 58px;
	overflow: hidden;
	mask-image: linear-gradient(90deg, transparent, var(--hud-shade) 12%, var(--hud-shade) 88%, transparent);
}

.dk-compass-strip {
	position: absolute;
	left: 0;
	top: 0;
	width: 400%;
	height: 24px;
	--dk-compass-strip-transform-1: 12.500%;
	transform: translateX(var(--dk-compass-strip-transform-1));
}

.dk-compass-t-s {
	position: absolute;
	left: 0%;
	top: 4px;
	transform: translateX(-50%);
	font-family: var(--ui-font-mono);
	font-size: var(--ui-fs-2);
	font-weight: 700;
	color: var(--ui-danger);
	text-shadow: var(--hud-text-shadow);
}

.dk-compass-t-s-2 {
	position: absolute;
	left: 2.0833333333333335%;
	top: 14px;
	transform: translateX(-50%);
	font-family: var(--ui-font-mono);
	font-size: var(--hud-fs-xs);
	font-weight: 700;
	color: var(--hud-text);
	text-shadow: var(--hud-text-shadow);
	width: 1px;
	height: 8px;
	background: var(--hud-text);
	box-shadow: var(--hud-plate-shadow);
}

