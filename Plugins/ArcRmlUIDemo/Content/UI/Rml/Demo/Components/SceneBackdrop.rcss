.dk-scenebackdrop {
	position: absolute;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	background: var(--ui-scene-bg);
	overflow: hidden;
}

.dk-scenebackdrop::before {
	content: '';
	position: absolute;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	background: repeating-linear-gradient(135deg, color-mix(in srgb, var(--ui-tint) 3%, transparent) 0px, color-mix(in srgb, var(--ui-tint) 3%, transparent) 2px, transparent 2px, transparent 14px);
}

.dk-scenebackdrop-dim {
	position: absolute;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	background: radial-gradient(ellipse at 50% 50%, transparent 55%, rgba(0,0,0,0.45) 100%);
	backdrop-filter: none;
}

.dk-scenebackdrop-dim.soft {
	background: linear-gradient(90deg, var(--ui-scrim) 0%, transparent 70%);
}

.dk-scenebackdrop-dim.strong {
	background: linear-gradient(var(--ui-scrim), var(--ui-scrim));
	backdrop-filter: blur(4px);
}

.dk-scenebackdrop-label {
	position: absolute;
	right: var(--ui-space-5);
	top: var(--ui-space-5);
	font-family: var(--ui-font-mono);
	font-size: var(--ui-fs-1);
	letter-spacing: 0.1em;
	text-transform: uppercase;
	color: var(--ui-text-muted);
	opacity: 0.7;
}
