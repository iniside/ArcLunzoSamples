<component>
	<prop name="yaw" default="0"/>
	<prop name="markers" default="[]"/>
	<div class="dk-compass">
		<div class="dk-compass-strip" data-style---dk-compass-strip-transform-1="(((12.5 - ((((($yaw != 0 ? $yaw : 0) % 360) + 360) % 360) / 7.2)) | format(3)) + '%')">
			<span class="dk-compass-t-s">N</span>
			<span class="dk-compass-t-s-2"/>
			<span class="dk-compass-t-s-3"/>
			<span class="dk-compass-t-s-4">NE</span>
			<span class="dk-compass-t-s-5"/>
			<span class="dk-compass-t-s-6"/>
			<span class="dk-compass-t-s-7">E</span>
			<span class="dk-compass-t-s-8"/>
			<span class="dk-compass-t-s-9"/>
			<span class="dk-compass-t-s-10">SE</span>
			<span class="dk-compass-t-s-11"/>
			<span class="dk-compass-t-s-12"/>
			<span class="dk-compass-t-s-13">S</span>
			<span class="dk-compass-t-s-14"/>
			<span class="dk-compass-t-s-15"/>
			<span class="dk-compass-t-s-16">SW</span>
			<span class="dk-compass-t-s-17"/>
			<span class="dk-compass-t-s-18"/>
			<span class="dk-compass-t-s-19">W</span>
			<span class="dk-compass-t-s-20"/>
			<span class="dk-compass-t-s-21"/>
			<span class="dk-compass-t-s-22">NW</span>
			<span class="dk-compass-t-s-23"/>
			<span class="dk-compass-t-s-24"/>
			<span class="dk-compass-t-s-25">N</span>
			<span class="dk-compass-t-s-26"/>
			<span class="dk-compass-t-s-27"/>
			<span class="dk-compass-t-s-28">NE</span>
			<span class="dk-compass-t-s-29"/>
			<span class="dk-compass-t-s-30"/>
			<span class="dk-compass-t-s-31">E</span>
			<span class="dk-compass-t-s-32"/>
			<span class="dk-compass-t-s-33"/>
			<span class="dk-compass-t-s-34">SE</span>
			<span class="dk-compass-t-s-35"/>
			<span class="dk-compass-t-s-36"/>
			<span class="dk-compass-t-s-37">S</span>
			<span class="dk-compass-t-s-38"/>
			<span class="dk-compass-t-s-39"/>
			<span class="dk-compass-t-s-40">SW</span>
			<span class="dk-compass-t-s-41"/>
			<span class="dk-compass-t-s-42"/>
			<span class="dk-compass-t-s-43">W</span>
			<span class="dk-compass-t-s-44"/>
			<span class="dk-compass-t-s-45"/>
			<span class="dk-compass-t-s-46">NW</span>
			<span class="dk-compass-t-s-47"/>
			<span class="dk-compass-t-s-48"/>
		</div>
		<span class="dk-compass-centre-s"/>
		<div data-for="CompassM, CompassM_index : $markers" class="dk-compass-m-s" data-style-left="((50 + (((((((CompassM.Bearing - (((($yaw != 0 ? $yaw : 0) % 360) + 360) % 360)) + 540) % 360) - 180) | arcclamp(-84, 84)) / 180) * 100)) + '%')" data-style-color="((CompassM.Kind == 'poi') ? 'var(--ui-accent)' : 'var(--ui-rarity-legendary)')" data-style-opacity="(((((((CompassM.Bearing - (((($yaw != 0 ? $yaw : 0) % 360) + 360) % 360)) + 540) % 360) - 180) | abs) &gt; 84) ? 0.55 : 1)">
			<i class="dk-compass-e53"><svg data-attr-src="CompassM.Icon" width="14" height="14" stroke-width="2.5"/></i>
			<span class="dk-compass-dist-s">{{ ((CompassM.Distance | round) + ' m') }}</span>
		</div>
	</div>
</component>
