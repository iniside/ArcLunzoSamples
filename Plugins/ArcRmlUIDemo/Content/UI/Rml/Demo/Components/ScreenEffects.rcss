@keyframes hud-vig { 0% { opacity: 0.6; } 50% { opacity: 1; } 100% { opacity: 0.6; } }

@keyframes hud-hit { from { opacity: 1; } to { opacity: 0; } }

@keyframes hud-death-in { from { opacity: 0; } to { opacity: 1; } }

.dk-screen-effects {
	position: absolute;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	pointer-events: none;
	overflow: hidden;
}

.dk-screen-effects-vig-s {
	position: absolute;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	background: radial-gradient(ellipse at center, transparent 55%, color-mix(in srgb, var(--hud-health) 55%, transparent) 100%);
	animation: hud-vig var(--hud-dur-long) var(--ui-ease) infinite;
}

.dk-screen-effects-h-s {
	position: absolute;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	--dk-screen-effects-h-s-transform-1: 0deg;
	transform: rotate(var(--dk-screen-effects-h-s-transform-1));
	animation: hud-hit var(--hud-dur-long) var(--ui-ease) forwards;
}

.dk-screen-effects-arc-s {
	position: absolute;
	left: calc(50% - 160px);
	top: 6%;
	width: 320px;
	height: 90px;
	border-radius: 50%;
	border-top: 6px solid var(--hud-dmg-taken);
	opacity: 0.9;
}

.dk-screen-effects-death-s {
	position: absolute;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: var(--ui-space-2);
	background: radial-gradient(ellipse at center, color-mix(in srgb, var(--hud-plate) 70%, var(--hud-health)), var(--hud-plate));
	animation: hud-death-in var(--hud-dur-pulse) var(--ui-ease);
	pointer-events: auto;
}

.dk-screen-effects-died-s {
	font-family: var(--ui-font-display);
	font-size: var(--ui-fs-7);
	font-weight: 700;
	text-transform: var(--ui-display-case);
	letter-spacing: var(--ui-display-tracking);
	color: var(--ui-danger);
	text-shadow: var(--hud-text-shadow);
}

.dk-screen-effects-resp-s {
	font-family: var(--ui-font-mono);
	font-size: var(--ui-fs-3);
	color: var(--hud-text);
	text-shadow: var(--hud-text-shadow);
}
