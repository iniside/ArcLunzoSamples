<component>
	<prop name="label" default=""/>
	<prop name="value" default=""/>
	<prop name="placeholder" default=""/>
	<prop name="icon" default=""/>
	<prop name="error" default=""/>
	<prop name="hint" default=""/>
	<prop name="clearable"/>
	<prop name="disabled"/>
	<prop name="field" default=""/>
	<div class="dk-textfield">
		<span class="dk-textfield-label" data-if="$label != ''">{{ $label }}</span>
		<div class="dk-textfield-box" data-class-error="$error != ''" data-class-disabled="$disabled">
			<i class="dk-textfield-icon" data-if="$icon != ''"><svg data-attr-src="$icon" width="18" height="18" stroke-width="2"/></i>
			<input class="dk-textfield-input" type="text" data-attr-value="$value" data-attr-placeholder="$placeholder" data-attrif-disabled="$disabled" data-event-input="call('', 'TextInput', $field, ev.value)"/>
			<i class="dk-textfield-clear" data-if="$clearable &amp;&amp; $value != '' &amp;&amp; !$disabled"><svg src="/ArcRmlUIDemo/UI/Rml/icons/x.svg" width="16" height="16" stroke-width="2"/></i>
			<i class="dk-textfield-erroricon" data-if="$error != ''"><svg src="/ArcRmlUIDemo/UI/Rml/icons/circle-alert.svg" width="18" height="18" stroke-width="2"/></i>
		</div>
		<span class="dk-textfield-error" data-if="$error != ''">{{ $error }}</span>
		<span class="dk-textfield-hint" data-if="$hint != '' &amp;&amp; $error == ''">{{ $hint }}</span>
	</div>
</component>
