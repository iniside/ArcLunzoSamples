.dk-quick-slots {
	display: flex;
	gap: var(--hud-space-sm);
}

.dk-quick-slots-e2 {
	position: relative;
}

.dk-quick-slots-key-s {
	position: absolute;
	top: 1px;
	left: 3px;
	font-family: var(--ui-font-mono);
	font-size: var(--hud-fs-xs);
	font-weight: 700;
	color: var(--hud-text);
	text-shadow: var(--hud-text-shadow);
}
