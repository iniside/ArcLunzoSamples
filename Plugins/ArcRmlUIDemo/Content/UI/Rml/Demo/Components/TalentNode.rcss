@keyframes ui-talent-pulse { 0% { opacity: 0.25; transform: scale(1); } 50% { opacity: 0.8; transform: scale(1.12); } 100% { opacity: 0.25; transform: scale(1); } }

.dk-talentnode {
	position: relative;
	display: flex;
	align-items: center;
	justify-content: center;
	flex: none;
	box-sizing: border-box;
	width: 56px;
	height: 56px;
	border-radius: var(--ui-radius-md);
	background: var(--bg);
	border: 1px solid var(--bd);
	box-shadow: var(--sh-focus), var(--sh-sel), var(--sh-glow), var(--sh-ks);
	cursor: default;
	z-index: 1;
	transition: border-color var(--ui-dur-fast) var(--ui-ease), background-color var(--ui-dur-fast) var(--ui-ease), transform var(--ui-dur-fast) var(--ui-ease);
	--bg: linear-gradient(var(--ui-surface), var(--ui-surface));
	--bd: var(--ui-border);
	--ic: var(--ui-text-disabled);
	--rk: var(--ui-text-disabled);
	--h-bd: var(--ui-border);
	--p-tf: none;
	--sh-focus: 0 0 0 0 transparent;
	--sh-sel: 0 0 0 0 transparent;
	--sh-glow: 0 0 0 0 transparent;
	--sh-ks: 0 0 0 0 transparent;
}

.dk-talentnode.placed {
	position: absolute;
}

.dk-talentnode.available {
	--bg: radial-gradient(circle at 50% 35%, var(--ui-surface-2), var(--ui-surface) 80%);
	--bd: var(--ui-accent);
	--ic: var(--ui-text);
	--rk: var(--ui-text);
	--h-bd: var(--ui-focus);
	--p-tf: scale(0.94);
}

.dk-talentnode.allocated {
	--bg: radial-gradient(circle at 50% 35%, color-mix(in srgb, var(--ui-accent) 35%, var(--ui-surface-2)), var(--ui-surface) 85%);
	--bd: var(--ui-accent);
	--ic: var(--ui-accent);
	--rk: var(--ui-accent);
	--h-bd: var(--ui-focus);
	--p-tf: scale(0.94);
	--sh-glow: var(--ui-glow);
}

.dk-talentnode.maxed {
	--bg: radial-gradient(circle at 50% 35%, color-mix(in srgb, var(--ui-accent) 85%, var(--ui-tint)), var(--ui-accent) 75%);
	--bd: var(--ui-accent);
	--ic: var(--ui-accent-text);
	--rk: var(--ui-accent);
	--h-bd: var(--ui-focus);
	--p-tf: scale(0.94);
	--sh-glow: var(--ui-glow);
}

.dk-talentnode.available, .dk-talentnode.allocated, .dk-talentnode.maxed {
	border-width: 2px;
	cursor: pointer;
}

.dk-talentnode.keystone {
	width: 76px;
	height: 76px;
	border-radius: 50%;
	--sh-ks: inset 0 0 0 3px var(--ui-bg), inset 0 0 0 4px var(--bd);
}

.dk-talentnode.selected {
	z-index: 2;
	--sh-sel: 0 0 0 2px var(--ui-bg), 0 0 0 4px var(--ui-accent);
}

.dk-talentnode:hover {
	border-color: var(--h-bd);
	background: var(--bg);
}

.dk-talentnode:active {
	transform: var(--p-tf);
}

.dk-talentnode:focus-visible {
	z-index: 2;
	border-color: var(--ui-focus);
	--h-bd: var(--ui-focus);
	--sh-focus: var(--ui-focus-ring);
	--sh-sel: 0 0 0 0 transparent;
}

.dk-talentnode.focusable {
	tab-index: auto;
	nav: auto;
}

.dk-talentnode-halo {
	position: absolute;
	top: -5px;
	right: -5px;
	bottom: -5px;
	left: -5px;
	border-radius: var(--ui-radius-lg);
	border: 1px solid var(--ui-accent);
	animation: ui-talent-pulse 1.8s ease-in-out infinite;
	pointer-events: none;
}

.dk-talentnode.keystone .dk-talentnode-halo {
	border-radius: 50%;
}

.dk-talentnode-icon {
	display: inline-flex;
	color: var(--ic);
	opacity: 0.7;
}

.dk-talentnode.available .dk-talentnode-icon, .dk-talentnode.allocated .dk-talentnode-icon, .dk-talentnode.maxed .dk-talentnode-icon {
	opacity: 1;
}

.dk-talentnode-icon svg {
	display: block;
}

.dk-talentnode-rank {
	position: absolute;
	bottom: -10px;
	left: 50%;
	transform: translateX(-50%);
	padding: 1px 6px;
	border-radius: 9px;
	background: var(--ui-bg);
	border: 1px solid var(--ui-border);
	font-family: var(--ui-font-mono);
	font-size: 11px;
	font-weight: 600;
	line-height: 1.3;
	color: var(--rk);
	white-space: nowrap;
}

.dk-talentnode.available .dk-talentnode-rank, .dk-talentnode.allocated .dk-talentnode-rank, .dk-talentnode.maxed .dk-talentnode-rank {
	border: 1px solid var(--bd);
}
