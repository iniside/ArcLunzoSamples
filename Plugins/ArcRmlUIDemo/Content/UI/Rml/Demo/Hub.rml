<rml>
<head>
	<title>ArcRmlUI Demo Game Menu</title>
	<meta name="layer" content="UI.Layer.Menu"/>
	<meta name="input-mode" content="menu"/>
	<meta name="hide-lower" content="true"/>
	<meta name="keep-alive" content="true"/>
	<meta name="input-mapping" content="/ArcRmlUIDemo/Demo/Input/IMC_ArcDemo_Hub"/>
	<link type="text/rcss" href="/ArcRmlUIDemo/UI/Rml/Demo/tokens.rcss"/>
	<link type="text/rcss" href="/ArcRmlUIDemo/UI/Rml/Fonts/Fonts.rcss"/>
	<link type="text/rcss" href="GameUI.rcss"/>
	<link type="text/rcss" href="Hub.rcss"/>
	<viewmodel name="hubui" class="/ArcRmlUIDemo/Demo/ViewModels/BP_ArcRmlDemoUIVM.BP_ArcRmlDemoUIVM_C" context="VM_ArcRmlDemoUI"/>
	<viewmodel name="hub" class="/ArcRmlUIDemo/Demo/ViewModels/BP_ArcRmlDemoHubVM.BP_ArcRmlDemoHubVM_C" resolver="/Script/ArcRmlUIDemo.ArcRmlDemoViewModelResolver"/>
</head>
<body data-model="hubui" data-class-theme-ember="Theme == 'ember'" data-class-theme-daylight="Theme == 'daylight'" data-class-theme-slate="Theme == 'slate'" data-class-theme-relic="Theme == 'relic'" data-event-back="call('', 'Back'); stopPropagation()" data-event-uiaction="callIf(ev.action == 'IA_ArcDemo_DevBar', '', 'ToggleDevBar'); callIf(ev.action == 'IA_ArcDemo_GameMenu', '', 'ToggleGameMenu')">
	<div class="gu-layer">
		<div class="gu-screen" data-model="hub">
			<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/SceneBackdrop" label="Game scene" dim="strong"/>
			<div class="hb-frame">
				<div class="gu-cycle">
					<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/GameMenuHeader" tabs="{{ Tabs }}" active="{{ Tab }}" currency="{{ Currency }}" area="main" nofocus="{{ true }}" data-hotkey-cycle="IA_ArcDemo_PrevTab IA_ArcDemo_NextTab"/>
				</div>
				<div class="hb-embed" arc-embed=""></div>
			</div>
		</div>
	</div>
	<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/DevBar" data-if="DevOpen"/>
</body>
</rml>
