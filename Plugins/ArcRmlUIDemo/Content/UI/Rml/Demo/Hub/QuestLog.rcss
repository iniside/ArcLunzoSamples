.ql-body {
	display: grid;
	grid-template-columns: minmax(380px, 34%) minmax(0, 1fr);
	gap: var(--ui-space-5);
	min-height: 0;
}

.ql-tabs {
	padding: 0 var(--ui-space-4);
}

.ql-list {
	flex: 1;
	min-height: 0;
	overflow-y: auto;
	overflow-x: hidden;
	display: flex;
	flex-direction: column;
	gap: var(--ui-space-1);
	padding: var(--ui-space-3) var(--ui-space-4);
}

.ql-paras {
	display: flex;
	flex-direction: column;
	gap: var(--ui-space-3);
	max-width: 820px;
}

.ql-para {
	margin: 0;
	font-size: var(--ui-fs-3);
	line-height: 1.6;
	color: var(--ui-text-muted);
}

.ql-objectives {
	display: flex;
	flex-direction: column;
	max-width: 820px;
}

.ql-chips {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	gap: var(--ui-space-2);
}

.ql-choose {
	display: flex;
	flex-direction: column;
	gap: var(--ui-space-2);
}

.ql-choose-label {
	font-size: var(--ui-fs-2);
	color: var(--ui-text-muted);
}

.ql-items {
	display: flex;
	flex-wrap: wrap;
	gap: var(--ui-space-3);
}

.ql-item {
	display: flex;
	align-items: center;
	gap: var(--ui-space-3);
	padding: var(--ui-space-2);
	padding-right: var(--ui-space-4);
	border-radius: var(--ui-radius-md);
	background: var(--ui-surface);
	border: 1px solid var(--ui-border);
	min-width: 0;
}

.ql-item-text {
	display: flex;
	flex-direction: column;
	gap: 2px;
	min-width: 0;
}

.ql-item-name {
	font-size: var(--ui-fs-2);
	font-weight: 600;
	color: var(--ui-rarity-common);
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.ql-item-name.uncommon {
	color: var(--ui-rarity-uncommon);
}

.ql-item-name.rare {
	color: var(--ui-rarity-rare);
}

.ql-item-name.epic {
	color: var(--ui-rarity-epic);
}

.ql-item-name.legendary {
	color: var(--ui-rarity-legendary);
}

.ql-item-type {
	font-size: var(--ui-fs-1);
	color: var(--ui-text-muted);
}

.ql-footer {
	display: flex;
	gap: var(--ui-space-3);
	width: 100%;
	justify-content: space-between;
	flex-wrap: wrap;
}

.ql-footer-end {
	display: flex;
	gap: var(--ui-space-3);
	margin-left: auto;
}
