<rml>
<head>
	<title>ArcRmlUI Demo Game Menu · Inventory</title>
	<meta name="frame" content="/ArcRmlUIDemo/UI/Rml/Demo/Hub.rml"/>
	<meta name="input-mapping" content="/ArcRmlUIDemo/Demo/Input/IMC_ArcDemo_Inventory"/>
	<link type="text/rcss" href="/ArcRmlUIDemo/UI/Rml/Demo/tokens.rcss"/>
	<link type="text/rcss" href="/ArcRmlUIDemo/UI/Rml/Fonts/Fonts.rcss"/>
	<link type="text/rcss" href="/ArcRmlUIDemo/UI/Rml/Demo/GameUI.rcss"/>
	<link type="text/rcss" href="HubTab.rcss"/>
	<link type="text/rcss" href="Inventory.rcss"/>
	<viewmodel name="ui" class="/ArcRmlUIDemo/Demo/ViewModels/BP_ArcRmlDemoUIVM.BP_ArcRmlDemoUIVM_C" context="VM_ArcRmlDemoUI"/>
	<viewmodel name="inventory" class="/ArcRmlUIDemo/Demo/ViewModels/BP_ArcRmlDemoInventoryVM.BP_ArcRmlDemoInventoryVM_C" resolver="/Script/ArcRmlUIDemo.ArcRmlDemoViewModelResolver"/>
</head>
<body data-model="ui" data-class-theme-ember="Theme == 'ember'" data-class-theme-daylight="Theme == 'daylight'" data-class-theme-slate="Theme == 'slate'" data-class-theme-relic="Theme == 'relic'">
	<div class="ht-root" data-model="inventory" data-event-back="call('', 'Back'); stopPropagation()" data-event-uiaction="stopPropagation(bMoving &amp;&amp; (ev.action == 'IA_ArcDemo_PrevTab' || ev.action == 'IA_ArcDemo_NextTab' || ev.action == 'IA_ArcDemo_PrevSubTab' || ev.action == 'IA_ArcDemo_NextSubTab'))">
		<div class="ht-frame">
			<div class="iv-body">
				<div class="ht-col">
					<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/Panel" title="Backpack" subtitle="{{ BagSub }}" icon="/ArcRmlUIDemo/UI/Rml/icons/backpack.svg" padded="{{ false }}" fill="{{ true }}" has-footer="{{ true }}" style="width: 100%; height: 100%">
						<div class="iv-top">
							<div class="iv-chips" data-focus-area="chips" data-focus-parent="grid" data-event-back="callIf(bMoving, '', 'Back'); stopPropagation(bMoving)">
								<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/FilterChip" data-for="ivChip, ivChip_index : Chips" label="{{ ivChip.Label }}" icon="{{ ivChip.Icon }}" count="{{ ivChip.Count }}" active="{{ ivChip.bActive }}" focusable="{{ true }}" data-event-click="call('', 'FilterBy', ivChip_index)"/>
							</div>
							<div class="iv-tools">
								<div class="iv-search" data-focus-area="search" data-focus-parent="grid" data-event-back="callIf(bMoving, '', 'Back'); stopPropagation(bMoving)">
									<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/SearchField" value="{{ Query }}" placeholder="Search items" field="invSearch" style="width: 100%"/>
								</div>
								<div class="iv-sort" data-focus-area="sort" data-focus-parent="grid" data-event-back="callIf(bMoving, '', 'Back'); stopPropagation(bMoving)">
									<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/Dropdown" data-focus-owner="" value="{{ SortLabel }}" field="sort" data-event-click="call('', 'CycleSort')" style="width: 100%"/>
								</div>
							</div>
						</div>
						<div class="iv-scroll" data-if="bHasItems">
							<div class="iv-grid" data-class-moving="bMoving" data-focus-area="grid" data-focus-primary="">
								<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/ItemSlot" data-for="ivSlot, ivSlot_index : Slots" fluid="{{ true }}" icon="{{ ivSlot.Icon }}" empty-icon="{{ ivSlot.EmptyIcon }}" rarity="{{ ivSlot.Rarity }}" quantity="{{ ivSlot.Quantity }}" durability="{{ ivSlot.Durability }}" is-new="{{ ivSlot.bNew }}" locked="{{ ivSlot.bLocked }}" ghost="{{ ivSlot.bGhost }}" focusable="{{ true }}" autofocus="{{ ivSlot_index == Selected }}" data-event-click="callIf(!ivSlot.bLocked, '', 'Activate', ivSlot_index)" data-event-uiaction="callIf(!bMoving &amp;&amp; ivSlot.bConsumable &amp;&amp; ev.action == 'IA_ArcDemo_Use', '', 'Use', ivSlot_index); callIf(!bMoving &amp;&amp; ev.action == 'IA_ArcDemo_Move', '', 'Move', ivSlot_index); callIf(!bMoving &amp;&amp; ev.action == 'IA_ArcDemo_Drop', '', 'Drop', ivSlot_index); callIf(!bMoving &amp;&amp; ev.action == 'IA_ArcDemo_Junk', '', 'Junk', ivSlot_index); callIf(bMoving &amp;&amp; ev.action == 'IA_ArcDemo_Swap', '', 'Swap', ivSlot_index); stopPropagation(ev.action == 'IA_ArcDemo_Use' || ev.action == 'IA_ArcDemo_Move' || ev.action == 'IA_ArcDemo_Drop' || ev.action == 'IA_ArcDemo_Junk' || ev.action == 'IA_ArcDemo_Swap')"/>
							</div>
						</div>
						<div class="iv-emptybox" data-if="bEmpty" data-focus-area="grid" data-focus-primary="">
							<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/EmptyState" icon="/ArcRmlUIDemo/UI/Rml/icons/key-round.svg" title="No quest items" body="Items you pick up for quests appear here. They don’t count toward your weight." style="width: 100%">
								<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/Button" label="Show all" variant="secondary" icon-left="/ArcRmlUIDemo/UI/Rml/icons/layout-grid.svg" focusable="{{ true }}" data-event-click="call('', 'ShowAll')"/>
							</dc-import>
						</div>
						<div slot="footer" class="iv-footer">
							<div class="iv-weight">
								<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/ProgressBar" value="{{ WeightPct }}" label="Weight" value-label="{{ WeightLabel }}" tone="{{ WeightTone }}"/>
							</div>
							<span class="iv-bagsub">{{ BagSub }}</span>
						</div>
					</dc-import>
				</div>
				<div class="iv-side">
					<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/Toast" data-if="bMoving" tone="{{ MoveToast.Tone }}" title="{{ MoveToast.Title }}" body="{{ MoveToast.Body }}"/>
					<div class="gu-area" data-if="!bMoving"><div class="gu-area" data-model="ui"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/Toast" data-if="Toast.bVisible" tone="{{ Toast.Tone }}" title="{{ Toast.Title }}" body="{{ Toast.Body }}"/></div></div>
					<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/CompareTooltip" data-if="bShowTip" item="{{ Item }}" equipped="{{ Equipped }}" equipped-label="Equipped" sell-label="Sell value"/>
				</div>
			</div>
			<div class="ht-footer">
				<div class="gu-prompts gu-default" data-area="grid" data-if="bMoving"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/PromptBar"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.confirm }}" label="Place"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.IA_ArcDemo_Swap }}" label="Swap"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.back }}" label="Cancel"/></dc-import></div>
				<div class="gu-prompts" data-area="chips" data-if="bMoving"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/PromptBar"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.IA_ArcDemo_Swap }}" label="Swap" disabled="{{ true }}"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.back }}" label="Cancel"/></dc-import></div>
				<div class="gu-prompts" data-area="search" data-if="bMoving"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/PromptBar"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.IA_ArcDemo_Swap }}" label="Swap" disabled="{{ true }}"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.back }}" label="Cancel"/></dc-import></div>
				<div class="gu-prompts" data-area="sort" data-if="bMoving"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/PromptBar"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.IA_ArcDemo_Swap }}" label="Swap" disabled="{{ true }}"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.back }}" label="Cancel"/></dc-import></div>
				<div class="gu-prompts gu-default" data-area="grid" data-if="!bMoving &amp;&amp; !bEmpty"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/PromptBar"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.confirm }}" label="Equip"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.IA_ArcDemo_Use }}" label="Use"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.IA_ArcDemo_Move }}" label="Move" disabled="{{ !bShowsAll }}"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.IA_ArcDemo_Drop }}" label="Drop"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.IA_ArcDemo_Split }}" label="Split" disabled="{{ true }}"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.IA_ArcDemo_Junk }}" label="Mark as junk"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.back }}" label="Close"/></dc-import></div>
				<div class="gu-prompts gu-default" data-area="grid" data-if="!bMoving &amp;&amp; bEmpty"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/PromptBar"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.confirm }}" label="Show all"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.back }}" label="Close"/></dc-import></div>
				<div class="gu-prompts" data-area="chips" data-if="!bMoving"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/PromptBar"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.confirm }}" label="Filter"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.back }}" label="Close"/></dc-import></div>
				<div class="gu-prompts" data-area="search" data-if="!bMoving"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/PromptBar"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.confirm }}" label="Search"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.back }}" label="Close"/></dc-import></div>
				<div class="gu-prompts" data-area="sort" data-if="!bMoving"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/PromptBar"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.confirm }}" label="{{ NextSortLabel }}"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.back }}" label="Close"/></dc-import></div>
			</div>
		</div>
	</div>
</body>
</rml>
