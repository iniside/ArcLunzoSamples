html, body {
	background: transparent;
}

.ht-root {
	background: transparent;
	color: var(--ui-text);
	font-family: var(--ui-font-body);
	font-size: var(--ui-fs-3);
	position: relative;
	width: 100%;
	height: 100%;
	overflow: hidden;
}

.ht-frame {
	position: relative;
	height: 100%;
	box-sizing: border-box;
	display: grid;
	grid-template-rows: minmax(0, 1fr) auto;
	grid-template-columns: minmax(0, 1fr);
	gap: var(--ui-space-4);
}

.ht-footer {
	display: flex;
	justify-content: flex-end;
	align-items: center;
	gap: var(--ui-space-4);
	flex-wrap: wrap;
	border-top: 1px solid var(--ui-border);
	padding-top: var(--ui-space-4);
}

.ht-col {
	display: flex;
	min-height: 0;
	min-width: 0;
}
