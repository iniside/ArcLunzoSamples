<rml>
<head>
	<title>ArcRmlUI Demo Game Menu · Achievements</title>
	<meta name="frame" content="/ArcRmlUIDemo/UI/Rml/Demo/Hub.rml"/>
	<meta name="input-mapping" content="/ArcRmlUIDemo/Demo/Input/IMC_ArcDemo_Achievements"/>
	<link type="text/rcss" href="/ArcRmlUIDemo/UI/Rml/Demo/tokens.rcss"/>
	<link type="text/rcss" href="/ArcRmlUIDemo/UI/Rml/Fonts/Fonts.rcss"/>
	<link type="text/rcss" href="/ArcRmlUIDemo/UI/Rml/Demo/GameUI.rcss"/>
	<link type="text/rcss" href="HubTab.rcss"/>
	<link type="text/rcss" href="Achievements.rcss"/>
	<viewmodel name="ui" class="/ArcRmlUIDemo/Demo/ViewModels/BP_ArcRmlDemoUIVM.BP_ArcRmlDemoUIVM_C" context="VM_ArcRmlDemoUI"/>
	<viewmodel name="achievements" class="/ArcRmlUIDemo/Demo/ViewModels/BP_ArcRmlDemoAchievementsVM.BP_ArcRmlDemoAchievementsVM_C" resolver="/Script/ArcRmlUIDemo.ArcRmlDemoViewModelResolver"/>
</head>
<body data-model="ui" data-class-theme-ember="Theme == 'ember'" data-class-theme-daylight="Theme == 'daylight'" data-class-theme-slate="Theme == 'slate'" data-class-theme-relic="Theme == 'relic'">
	<div class="ht-root" data-model="achievements" data-event-back="call('', 'Back'); stopPropagation()">
		<div class="ht-frame">
			<div class="ac-body">
				<div class="ht-col">
					<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/Panel" title="Progress" icon="/ArcRmlUIDemo/UI/Rml/icons/trophy.svg" fill="{{ true }}" scroll="{{ true }}" style="width: 100%; height: 100%">
						<div class="ac-summary">
							<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/ProgressRing" value="{{ RingPct }}" label="{{ RingLabel }}" size="{{ 132 }}"/>
							<div class="ac-facts">
								<div class="ac-fact" data-for="acFact : Summary">
									<span class="ac-fact-label">{{ acFact.Label }}</span>
									<span class="ac-fact-value">{{ acFact.Value }}</span>
								</div>
							</div>
						</div>
						<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/Divider" label="Categories"/>
						<div class="ac-cats" data-focus-area="cats" data-focus-parent="cards">
							<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/ListRow" data-for="acCat, acCat_index : Categories" icon="{{ acCat.Icon }}" title="{{ acCat.Label }}" subtitle="{{ acCat.Sub }}" meta="{{ acCat.Meta }}" selected="{{ acCat_index == Category }}" focusable="{{ true }}" data-event-click="call('', 'SelectCategory', acCat_index)"/>
						</div>
					</dc-import>
				</div>
				<div class="ht-col">
					<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/Panel" title="Achievements" subtitle="{{ ShownSub }}" padded="{{ false }}" fill="{{ true }}" style="width: 100%; height: 100%">
						<div class="ac-tools">
							<div class="gu-cycle">
								<div class="ac-chips" data-focus-area="chips" data-focus-parent="cards" data-hotkey-cycle="IA_ArcDemo_PrevSubTab IA_ArcDemo_NextSubTab">
									<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/FilterChip" data-for="acChip, acChip_index : Chips" label="{{ acChip.Label }}" icon="{{ acChip.Icon }}" count="{{ acChip.Count }}" active="{{ acChip.bActive }}" focusable="{{ true }}" data-event-click="call('', 'FilterBy', acChip_index)"/>
								</div>
							</div>
							<div class="ac-sort" data-focus-area="sort" data-focus-parent="cards">
								<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/Dropdown" data-focus-owner="" value="{{ SortLabel }}" field="sort" data-event-click="call('', 'CycleSort')" style="width: 100%"/>
							</div>
						</div>
						<div class="ac-scroll">
							<div class="ac-grid" data-focus-area="cards" data-focus-primary="">
								<dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/AchievementCard" data-for="acCard, acCard_index : Achievements" icon="{{ acCard.Icon }}" title="{{ acCard.Title }}" description="{{ acCard.Description }}" state="{{ acCard.State }}" value="{{ acCard.Value }}" max="{{ acCard.Max }}" unlocked-label="{{ acCard.Date }}" locked-label="Locked" hidden-title="Hidden achievement" hidden-label="Keep playing to reveal" rarity-label="{{ acCard.RarityLabel }}" tier="{{ acCard.Tier }}" points="{{ acCard.Points }}" focusable="{{ true }}" data-event-click="call('', 'Details', acCard_index)" data-event-uiaction="callIf(ev.action == 'IA_ArcDemo_Pin', '', 'Pin', acCard_index); stopPropagation(ev.action == 'IA_ArcDemo_Pin')"/>
							</div>
						</div>
					</dc-import>
				</div>
			</div>
			<div class="ht-footer">
				<div class="gu-prompts gu-default" data-area="cards"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/PromptBar"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.confirm }}" label="Details"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.IA_ArcDemo_PrevSubTab + ' / ' + ArcKeys.IA_ArcDemo_NextSubTab }}" glyph="LT / RT" label="Filter"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.IA_ArcDemo_Sort }}" label="Sort" data-hotkey="IA_ArcDemo_Sort" data-event-click="call('', 'CycleSort')"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.IA_ArcDemo_Pin }}" label="Pin to HUD"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.back }}" label="Close"/></dc-import></div>
				<div class="gu-prompts" data-area="cats"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/PromptBar"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.confirm }}" label="Select"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.IA_ArcDemo_PrevSubTab + ' / ' + ArcKeys.IA_ArcDemo_NextSubTab }}" glyph="LT / RT" label="Filter"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.back }}" label="Back"/></dc-import></div>
				<div class="gu-prompts" data-area="chips"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/PromptBar"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.confirm }}" label="Filter"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.IA_ArcDemo_PrevSubTab + ' / ' + ArcKeys.IA_ArcDemo_NextSubTab }}" glyph="LT / RT" label="Filter"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.back }}" label="Back"/></dc-import></div>
				<div class="gu-prompts" data-area="sort"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/PromptBar"><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.confirm }}" label="{{ NextSortLabel }}"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.IA_ArcDemo_PrevSubTab + ' / ' + ArcKeys.IA_ArcDemo_NextSubTab }}" glyph="LT / RT" label="Filter"/><dc-import name="/ArcRmlUIDemo/UI/Rml/Demo/Components/InputPrompt" key-label="{{ ArcKeys.back }}" label="Back"/></dc-import></div>
			</div>
		</div>
	</div>
</body>
</rml>
