@spritesheet dep-sprites {
	src: Images/Sprites.png;
	dep-sprite-circle: 0px 0px 32px 32px;
	dep-sprite-square: 32px 0px 32px 32px;
}

@decorator dep-named : image {
	image-src: Images/Named.png;
}

.dep-panel {
	display: flex;
	flex-direction: column;
	align-items: center;
	width: 1280px;
	padding: 24px 32px;
	border: 2px solid #3d7bd9;
	border-radius: 12px;
	background-color: #141c2b;
}

.dep-title {
	font-size: 28px;
	font-weight: bold;
	margin-bottom: 16px;
}

.dep-grid {
	display: flex;
	flex-wrap: wrap;
	gap: 12px;
}

.dep-cell {
	display: flex;
	flex-direction: column;
	align-items: center;
	width: 390px;
	height: 140px;
	padding: 8px;
	border: 1px solid #2c3a52;
	border-radius: 6px;
}

.dep-box {
	width: 64px;
	height: 64px;
	margin-bottom: 8px;
}

.dep-image-function {
	decorator: image(../Shared/Images/ImageFunction.png);
}

.dep-named {
	decorator: dep-named;
}

.dep-sprites {
	display: flex;
	flex-direction: row;
	margin: 16px 0 24px 0;
}

.dep-sprite {
	width: 32px;
	height: 32px;
	margin: 0 4px;
}

.dep-progress {
	width: 240px;
	height: 28px;
	margin: 18px 0 26px 0;
	background-color: #2c3a52;
	fill-image: Images/Fill.png;
}

.dep-loc {
	font-size: 22px;
	text-align: center;
	color: #ffd479;
	margin: 20px 0 28px 0;
}

.dep-font {
	font-family: 'Barlow Condensed';
	font-weight: 500;
	font-size: 34px;
	color: #9fe6a0;
	margin: 12px 0 24px 0;
}

.dep-label {
	font-size: 15px;
	color: #a9b4c6;
	text-align: center;
}
