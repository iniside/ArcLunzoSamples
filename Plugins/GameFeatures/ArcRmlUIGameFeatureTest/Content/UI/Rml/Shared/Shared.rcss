@font-face {
	font-family: 'Barlow Condensed';
	font-weight: 500;
	src: ../Fonts/BarlowCondensed-Medium.ttf;
}

html {
	height: 100%;
}

body {
	height: 100%;
	margin: 0;
	display: flex;
	align-items: center;
	justify-content: center;
	background-color: rgba(8, 12, 20, 0.85);
	font-family: 'Barlow Condensed';
	color: #e8ecf4;
}

.dep-url {
	background: url(Images/Background.png);
}

.dep-sound {
	--sound-click: "asset:/ArcRmlUIGameFeatureTest/UI/Sound/MS_DependenciesClick.MS_DependenciesClick";
	--sound-hover: "asset:/ArcRmlUIGameFeatureTest/UI/Sound/MS_DependenciesHover.MS_DependenciesHover";
	display: flex;
	align-items: center;
	justify-content: center;
	border: 2px solid #e8ecf4;
	border-radius: 32px;
	font-size: 14px;
}
